# glossql's configuration. On a laptop, copy to `.env` beside where the
# server is started: a run with --workspace reads it from the working
# directory, the environment winning over the file. A deployment reads
# no file — its platform injects the variables, secrets included.
# `.env` is never committed.

# The authorization server: its issuer URL — any OpenID Connect
# provider. Its OpenID configuration is read at boot and names the keys
# tokens are verified against.
GLOSSQL_ISSUER=https://issuer.example

# This server's canonical URI — the API identifier registered at the
# issuer, and the `aud` every token must name (RFC 8707 §2). Defaults to
# http://<--addr> when unset.
GLOSSQL_AUDIENCE=http://127.0.0.1:8080

# The application registered at the issuer for this server. Its secret
# is used only by the browser login on /app. What binds a token is its
# `aud`: a token naming no audience is refused.
GLOSSQL_CLIENT_ID=
GLOSSQL_CLIENT_SECRET=

# Or no arrangement at all: `GLOSSQL_INSECURE_OPEN=true` (the literal
# `true`) serves every door without authentication. The name is the
# warning — anyone who reaches the address reads and writes, and every
# caller lands on the record as `insecure_dev_mode`, human standing at
# the human doors, agent at /mcp. A laptop trying the server out; never
# a deployment.
# GLOSSQL_INSECURE_OPEN=true

# The workspace's catalog on a Postgres server instead of the workspace
# directory's own SQLite file — the same catalog, in a database that
# outlives the container. The URI carries the credentials; it is never
# logged. The warehouse stays under --workspace unless GLOSSQL_WAREHOUSE
# moves it.
# GLOSSQL_CATALOG_SQL=postgres://glossql:glossql@127.0.0.1:5432/glossql

# The warehouse in an object store instead of under --workspace: the
# lake's location — S3, Azure or Google Cloud Storage. Credentials come
# from the store's own conventions (AWS_* below;
# AZURE_STORAGE_ACCOUNT_NAME and _KEY, or a managed identity, which the
# client reads on Container Apps with nothing set;
# GOOGLE_SERVICE_ACCOUNT_PATH, or the attached service account, which
# the client reads on Cloud Run with nothing set). With both this and
# GLOSSQL_CATALOG_SQL named the server needs no workspace directory:
# that is a deployment.
# GLOSSQL_WAREHOUSE=abfss://lake@account.dfs.core.windows.net/warehouse

# The kernel service behind three doors — the metric-bands walk,
# whatif.<scenario>() and misfit.<frame>(): the band model runs there,
# never in this server. Its address, and the bearer it expects (a key
# the hosted kernel API issued, or whatever a glosskernels service of
# your own was started with). Unset, those three doors refuse by name
# and everything else serves.
# GLOSSQL_TABICL_URL=http://127.0.0.1:8100
# GLOSSQL_TABICL_TOKEN=
# On GCP, instead of a token: the service's URL as the audience of an ID token
# the platform mints for this server's service account.
# GLOSSQL_TABICL_AUDIENCE=

# The sizes and the address — each the variable of a flag of the same
# name, the flag winning. Megabytes; the defaults are shown. The engine's
# memory ceiling and the cube cache are two budgets, so a box is sized
# for the sum; the spill bound is the disk's own number and follows the
# ceiling (twice it) until named.
# GLOSSQL_ADDR=127.0.0.1:8080
# GLOSSQL_ROW_CAP=200
# GLOSSQL_CUBE_CACHE=2048
# GLOSSQL_MEMORY_LIMIT=4096
# GLOSSQL_SPILL_LIMIT=8192

# Storage has no variables of its own: the warehouse is reached through
# the store's standard conventions, read by the storage layer itself: AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_ENDPOINT,
# AWS_DEFAULT_REGION, AWS_ALLOW_HTTP for S3; AZURE_STORAGE_ACCOUNT_NAME,
# AZURE_STORAGE_ACCOUNT_KEY (or the managed identity) for Azure;
# AZURE_STORAGE_USE_EMULATOR=true for Azurite.

# What the server puts on its record: a `tracing` filter. `info` when
# unset — calls, statements, reads, measurements, commits, refusals,
# with their timings; `debug` adds the text of every call and the
# engine's annotated plans. A bare level is this server's crates; the
# substrate stays at info and the MCP library at warn unless named
# (`glossql=debug,rmcp=info,sqlx=debug`).
# Lines on a terminal, JSON otherwise, on stdout.
# GLOSSQL_LOG=info

# Export the record to an OpenTelemetry collector as well — spans as
# traces, events as logs: the collector's OTLP address. Unset, nothing
# is exported. The transport is OTEL_EXPORTER_OTLP_PROTOCOL:
# http/protobuf (the default, port 4318) or grpc (port 4317). A hosted
# collector's credentials go in OTEL_EXPORTER_OTLP_HEADERS; what names
# this deployment in OTEL_RESOURCE_ATTRIBUTES. A platform's managed
# collector injects the endpoint and the protocol itself.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
