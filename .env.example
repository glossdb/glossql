# serverd's authorization configuration. Copy to `.env` beside where the
# server is started (it reads `.env` from the working directory), or set
# the same variables in the environment — a container does the latter.
# `.env` is never committed.

# The authorization server: its issuer URL — any OpenID Connect
# provider. Its OpenID configuration is read at boot and names the keys
# tokens are verified against.
GLOSSQL_ISSUER=https://issuer.example

# This server's canonical URI — the API identifier registered at the
# issuer, and the `aud` every token must name (RFC 8707 §2). Defaults to
# http://<--addr> when unset.
GLOSSQL_AUDIENCE=http://127.0.0.1:8080

# The application registered at the issuer for this server. Its id is
# also what a token minted for this application carries as `azp`, which
# is what the gate binds on when an issuer leaves `aud` empty. Its secret
# is used only by the browser login on /app.
GLOSSQL_CLIENT_ID=
GLOSSQL_CLIENT_SECRET=
