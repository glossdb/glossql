statement ok
CREATE TEMP TABLE before_declare AS SELECT count(*) AS n FROM ducklake_snapshots('ws');

statement ok
DECLARE FUNCTION remark_bar FOR GLOBAL AS $$ SELECT max(threshold) AS bar FROM annotations('remark', 'itself') $$ RETURNS remark_bar;

query T
SELECT count(*) = (SELECT n FROM before_declare) FROM ducklake_snapshots('ws');
----
true

query I
SELECT count(*) FROM glossql_outdated() WHERE function = 'remark_bar';
----
0

statement ok
DECLARE FUNCTION remark_bar FOR GLOBAL AS $$ SELECT min(threshold) AS bar FROM annotations('remark', 'itself') $$ RETURNS remark_bar;

query TT
SELECT asset, what FROM glossql_outdated() WHERE function = 'remark_bar';
----
remark_bar	function

