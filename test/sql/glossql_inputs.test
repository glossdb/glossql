# name: test/sql/glossql_inputs.test
# description: a result's inputs are the nodes it read, and the lake's snapshot id is the only version: an annotation outside the place a read names leaves the result current, one inside outdates it and is named, a change undone is a change, a result computed again with the same value keeps its readers current, a relationship declared or a view redefined outdates what walked the place, a result read out of date outdates its reader, an identical declaration takes no snapshot, and a read of the catalog past the read functions is refused at the declaration (SPEC §6)
# group: [sql]

require glossql

require json

require parquet

require ducklake

statement ok
ATTACH 'ducklake::memory:' AS ws (DATA_PATH '{TEST_DIR}/glossql_inputs_lake/');

statement ok
USE ws;

statement ok
PRAGMA glossql;

statement ok
DECLARE DATASET f1 SET (purpose: 'inputs');

statement ok
USE f1;

statement ok
CREATE TABLE f1.races AS SELECT i AS race_id, DATE '2024-01-01' + (i * 7)::INTEGER AS date, 'race ' || i AS name FROM range(6) t(i);

statement ok
CREATE TABLE f1.results AS SELECT i % 6 AS race_id, i % 3 AS driver_id, (i % 10)::INTEGER AS points FROM range(30) t(i);

statement ok
CREATE TABLE f1.circuits AS SELECT i::INTEGER AS circuit_id, 'circuit ' || i AS name FROM range(4) t(i);

statement ok
DECLARE PROPERTY role WITH $${"type": "object", "required": ["value"], "properties": {"value": {"enum": ["key", "measure", "dimension", "timestamp", "attribute"]}}}$$ AS FACT ON COLUMN;

statement ok
DECLARE PROPERTY meaning WITH $${"type": "object"}$$ AS FACT ON COLUMN;

# two metrics: points scans results and races and joins them on race_id; race_count scans races alone

statement ok
DECLARE PROPERTY points WITH $${"title": "Points"}$$ AS VIEW;

statement ok
GLOSS points ON f1 AS $${"sql": "SELECT r.date AS period, sum(x.points) AS value FROM f1.results x JOIN f1.races r ON r.race_id = x.race_id GROUP BY 1"}$$;

statement ok
DECLARE PROPERTY race_count WITH $${"title": "Races"}$$ AS VIEW;

statement ok
GLOSS race_count ON f1 AS $${"sql": "SELECT date AS period, count(*) AS value FROM f1.races GROUP BY 1"}$$;

# a check over a metric that reads one property on its sources, and one that reads its definition

statement ok
DECLARE PROPERTY role_check WITH $${"type": "integer"}$$ AS MEASUREMENT ON TABLE;

statement ok
DECLARE FUNCTION role_check FOR GLOBAL AS $$ SELECT count(value) AS n FROM annotations('role', 'its sources') $$ RETURNS role_check;

statement ok
DECLARE PROPERTY scans WITH $${"type": "integer"}$$ AS MEASUREMENT ON TABLE;

statement ok
DECLARE FUNCTION scans FOR GLOBAL AS $$ SELECT coalesce(sum(len(reads)), 0) AS n FROM definition('itself') $$ RETURNS scans;

statement ok
GLOSS role ON results.points AS $${"value": "measure"}$$;

statement ok
GLOSS meaning ON circuits.name AS $${"text": "the circuit's name"}$$;

query TTTTT
SELECT role_check(), scans() FROM points;
----
role_check	f1.points	role_check	1	true
scans	f1.points	scans	2	true

query TTTTT
SELECT role_check(), scans() FROM race_count;
----
role_check	f1.race_count	role_check	0	true
scans	f1.race_count	scans	1	true

# --- an annotation outside the place leaves the results current: nothing is computed

statement ok
GLOSS role ON circuits.name AS $${"value": "attribute"}$$;

statement ok
GLOSS meaning ON circuits.circuit_id AS $${"text": "the key"}$$;

query TTTTT
SELECT role_check(), scans() FROM points;
----
role_check	f1.points	role_check	1	false
scans	f1.points	scans	2	false

# a declaration of a property no read names leaves them current too

statement ok
DECLARE PROPERTY unrelated WITH $${"type": "object"}$$ AS FACT ON COLUMN;

query I
SELECT count(*) FROM glossql_outdated();
----
0

# --- an annotation inside the place outdates the results that read it, and no other, naming the node:
# races.date is a source of both metrics, results.race_id of points alone, and another property than
# role leaves role_check current

statement ok
GLOSS meaning ON results.race_id AS $${"text": "the race"}$$;

query I
SELECT count(*) FROM glossql_outdated();
----
0

statement ok
GLOSS role ON results.race_id AS $${"value": "key"}$$;

query TTTTT
SELECT function, subject, asset, what, reason FROM glossql_outdated() ORDER BY ALL;
----
role_check	f1.points	f1.results.race_id	annotation role	changed

query TTTTT
SELECT role_check() FROM points;
----
role_check	f1.points	role_check	2	true

statement ok
GLOSS role ON races.date AS $${"value": "timestamp"}$$;

query TTTT
SELECT function, subject, asset, what FROM glossql_outdated() ORDER BY ALL;
----
role_check	f1.points	f1.races.date	annotation role
role_check	f1.race_count	f1.races.date	annotation role

query TTTTT
SELECT role_check() FROM race_count;
----
role_check	f1.race_count	role_check	1	true

# --- the same annotation written again is no write: no snapshot, nothing more out of date

statement ok
CREATE TEMP TABLE taken AS SELECT count(*) AS n FROM ducklake_snapshots('ws');

statement ok
GLOSS role ON races.date AS $${"value": "timestamp"}$$;

query T
SELECT count(*) = (SELECT n FROM taken) FROM ducklake_snapshots('ws');
----
true

query TT
SELECT function, subject FROM glossql_outdated() ORDER BY ALL;
----
role_check	f1.points

statement ok
SELECT role_check() FROM points;

# --- changed and changed back is two snapshots: the result is out of date, and a result that read it
# possibly so. Computed again with the same value, it keeps the snapshot its value changed at, and the
# result that read it is current again without being computed

statement ok
DECLARE PROPERTY checked WITH $${"type": "integer"}$$ AS MEASUREMENT ON TABLE;

statement ok
DECLARE FUNCTION checked FOR GLOBAL AS $$ SELECT coalesce(sum(value::INTEGER), 0) AS n FROM results('role_check', 'itself') $$ RETURNS checked;

query TTTTT
SELECT checked() FROM race_count;
----
checked	f1.race_count	checked	1	true

statement ok
CREATE TEMP TABLE before AS SELECT changed_at FROM main.results WHERE function = 'role_check' AND subject = 'f1.race_count';

statement ok
GLOSS role ON races.date AS $${"value": "attribute"}$$;

statement ok
GLOSS role ON races.date AS $${"value": "timestamp"}$$;

query TTTT
SELECT function, asset, what, reason FROM glossql_outdated() WHERE subject = 'f1.race_count' ORDER BY ALL;
----
checked	f1.race_count	result role_check	possibly
role_check	f1.races.date	annotation role	changed

# a result it read is out of date: it is served marked, possibly out of date, and its value is as it was

query TT
SELECT property, state FROM GLOSSARY(race_count) WHERE property IN ('checked', 'role_check') ORDER BY ALL;
----
checked	possibly
role_check	stale

query TTTTT
SELECT role_check() FROM race_count;
----
role_check	f1.race_count	role_check	1	true

query T
SELECT m.changed_at = b.changed_at FROM main.results m, before b WHERE m.function = 'role_check' AND m.subject = 'f1.race_count';
----
true

query TTTTT
SELECT checked() FROM race_count;
----
checked	f1.race_count	checked	1	false

statement ok
SELECT role_check() FROM points;

# --- the definition is the view's annotation: any write to it outdates a reader of the view's definition.
# The view's lineage is stored again in the same write; with the same SQL it has the same value, so a
# reader of its sources stays current. A view redefined to read another table outdates both, through its
# lineage; computed again, they read that table

statement ok
GLOSS race_count ON f1 AS $${"sql": "SELECT date AS period, count(*) AS value FROM f1.races GROUP BY 1", "assumptions": [{"assumption": "a race counts once"}]}$$;

query TTTT
SELECT function, asset, what, reason FROM glossql_outdated() WHERE subject = 'f1.race_count' ORDER BY ALL;
----
scans	f1.race_count	definition	changed

statement ok
SELECT scans() FROM race_count;

statement ok
GLOSS race_count ON f1 AS $${"sql": "SELECT r.date AS period, count(*) AS value FROM f1.races r JOIN f1.circuits c ON c.circuit_id = r.race_id GROUP BY 1"}$$;

query TTT
SELECT function, asset, what FROM glossql_outdated() WHERE subject = 'f1.race_count' AND reason = 'changed' ORDER BY ALL;
----
role_check	f1.race_count	result lineage
scans	f1.race_count	definition
scans	f1.race_count	result lineage

query TTTTT
SELECT role_check(), scans() FROM race_count;
----
role_check	f1.race_count	role_check	1	true
scans	f1.race_count	scans	2	true

statement ok
GLOSS role ON circuits.circuit_id AS $${"value": "key"}$$;

query TTT
SELECT function, asset, what FROM glossql_outdated() WHERE subject = 'f1.race_count' AND reason = 'changed' ORDER BY ALL;
----
role_check	f1.circuits.circuit_id	annotation role

# computed again with another value, the result it read is a node that changed: its reader is out of date

statement ok
SELECT role_check() FROM race_count;

query TTTT
SELECT function, asset, what, reason FROM glossql_outdated() WHERE subject = 'f1.race_count' ORDER BY ALL;
----
checked	f1.race_count	result role_check	changed

statement ok
SELECT checked() FROM race_count;

# --- a relationship declared after a check that walked a view's relationships ran outdates that check,
# naming the set it joined; one between tables the view does not read leaves it current

statement ok
DECLARE PROPERTY related WITH $${"type": "integer"}$$ AS MEASUREMENT ON TABLE;

statement ok
DECLARE FUNCTION related FOR GLOBAL AS $$ SELECT count(*) AS n FROM annotations('meaning', 'its relationships') $$ RETURNS related;

query TTTTT
SELECT related() FROM points;
----
related	f1.points	related	0	true

statement ok
CREATE TABLE f1.teams AS SELECT i::INTEGER AS team_id FROM range(3) t(i);

statement ok
DECLARE RELATIONSHIP circuits.circuit_id -> teams.team_id;

query I
SELECT count(*) FROM glossql_outdated() WHERE function = 'related';
----
0

statement ok
DECLARE RELATIONSHIP results.race_id -> races.race_id;

query TTTT
SELECT function, asset, what, reason FROM glossql_outdated() WHERE function = 'related' ORDER BY ALL;
----
related	f1.races	relationships	changed
related	f1.results	relationships	changed

query TTTTT
SELECT related() FROM points;
----
related	f1.points	related	0	true

# --- a retyped column outdates the readers of its annotation, through the annotation's state; a reader
# of role over the dataset walks the dataset's assets, so a column retyped outdates it, and its value
# moves once an annotated column is

statement ok
DECLARE PROPERTY role_rows WITH $${"type": "integer"}$$ AS MEASUREMENT ON DATASET;

statement ok
DECLARE FUNCTION role_rows FOR GLOBAL AS $$ SELECT count(value) FILTER (WHERE state = 'current') AS n FROM annotations('role', 'the dataset') $$ RETURNS role_rows;

statement ok
SELECT role_rows() FROM f1;

statement ok
CREATE TEMP TABLE rows_before AS SELECT value::INTEGER AS n FROM main.results WHERE function = 'role_rows';

statement ok
ALTER TABLE f1.teams ALTER COLUMN team_id TYPE BIGINT;

query TTTT
SELECT function, asset, what, reason FROM glossql_outdated() WHERE function = 'role_rows' AND asset = 'f1' ORDER BY ALL;
----
role_rows	f1	assets	changed

statement ok
SELECT role_rows() FROM f1;

query T
SELECT value::INTEGER = (SELECT n FROM rows_before) FROM main.results WHERE function = 'role_rows';
----
true

statement ok
ALTER TABLE f1.results ALTER COLUMN points TYPE BIGINT;

# the lineage of the view over it is out of date, and brought current as any result

statement ok
SELECT lineage() FROM points;

query TT
SELECT subject, state FROM GLOSSARY(results.points) WHERE property = 'role';
----
f1.results.points	stale

statement ok
SELECT role_rows() FROM f1;

query T
SELECT value::INTEGER = (SELECT n FROM rows_before) - 1 FROM main.results WHERE function = 'role_rows';
----
true

# --- a result a read returned: its reader is out of date while it is, and a result outside the place leaves the reader current

statement ok
DECLARE PROPERTY width WITH $${"type": "integer"}$$ AS MEASUREMENT ON COLUMN;

statement ok
DECLARE FUNCTION width FOR GLOBAL AS $$ SELECT count(DISTINCT v) AS n FROM subject_column($subject) $$ RETURNS width;

statement ok
DECLARE PROPERTY widths WITH $${"type": "integer"}$$ AS MEASUREMENT ON TABLE;

statement ok
DECLARE FUNCTION widths FOR GLOBAL AS $$ SELECT coalesce(sum(value::INTEGER), 0) AS n FROM results('width', 'its sources') $$ RETURNS widths;

statement ok
SELECT width() FROM results.points;

statement ok
SELECT width() FROM circuits.name;

query TTTTT
SELECT widths() FROM points;
----
widths	f1.points	widths	10	true

statement ok
INSERT INTO f1.circuits VALUES (9, 'circuit 9');

query T
SELECT current FROM GLOSSARY(circuits.name, all => true) WHERE property = 'width';
----
false

query TTTTT
SELECT widths() FROM points;
----
widths	f1.points	widths	10	false

statement ok
INSERT INTO f1.results VALUES (0, 0, 11);

query TTTT
SELECT function, asset, what, reason FROM glossql_outdated() WHERE subject = 'f1.points' AND function = 'widths';
----
widths	f1.results.points	result width	possibly

# --- a body that reads the catalog past the read functions is refused at its declaration: no input could
# follow what it read

statement ok
DECLARE PROPERTY raw_rows WITH $${"type": "integer"}$$ AS MEASUREMENT ON TABLE;

statement error
DECLARE FUNCTION raw_rows FOR GLOBAL AS $$ SELECT count(*) AS n FROM __ducklake_metadata_ws.main.glossql_glossary $$ RETURNS raw_rows;
----
untracked_read

statement error
DECLARE FUNCTION raw_rows FOR GLOBAL AS $$ SELECT count(*) AS n FROM annotations('role', 'its friends') $$ RETURNS raw_rows;
----
untracked_read

statement error
DECLARE FUNCTION raw_rows FOR GLOBAL AS $$ SELECT count(*) AS n FROM dataset_cells('f1') $$ RETURNS raw_rows;
----
untracked_read

query I
SELECT count(*) FROM functions_history WHERE name = 'raw_rows';
----
0

# --- a metric's series, series_aggregate() over the dataset's metrics: the views that are metrics, not plans,
# their columns named by a macro at bind. Its walk passes which views are metrics, so a plan defined in the
# dataset leaves its reader current; a role the macro reads on a metric's column, a metric defined and a load
# of a table a metric reads outdate it

statement ok
CREATE OR REPLACE MACRO main.points_axes(grain) AS TABLE
SELECT split_part(d.view, '.', 2) AS view, 'period' AS period_column, 'value' AS value_column,
       NULL::VARCHAR AS numerator, NULL::VARCHAR AS denominator, []::VARCHAR[] AS dims,
       CASE WHEN count(a.value) > 0 THEN coalesce(any_value(grain), 'day') END AS at_grain, false AS by_instant
FROM definition('the dataset''s metrics') d
LEFT JOIN annotations('role', 'the dataset''s metrics') a ON a.asset = d.view || '.value' AND a.value IS NOT NULL
GROUP BY d.view;

statement ok
DECLARE PROPERTY metric_sums WITH $${"type": "object"}$$ AS MEASUREMENT ON DATASET;

statement ok
DECLARE FUNCTION metric_sums FOR GLOBAL AS $$ SELECT count(*) AS n, sum(value) FILTER (WHERE dimension = '') AS total FROM series_aggregate('f1', 'the dataset''s metrics', 'points_axes', 'month') $$ RETURNS metric_sums;

query TTT
SELECT r.read, r."where", r.what FROM functions f, unnest(from_json(f.reads, '[{"kind": "VARCHAR", "read": "VARCHAR", "what": "VARCHAR", "where": "VARCHAR"}]')) u(r)
WHERE f.name = 'metric_sums' AND r.kind = 'data';
----
series_aggregate	NULL	f1, the dataset's metrics, points_axes, month

statement ok
SELECT metric_sums() FROM f1;

query II
SELECT value->>'n', value->>'total' FROM main.results WHERE property = 'metric_sums';
----
0	NULL

statement ok
DECLARE PROPERTY points_target WITH $${"title": "Points target", "x-kind": "plan", "x-plan-of": "points"}$$ AS VIEW;

statement ok
GLOSS points_target ON f1 AS $${"sql": "SELECT period, value * 1.1 AS value FROM f1.points"}$$;

statement ok
GLOSS role ON points_target.value AS $${"value": "measure"}$$;

query I
SELECT count(*) FROM glossql_outdated() WHERE function = 'metric_sums';
----
0

statement ok
GLOSS role ON points.value AS $${"value": "measure"}$$;

query TT
SELECT asset, what FROM glossql_outdated() WHERE function = 'metric_sums';
----
f1.points.value	annotation role

statement ok
SELECT metric_sums() FROM f1;

query II
SELECT value->>'n', value->>'total' FROM main.results WHERE property = 'metric_sums';
----
2	146.0

