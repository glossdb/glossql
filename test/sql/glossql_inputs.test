# --- a body runs in its subject's dataset: the dataset the caller works in reads nothing of it

statement ok
DECLARE DATASET other SET (purpose: 'elsewhere');

statement ok
DECLARE PROPERTY here WITH $${"type": "string"}$$ AS MEASUREMENT ON TABLE;

statement ok
DECLARE FUNCTION here FOR GLOBAL AS $$ SELECT current_schema() AS s $$ RETURNS here;

statement ok
USE other;

query TTTTT
SELECT here() FROM f1.circuits;
----
here	f1.circuits	here	"f1"	true

statement ok
USE f1;

# --- a GLOBAL function's table named without its dataset is taken in the subject's: where that dataset
# holds none yet, the computation fails and is stored with the table read by its name, and the table
# loaded makes it out of date

statement ok
CREATE TABLE other.laps AS SELECT 1 AS lap;

statement ok
DECLARE PROPERTY circuit_rows WITH $${"type": "integer"}$$ AS MEASUREMENT ON TABLE;

statement ok
DECLARE FUNCTION circuit_rows FOR GLOBAL AS $$ SELECT count(*) AS n FROM circuits $$ RETURNS circuit_rows;

statement error
SELECT circuit_rows() FROM other.laps;
----

query T
SELECT i.asset FROM main.results m JOIN inputs i ON i.result = m.id
WHERE m.function = 'circuit_rows' AND i.what = 'data';
----
other.circuits

query I
SELECT count(*) FROM glossql_outdated() WHERE function = 'circuit_rows';
----
0

statement ok
CREATE TABLE other.Circuits AS SELECT 1 AS circuit_id;

query TT
SELECT asset, what FROM glossql_outdated() WHERE function = 'circuit_rows';
----
other.circuits	data

query TTTTT
SELECT circuit_rows() FROM other.laps;
----
circuit_rows	other.laps	circuit_rows	1	true

# --- a macro the body follows that comes to read past the read functions fails the computation, stored
# with the function's declaration as its input: the macro restored makes it out of date, and it computes

statement ok
CREATE OR REPLACE MACRO main.lap_count() AS TABLE SELECT count(*) AS n FROM other.laps;

statement ok
DECLARE PROPERTY lapped WITH $${"type": "integer"}$$ AS MEASUREMENT ON TABLE;

statement ok
DECLARE FUNCTION lapped FOR GLOBAL AS $$ SELECT n FROM lap_count() $$ RETURNS lapped;

statement ok
CREATE OR REPLACE MACRO main.lap_count() AS TABLE SELECT count(*) AS n FROM main.glossary;

statement error
SELECT lapped() FROM other.laps;
