# name: test/sql/glossql_inputs.test
# description: a result's inputs are what its reads returned: an annotation outside the place a read names leaves the result current, one inside outdates it, a change undone makes it current again, a retyped column outdates the readers of its annotation, a result read out of date outdates its reader, and a read of the catalog past the read functions is out of date once stored (SPEC §6)
# group: [sql]

require glossql

require json

require parquet

require ducklake

statement ok
ATTACH 'ducklake::memory:' AS ws (DATA_PATH '{TEST_DIR}/glossql_inputs_lake/');

statement ok
USE ws;

statement ok
PRAGMA glossql;

statement ok
FROM glossql_kit('kits/lineage/kit.sql');

statement ok
DECLARE DATASET f1 SET (purpose: 'inputs');

statement ok
USE f1;

statement ok
CREATE TABLE f1.races AS SELECT i AS race_id, DATE '2024-01-01' + (i * 7)::INTEGER AS date, 'race ' || i AS name FROM range(6) t(i);

statement ok
CREATE TABLE f1.results AS SELECT i % 6 AS race_id, i % 3 AS driver_id, (i % 10)::INTEGER AS points FROM range(30) t(i);

statement ok
CREATE TABLE f1.circuits AS SELECT i::INTEGER AS circuit_id, 'circuit ' || i AS name FROM range(4) t(i);

statement ok
DECLARE ASPECT role WITH $${"type": "object", "required": ["value"], "properties": {"value": {"enum": ["key", "measure", "dimension", "timestamp", "attribute"]}}}$$ AS FACT ON COLUMN;

statement ok
DECLARE ASPECT meaning WITH $${"type": "object"}$$ AS FACT ON COLUMN;

# two metrics: points scans results and races and joins them on race_id; race_count scans races alone

statement ok
DECLARE ASPECT points WITH $${"title": "Points"}$$ AS VIEW;

statement ok
GLOSS points ON f1 AS $${"sql": "SELECT r.date AS period, sum(x.points) AS value FROM f1.results x JOIN f1.races r ON r.race_id = x.race_id GROUP BY 1"}$$;

statement ok
DECLARE ASPECT race_count WITH $${"title": "Races"}$$ AS VIEW;

statement ok
GLOSS race_count ON f1 AS $${"sql": "SELECT date AS period, count(*) AS value FROM f1.races GROUP BY 1"}$$;

# a check over a metric that reads one property on its sources, and one that reads its definition

statement ok
DECLARE ASPECT role_check WITH $${"type": "integer"}$$ AS MEASUREMENT ON TABLE;

statement ok
DECLARE FUNCTION role_check FOR GLOBAL AS $$ SELECT count(value) AS n FROM annotations('role', 'its sources') $$ RETURNS role_check;

statement ok
DECLARE ASPECT scans WITH $${"type": "integer"}$$ AS MEASUREMENT ON TABLE;

statement ok
DECLARE FUNCTION scans FOR GLOBAL AS $$ SELECT coalesce(sum(len(reads)), 0) AS n FROM definition('itself') $$ RETURNS scans;

statement ok
GLOSS role ON results.points AS $${"value": "measure"}$$;

statement ok
GLOSS meaning ON circuits.name AS $${"text": "the circuit's name"}$$;

query TTTTT
SELECT role_check(), scans() FROM points;
----
role_check	f1.points	role_check	1	true
scans	f1.points	scans	2	true

query TTTTT
SELECT role_check(), scans() FROM race_count;
----
role_check	f1.race_count	role_check	0	true
scans	f1.race_count	scans	1	true

# the inputs: one per read, named by the read function, its what and its where, and the declarations

query T
SELECT string_agg(i.input, ',' ORDER BY i.input) FROM measurements m JOIN inputs i USING (begin_snapshot) WHERE m.function = 'role_check' AND m.subject = 'f1.points';
----
annotations(role, its sources),function,property

query T
SELECT string_agg(i.input, ',' ORDER BY i.input) FROM measurements m JOIN inputs i USING (begin_snapshot) WHERE m.function = 'scans' AND m.subject = 'f1.points';
----
definition(definition, itself),function,property

# --- an annotation outside the place leaves the results current: nothing is computed

statement ok
GLOSS role ON circuits.name AS $${"value": "attribute"}$$;

statement ok
GLOSS meaning ON circuits.circuit_id AS $${"text": "the key"}$$;

query TTTTT
SELECT role_check(), scans() FROM points;
----
role_check	f1.points	role_check	1	false
scans	f1.points	scans	2	false

# a declaration of a property no read names leaves them current too

statement ok
DECLARE ASPECT unrelated WITH $${"type": "object"}$$ AS FACT ON COLUMN;

query I
SELECT count(*) FROM glossql_outdated();
----
0

# --- an annotation inside the place outdates the results whose read names it, and no other: races.date
# is a source of both metrics, results.race_id of points alone, and another property than role leaves role_check current

statement ok
GLOSS meaning ON results.race_id AS $${"text": "the race"}$$;

query I
SELECT count(*) FROM glossql_outdated();
----
0

statement ok
GLOSS role ON results.race_id AS $${"value": "key"}$$;

query TTTT
SELECT function, subject, input, reason FROM glossql_outdated() ORDER BY ALL;
----
role_check	f1.points	annotations(role, its sources)	changed

query TTTTT
SELECT role_check() FROM points;
----
role_check	f1.points	role_check	2	true

statement ok
GLOSS role ON races.date AS $${"value": "timestamp"}$$;

query TTT
SELECT function, subject, input FROM glossql_outdated() ORDER BY ALL;
----
role_check	f1.points	annotations(role, its sources)
role_check	f1.race_count	annotations(role, its sources)

query TTTTT
SELECT role_check() FROM race_count;
----
role_check	f1.race_count	role_check	1	true

# --- what the reads return, not when it was written: a change undone makes the result current again

statement ok
GLOSS role ON races.date AS $${"value": "attribute"}$$;

query T
SELECT current FROM GLOSSARY(race_count, all => true) WHERE aspect = 'role_check';
----
false

statement ok
GLOSS role ON races.date AS $${"value": "timestamp"}$$;

query T
SELECT current FROM GLOSSARY(race_count, all => true) WHERE aspect = 'role_check';
----
true

# --- the definition a body reads is the view's SQL and what it reads: an assumption added leaves it
# current; other SQL outdates it, and a reader of its sources too, since it reads race_id now

statement ok
GLOSS race_count ON f1 AS $${"sql": "SELECT date AS period, count(*) AS value FROM f1.races GROUP BY 1", "assumptions": [{"assumption": "a race counts once"}]}$$;

query TT
SELECT function, input FROM glossql_outdated() WHERE subject = 'f1.race_count' ORDER BY ALL;
----

statement ok
GLOSS race_count ON f1 AS $${"sql": "SELECT date AS period, count(DISTINCT race_id) AS value FROM f1.races GROUP BY 1"}$$;

query TT
SELECT function, input FROM glossql_outdated() WHERE subject = 'f1.race_count' ORDER BY ALL;
----
role_check	annotations(role, its sources)
scans	definition(definition, itself)

# --- a retyped column outdates the readers of its annotation, through the annotation's state: a reader of
# role over the dataset holds while a column nobody annotated is retyped, and is out of date once the
# annotated one is

statement ok
DECLARE ASPECT role_rows WITH $${"type": "integer"}$$ AS MEASUREMENT ON DATASET;

statement ok
DECLARE FUNCTION role_rows FOR GLOBAL AS $$ SELECT count(value) FILTER (WHERE state = 'current') AS n FROM annotations('role', 'the dataset') $$ RETURNS role_rows;

query TTTTT
SELECT role_rows() FROM f1;
----
role_rows	f1	role_rows	4	true

statement ok
ALTER TABLE f1.circuits ALTER COLUMN circuit_id TYPE BIGINT;

query TTTTT
SELECT role_rows() FROM f1;
----
role_rows	f1	role_rows	4	false

statement ok
ALTER TABLE f1.results ALTER COLUMN points TYPE BIGINT;

query TT
SELECT subject, state FROM GLOSSARY(results.points) WHERE aspect = 'role';
----
f1.results.points	stale

query TTTTT
SELECT role_rows() FROM f1;
----
role_rows	f1	role_rows	3	true

# --- a result a read returned: its reader is out of date while it is, and a result outside the place leaves the reader current

statement ok
DECLARE ASPECT width WITH $${"type": "integer"}$$ AS MEASUREMENT ON COLUMN;

statement ok
DECLARE FUNCTION width FOR GLOBAL AS $$ SELECT count(DISTINCT v) AS n FROM subject_column($subject) $$ RETURNS width;

statement ok
DECLARE ASPECT widths WITH $${"type": "integer"}$$ AS MEASUREMENT ON TABLE;

statement ok
DECLARE FUNCTION widths FOR GLOBAL AS $$ SELECT coalesce(sum(value::INTEGER), 0) AS n FROM results('width', 'its sources') $$ RETURNS widths;

statement ok
SELECT width() FROM results.points;

statement ok
SELECT width() FROM circuits.name;

query TTTTT
SELECT widths() FROM points;
----
widths	f1.points	widths	10	true

statement ok
INSERT INTO f1.circuits VALUES (9, 'circuit 9');

query T
SELECT current FROM GLOSSARY(circuits.name, all => true) WHERE aspect = 'width';
----
false

query TTTTT
SELECT widths() FROM points;
----
widths	f1.points	widths	10	false

statement ok
INSERT INTO f1.results VALUES (0, 0, 11);

query TTT
SELECT function, input, reason FROM glossql_outdated() WHERE subject = 'f1.points' AND function = 'widths';
----
widths	results(width, its sources)	outdated

# --- a body that reads the catalog past the read functions: what it read cannot be told again, so the
# result is out of date once it is stored, and a call computes it again

statement ok
DECLARE ASPECT raw_rows WITH $${"type": "integer"}$$ AS MEASUREMENT ON TABLE;

statement ok
DECLARE FUNCTION raw_rows FOR GLOBAL AS $$ SELECT count(*) AS n FROM __ducklake_metadata_ws.main.glossql_glossary $$ RETURNS raw_rows;

statement ok
SELECT raw_rows() FROM points;

query TT
SELECT input, reason FROM glossql_outdated() WHERE function = 'raw_rows';
----
unnamed: main.glossql_glossary	changed

statement ok
SELECT raw_rows() FROM points;

query I
SELECT count(*) FROM measurements_history WHERE function = 'raw_rows';
----
2
