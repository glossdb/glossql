# name: test/sql/glossql.test
# description: the glossql grammar as a DuckDB 2.0 grammar extension — spike coverage
# group: [sql]

require glossql

require json

require parquet

require ducklake

# the grammar is opt-in per connection: before, a glossql statement is a parser error
statement error
GLOSS unit ON orders.amount AS $${"value": "EUR"}$$;
----
Parser Error

query TT
SELECT name, description FROM duckdb_grammar_extensions() WHERE name = 'glossql';
----
glossql	glossql: the context language over DuckDB — DECLARE, GLOSS, GLOSSARY()

# PRAGMA glossql activates the grammar for this connection beside what is active, and makes the store
query T
SELECT list_contains(current_setting('active_grammar_extensions'), 'glossql');
----
false

statement ok
ATTACH 'ducklake::memory:' AS ws (DATA_PATH '{TEST_DIR}/glossql_lake/');

statement ok
USE ws;

statement ok
PRAGMA glossql;

query T
SELECT list_contains(current_setting('active_grammar_extensions'), 'glossql');
----
true

# a dataset is a schema: the default one is main, and a COLUMN aspect takes landed columns
statement ok
CREATE TABLE orders (id INTEGER, customer_id INTEGER, amount DOUBLE);

# --- DECLARE ASPECT: a new Statement alternative executed through ExtensionStatement

statement ok
DECLARE ASPECT unit WITH $${"type": "object", "properties": {"value": {"type": "string"}}}$$ AS FACT ON COLUMN;

statement ok
DECLARE ASPECT revenue WITH $${"title": "revenue", "x-kind": "measure"}$$ AS QUERY;

statement ok
DECLARE ASPECT min_max WITH $${"type": "object"}$$ AS MEASUREMENT ON COLUMN, TABLE;

query TTT
SELECT name, kind, grains FROM aspects ORDER BY name;
----
min_max	MEASUREMENT	[COLUMN, TABLE]
revenue	QUERY	[]
unit	FACT	[COLUMN]

# a QUERY aspect takes no grain clause (SPEC §5.1), refused at parse time
statement error
DECLARE ASPECT dso WITH $${}$$ AS QUERY ON COLUMN;
----
a QUERY aspect takes no grain clause

# --- GLOSS: dollar-quoted JSON body, actor from the connection

statement ok
GLOSS unit ON orders.amount AS $${"value": "EUR", "source_column": "currency_code"}$$;

statement ok
SET VARIABLE glossql_actor = 'human';

statement ok
GLOSS unit ON orders.amount AS $${"value": "USD"}$$;

# who the actor is rides the connection too, for the record; supersession keys on the kind alone
statement ok
SET VARIABLE glossql_actor_id = 'philipp';

statement ok
GLOSS unit ON orders.amount AS $${"value": "CHF"}$$;

statement ok
RESET VARIABLE glossql_actor;

statement ok
RESET VARIABLE glossql_actor_id;

query TTTTT
SELECT dataset, subject, aspect, actor_kind, actor_id FROM glossary ORDER BY actor_kind, seq;
----
main	main.orders.amount	unit	agent	NULL
main	main.orders.amount	unit	human	NULL
main	main.orders.amount	unit	human	philipp

# a body that is not JSON is refused by the store's JSON column
statement error
GLOSS unit ON orders.amount AS $$not json$$;
----
Malformed JSON

# --- GLOSSARY(): a new InnerTableRef alternative, planned as a subquery over the store

# collapsed read: one row per (subject, aspect), human over agent, newest first
query TTT
SELECT subject, aspect, value FROM GLOSSARY(orders.amount);
----
main.orders.amount	unit	{"value": "CHF"}

# subject::aspect narrows; all => true serves every slot
query TTTT
SELECT subject, aspect, actor, body FROM GLOSSARY(orders.amount::unit, all => true) ORDER BY actor;
----
main.orders.amount	unit	agent	{"value": "EUR", "source_column": "currency_code"}
main.orders.amount	unit	human	{"value": "CHF"}

# the read composes with ordinary SQL: alias, join, filter
query TI
SELECT g.aspect, count(*) FROM GLOSSARY(orders.amount, all => true) AS g GROUP BY g.aspect;
----
unit	2

# a table serves its columns (SPEC §5.3); a sweep takes no subject
query T
SELECT subject FROM GLOSSARY(orders);
----
main.orders.amount

query I
SELECT count(*) FROM GLOSSARY(all => true);
----
2

# --- pair paths: -> and <-> as subjects and relationship endpoints

statement ok
CREATE TABLE customers (id INTEGER, name VARCHAR);

statement ok
CREATE TABLE invoices (order_id INTEGER);

statement ok
CREATE TABLE txn (business_id INTEGER, account VARCHAR);

statement ok
CREATE TABLE coa (business_id INTEGER, code VARCHAR);

# an endpoint is a column of a landed table (SPEC §4)
statement error
DECLARE RELATIONSHIP orders.customer_id -> nobody.id;
----
main.nobody.id names no table of main

statement error
DECLARE RELATIONSHIP orders.nope -> customers.id;
----
main.orders.nope names no column nope of main.orders

statement error
DECLARE RELATIONSHIP txn.(business_id, nope) -> coa.(business_id, code);
----
names no column nope of main.txn

# only declared relationships exist: a pair path is a subject once declared
statement ok
DECLARE ASPECT fk_note WITH $${"type": "object"}$$ AS FACT ON RELATIONSHIP;

statement error
GLOSS fk_note ON orders.customer_id -> customers.id AS $${"value": "2% orphaned rows"}$$;
----
main.orders.customer_id -> main.customers.id is not a declared relationship

statement ok
DECLARE RELATIONSHIP orders.customer_id -> customers.id;

query T
DECLARE RELATIONSHIP orders.customer_id -> customers.id;
----
relationship main.orders.customer_id -> main.customers.id unchanged: no-op

statement ok
DECLARE RELATIONSHIP invoices.order_id <-> orders.id;

statement ok
DECLARE RELATIONSHIP txn.(business_id, account) -> coa.(business_id, code);

query TTTT
SELECT dataset, left_side, op, right_side FROM relationships ORDER BY left_side;
----
main	main.invoices.order_id	<->	main.orders.id
main	main.orders.customer_id	->	main.customers.id
main	main.txn.(business_id, account)	->	main.coa.(business_id, code)

statement ok
GLOSS fk_note ON orders.customer_id -> customers.id AS $${"value": "2% orphaned rows"}$$;

query TT
SELECT subject, value FROM GLOSSARY(orders.customer_id -> customers.id);
----
main.orders.customer_id -> main.customers.id	{"value": "2% orphaned rows"}

# --- the new words stay identifiers; stock SQL is untouched. In the lake's
# main schema `glossary` names the record's view; a dataset may still name a
# table so, spelled with its schema

query IIII
SELECT 1 AS gloss, 2 AS aspect, 3 AS glossary, 4 AS fact;
----
1	2	3	4

statement ok
CREATE SCHEMA other;

statement ok
CREATE TABLE other.glossary (id INTEGER);

query I
SELECT count(*) FROM other.glossary;
----
0

query T
SELECT '{"a": 1}'::JSON -> 'a';
----
1

# --- deactivating the grammar restores the stock parser on this connection

statement ok
RESET active_grammar_extensions;

statement error
GLOSS unit ON orders.amount AS $${"value": "EUR"}$$;
----
Parser Error
