# name: test/sql/gloss_kit_metrics.test
# description: the metrics kit — a metric is a view whose columns carry the vocabulary; the fact row per metric, the series over the collapsed slots and the view, the no-claim refusal, the ladder, facts, sources
# group: [sql]

require gloss

require json

require parquet

require ducklake

statement ok
ATTACH 'ducklake::memory:' AS ws (DATA_PATH '{TEST_DIR}/gloss_kit_metrics_lake/');

statement ok
USE ws;

statement ok
PRAGMA gloss;

statement ok
FROM gloss_kit('kits/kpi/kit.sql');

statement ok
FROM gloss_kit('kits/quality/kit.sql');

statement ok
FROM gloss_kit('kits/metrics/kit.sql');

statement ok
DECLARE DATASET fin SET (purpose: 'metrics');

statement ok
USE fin;

# a flow sliced two ways, booked daily, served monthly
statement ok
CREATE TABLE fin.ledger AS
  SELECT DATE '2024-01-01' + INTERVAL (i) DAY AS booked, (i % 7 + 1)::DOUBLE AS amount,
         ['general', 'water', 'parks'][i % 3 + 1] AS fund, ['salaries', 'supplies'][i % 2 + 1] AS object
  FROM range(120) r(i);

statement ok
DECLARE ASPECT spend WITH $${"title": "Spend"}$$ AS QUERY;

statement ok
GLOSS spend ON fin AS $${"sql": "SELECT date_trunc('month', booked)::DATE AS period, sum(amount) AS value, fund, object FROM fin.ledger GROUP BY ALL"}$$;

# --- the fact row: what the view's columns owe before anything is said

query TTTT
SELECT metric, applicable, reason, unadmitted FROM glossql.metric_axes();
----
spend	false	no column carries role timestamp: gloss role on the period column, GLOSS role ON fin.spend.<column> AS $${"value": "timestamp"}$$	[period, value, fund, object]

query T
SELECT owed[1] FROM glossql.metric_axes();
----
GLOSS role ON fin.spend.period AS $${"value": "<key|measure|dimension|timestamp|attribute>"}$$;

statement ok
GLOSS role ON spend.period AS $${"value": "timestamp"}$$;

statement ok
GLOSS role ON spend.value AS $${"value": "measure"}$$;

statement ok
GLOSS role ON spend.fund AS $${"value": "dimension"}$$;

statement ok
GLOSS dimension ON spend.fund AS $${"value": "primary"}$$;

statement ok
GLOSS role ON spend.object AS $${"value": "dimension"}$$;

# the roles stand and no cadence does: the row wants the profile
query TTTT
SELECT applicable, reason, dims, wanted FROM glossql.metric_axes();
----
false	no cadence stands on period: SELECT temporal() FROM fin.spend.period, or gloss ladder with a floor	[fund, object]	[temporal over fin.spend.period]

statement ok
SELECT temporal() FROM spend.period;

query TTTTTTTTTT
SELECT applicable, period_column, value_column, cadence, floor, rung, behavior, behavior_state, dims, judged_current FROM glossql.metric_axes();
----
true	period	value	month	month	48	NULL	none	[fund, object]	true

# --- the no-claim rule: rows have to be combined and nobody said how

statement error
SELECT * FROM glossql.metric_series();
----
no behaviour stands on fin.spend.value, and spend serves several rows in one period: gloss it — GLOSS behavior ON fin.spend.value AS $${"value": "<flow|stock|ratio>"}$$

statement ok
GLOSS behavior ON spend.value AS $${"value": "flow"}$$;

# the total at the floor, by the primary slice, at a coarser grain; a finer grain serves no rows
query TTTR
SELECT metric, dimension, period::DATE, value FROM glossql.metric_series() WHERE dimension = '' ORDER BY period;
----
spend	(empty)	2024-01-01	118.0
spend	(empty)	2024-02-01	116.0
spend	(empty)	2024-03-01	130.0
spend	(empty)	2024-04-01	113.0

query TTR
SELECT member, period::DATE, value FROM glossql.metric_series() WHERE dimension = 'fund' AND member = 'water' ORDER BY period;
----
water	2024-01-01	36.0
water	2024-02-01	42.0
water	2024-03-01	41.0
water	2024-04-01	40.0

query TTR
SELECT world, period::DATE, value FROM glossql.metric_series(grain := 'quarter') WHERE dimension = '' ORDER BY period;
----
actual	2024-01-01	364.0
actual	2024-04-01	113.0

query I
SELECT count(*) FROM glossql.metric_series(grain := 'day');
----
0

# a flow's empty period is a zero cell in the total
statement ok
DELETE FROM fin.ledger WHERE booked >= DATE '2024-02-01' AND booked < DATE '2024-03-01';

query TR
SELECT period::DATE, value FROM glossql.metric_series() WHERE dimension = '' ORDER BY period;
----
2024-01-01	118.0
2024-02-01	0.0
2024-03-01	130.0
2024-04-01	113.0

# --- what feeds the metric, through the view's lineage

# a field descends from the columns its derivation names; the summed value is computed, no column is its own
query TTTT
SELECT metric, field, source, table_name FROM glossql.metric_sources('spend') ORDER BY field NULLS FIRST;
----
spend	NULL	NULL	ledger
spend	fund	ledger.fund	ledger
spend	object	ledger.object	ledger
spend	period	ledger.booked	ledger

# --- a stock: the period's last level, summed over what stands at that instant

statement ok
CREATE TABLE fin.levels AS SELECT * FROM (VALUES
  (DATE '2024-01-31', 'ops', 10.0), (DATE '2024-01-31', 'sales', 4.0),
  (DATE '2024-02-29', 'ops', 11.0), (DATE '2024-02-29', 'sales', 5.0),
  (DATE '2024-03-31', 'ops', 12.0), (DATE '2024-03-31', 'sales', 5.0),
  (DATE '2024-04-30', 'ops', 12.0), (DATE '2024-04-30', 'sales', 6.0)) t(d, dept, n);

statement ok
DECLARE ASPECT headcount WITH $${"title": "Headcount"}$$ AS QUERY;

statement ok
GLOSS headcount ON fin AS $${"sql": "SELECT d AS period, n AS value, dept FROM fin.levels"}$$;

statement ok
GLOSS role ON headcount.period AS $${"value": "timestamp"}$$;

statement ok
GLOSS role ON headcount.value AS $${"value": "measure"}$$;

statement ok
GLOSS role ON headcount.dept AS $${"value": "dimension"}$$;

statement ok
SELECT temporal() FROM headcount.period;

statement ok
GLOSS behavior ON headcount.value AS $${"value": "stock"}$$;

query TR
SELECT period::DATE, value FROM glossql.metric_series() WHERE metric = 'headcount' AND dimension = '' ORDER BY period;
----
2024-01-01	14.0
2024-02-01	16.0
2024-03-01	17.0
2024-04-01	18.0

query TTTR
SELECT dimension, member, period::DATE, value FROM glossql.metric_series(grain := 'quarter') WHERE metric = 'headcount' ORDER BY dimension, member, period;
----
(empty)	(empty)	2024-01-01	17.0
(empty)	(empty)	2024-04-01	18.0
dept	ops	2024-01-01	12.0
dept	ops	2024-04-01	12.0
dept	sales	2024-01-01	5.0
dept	sales	2024-04-01	6.0

# --- a ratio re-divides its summed halves, which the view serves as columns the claim names

statement ok
CREATE TABLE fin.offers AS SELECT * FROM (VALUES
  (DATE '2024-01-15', 'ops', 3, 4), (DATE '2024-02-15', 'ops', 1, 4),
  (DATE '2024-01-15', 'sales', 2, 2), (DATE '2024-02-15', 'sales', 0, 2)) t(d, dept, won, offered);

statement ok
DECLARE ASPECT win_rate WITH $${"title": "Win rate"}$$ AS QUERY;

statement ok
GLOSS win_rate ON fin AS $${"sql": "SELECT d AS period, dept, won, offered, won / offered AS value FROM fin.offers"}$$;

statement ok
GLOSS role ON win_rate.period AS $${"value": "timestamp"}$$;

statement ok
GLOSS role ON win_rate.value AS $${"value": "measure"}$$;

statement ok
GLOSS role ON win_rate.dept AS $${"value": "dimension"}$$;

statement ok
GLOSS behavior ON win_rate.value AS $${"value": "ratio", "numerator": "won", "denominator": "offered"}$$;

statement ok
SELECT temporal() FROM win_rate.period;

query TTRRR
SELECT dimension, period::DATE, value, num, den FROM glossql.metric_series() WHERE metric = 'win_rate' AND dimension = '' ORDER BY period;
----
(empty)	2024-01-01	0.8333333333333334	5.0	6.0
(empty)	2024-02-01	0.16666666666666666	1.0	6.0

query TTRRR
SELECT member, period::DATE, value, num, den FROM glossql.metric_series(grain := 'quarter') WHERE metric = 'win_rate' ORDER BY dimension, member;
----
(empty)	2024-01-01	0.5	6.0	12.0
ops	2024-01-01	0.5	4.0	8.0
sales	2024-01-01	0.5	2.0	4.0

# --- the ladder: a floor coarser than the cadence, and a rung of one bucket

statement ok
GLOSS ladder ON headcount.period AS $${"floor": "quarter", "windows": {"quarter": 1}}$$;

query TTI
SELECT cadence, floor, rung FROM glossql.metric_axes() WHERE metric = 'headcount';
----
month	quarter	1

query TR
SELECT period::DATE, value FROM glossql.metric_series() WHERE metric = 'headcount' AND dimension = '' ORDER BY period;
----
2024-04-01	18.0

# --- a re-grounding with other sql: the claims on the view's columns read stale, served and marked

statement ok
GLOSS headcount ON fin AS $${"sql": "SELECT d AS period, n * 1 AS value, dept FROM fin.levels"}$$;

query TTTT
SELECT applicable, judged_current, behavior, behavior_state FROM glossql.metric_axes() WHERE metric = 'headcount';
----
true	false	stock	stale

# --- a fact serves one number; a stop serves its reason

statement ok
DECLARE ASPECT fte_cap WITH $${"title": "FTE cap", "x-kind": "fact"}$$ AS QUERY;

statement ok
GLOSS fte_cap ON fin AS $${"sql": "SELECT 40 AS value"}$$;

query TRT
SELECT * FROM glossql.fact_values();
----
fte_cap	40.0	NULL

query TT
SELECT applicable, reason FROM glossql.metric_axes() WHERE metric = 'fte_cap';
----
false	a fact serves one number, read through fact_values()

statement ok
GLOSS win_rate ON fin AS $${"stopped": "offers are not booked before 2024"}$$;

query TT
SELECT applicable, reason FROM glossql.metric_axes() WHERE metric = 'win_rate';
----
false	stopped: offers are not booked before 2024

query I
SELECT count(*) FROM glossql.metric_series() WHERE metric = 'win_rate';
----
0

# --- a list over every metric skips what needs a claim nobody made, and says so in the fact row

statement ok
GLOSS behavior ON headcount.value AS $${"value": "none"}$$;

query I
SELECT count(DISTINCT metric) FROM glossql.metric_series(unclaimed := 'skip');
----
1

statement error
SELECT count(*) FROM glossql.metric_series();
----
the behaviour on fin.headcount.value is none, so its rows do not combine
