# name: test/sql/glossql_depends_on.test
# description: a function declared with DEPENDS ON says what its stored result depends on in the catalog: the result is current while the query returns the stored value and the tables its body read are unchanged; a write elsewhere in the catalog leaves it current
# group: [sql]

require glossql

require json

require parquet

require ducklake

statement ok
ATTACH 'ducklake::memory:' AS ws (DATA_PATH '{TEST_DIR}/glossql_depends_on_lake/');

statement ok
USE ws;

statement ok
PRAGMA glossql;

statement ok
DECLARE DATASET fin SET (purpose: 'depends on');

statement ok
USE fin;

statement ok
CREATE TABLE fin.orders AS SELECT i AS id, i * 1.5 AS amount FROM range(4) t(i);

statement ok
CREATE TABLE fin.other AS SELECT 1 AS x;

statement ok
CREATE TABLE fin.marks AS SELECT 'a' AS mark;

statement ok
DECLARE ASPECT note WITH $${"type": "object"}$$ AS FACT ON COLUMN;

statement ok
DECLARE ASPECT flag WITH $${"type": "object"}$$ AS FACT ON COLUMN;

statement ok
GLOSS note ON orders.amount AS $${"text": "first"}$$;

statement ok
DECLARE ASPECT noted WITH $${"type": "object"}$$ AS MEASUREMENT ON COLUMN;

statement ok
DECLARE ASPECT noted_plain WITH $${"type": "object"}$$ AS MEASUREMENT ON COLUMN;

# the same body twice: once with the clause, once without

statement ok
DECLARE FUNCTION noted FOR fin AS $$
  SELECT (SELECT count(*) FROM main.glossary g WHERE g.subject = $subject AND g.aspect = 'note') AS notes,
         (SELECT count(*) FROM fin.orders) AS orders
$$ RETURNS noted
DEPENDS ON $$
  SELECT count(*) FROM main.glossary g WHERE g.subject = $subject AND g.aspect = 'note'
$$;

statement ok
DECLARE FUNCTION noted_plain FOR fin AS $$
  SELECT (SELECT count(*) FROM main.glossary g WHERE g.subject = $subject AND g.aspect = 'note') AS notes,
         (SELECT count(*) FROM fin.orders) AS orders
$$ RETURNS noted_plain;

# the query is stored with the function, its value with the result

query TI
SELECT name, depends_on IS NOT NULL FROM functions ORDER BY name;
----
noted	1
noted_plain	0

query TTTTT
SELECT noted(), noted_plain() FROM orders.amount;
----
noted	fin.orders.amount	noted	{"notes":1,"orders":4}	true
noted_plain	fin.orders.amount	noted_plain	{"notes":1,"orders":4}	true

query TT
SELECT function, depends_on FROM measurements ORDER BY function;
----
noted	1
noted_plain	NULL

# --- a glossary write the query does not cover: the result with the clause stays current, the one without is computed again

statement ok
GLOSS flag ON orders.id AS $${"text": "elsewhere"}$$;

query TT
SELECT aspect, current FROM GLOSSARY(orders.amount, all => true) WHERE actor = 'function' ORDER BY aspect;
----
noted	true
noted_plain	false

query TTTTT
SELECT noted(), noted_plain() FROM orders.amount;
----
noted	fin.orders.amount	noted	{"notes":1,"orders":4}	false
noted_plain	fin.orders.amount	noted_plain	{"notes":1,"orders":4}	true

# another declaration, another table's rows: neither is what the result depends on

statement ok
DECLARE ASPECT later WITH $${"type": "object"}$$ AS FACT ON COLUMN;

statement ok
INSERT INTO fin.other VALUES (2);

query TTTTT
SELECT noted() FROM orders.amount;
----
noted	fin.orders.amount	noted	{"notes":1,"orders":4}	false

# --- a write the query covers: not current, computed again

statement ok
GLOSS note ON orders.amount AS $${"text": "second"}$$;

query TT
SELECT aspect, current FROM GLOSSARY(orders.amount, all => true) WHERE actor = 'function' ORDER BY aspect;
----
noted	false
noted_plain	false

query TTTTT
SELECT noted() FROM orders.amount;
----
noted	fin.orders.amount	noted	{"notes":2,"orders":4}	true

query T
SELECT depends_on FROM measurements WHERE function = 'noted' ORDER BY seq;
----
1
2

# --- new rows in a table the body read: not current, computed again

statement ok
INSERT INTO fin.orders VALUES (9, 9.0);

query TT
SELECT aspect, current FROM GLOSSARY(orders.amount, all => true) WHERE aspect = 'noted';
----
noted	false

query TTTTT
SELECT noted() FROM orders.amount;
----
noted	fin.orders.amount	noted	{"notes":2,"orders":5}	true

query TTTTT
SELECT noted() FROM orders.amount;
----
noted	fin.orders.amount	noted	{"notes":2,"orders":5}	false

# --- a test's result is current with the value it read

statement ok
DECLARE FUNCTION all_current FOR fin AS $$ SELECT subject, CASE WHEN bool_and(current) THEN 'green' ELSE 'red' END AS state, 0.0 AS score FROM annotations GROUP BY subject $$;

statement ok
DECLARE TEST noted_test ON noted DETECTOR all_current THRESHOLD 0.5;

statement ok
GLOSS flag ON orders.id AS $${"text": "elsewhere again"}$$;

query TTT
SELECT subject, state, current FROM TESTS(orders.amount::noted);
----
fin.orders.amount	green	true

# --- an unchanged re-declaration is no new declaration; another query is, and the stored result is not served

statement ok
DECLARE FUNCTION noted FOR fin AS $$
  SELECT (SELECT count(*) FROM main.glossary g WHERE g.subject = $subject AND g.aspect = 'note') AS notes,
         (SELECT count(*) FROM fin.orders) AS orders
$$ RETURNS noted
DEPENDS ON $$
  SELECT count(*) FROM main.glossary g WHERE g.subject = $subject AND g.aspect = 'note'
$$;

query I
SELECT count(*) FROM functions WHERE name = 'noted';
----
1

statement ok
DECLARE FUNCTION noted FOR fin AS $$
  SELECT (SELECT count(*) FROM main.glossary g WHERE g.subject = $subject AND g.aspect = 'note') AS notes,
         (SELECT count(*) FROM fin.orders) AS orders
$$ RETURNS noted
DEPENDS ON $$
  SELECT 'notes: ' || count(*) FROM main.glossary g WHERE g.subject = $subject AND g.aspect = 'note'
$$;

query TTTTT
SELECT noted() FROM orders.amount;
----
noted	fin.orders.amount	noted	{"notes":2,"orders":5}	true

# --- a query over a catalog read: the value at the read is the value at extraction

statement ok
DECLARE ASPECT noted_read WITH $${"type": "integer"}$$ AS MEASUREMENT ON COLUMN;

statement ok
DECLARE FUNCTION noted_read FOR fin AS $$
  SELECT count(*) AS n FROM main.glossary g WHERE g.subject = $subject AND g.aspect = 'note'
$$ RETURNS noted_read
DEPENDS ON $$
  SELECT string_agg(value::VARCHAR, '|' ORDER BY subject) FROM glossql_glossary($subject, 'note', false)
$$;

query TTTTT
SELECT noted_read() FROM orders.amount;
----
noted_read	fin.orders.amount	noted_read	2	true

statement ok
GLOSS flag ON orders.id AS $${"text": "a third time"}$$;

query TT
SELECT aspect, current FROM GLOSSARY(orders.amount, all => true) WHERE aspect IN ('noted', 'noted_read') ORDER BY aspect;
----
noted	true
noted_read	true

statement ok
GLOSS note ON orders.amount AS $${"text": "third"}$$;

query TT
SELECT aspect, current FROM GLOSSARY(orders.amount, all => true) WHERE aspect IN ('noted', 'noted_read') ORDER BY aspect;
----
noted	false
noted_read	false

# --- the query runs in the result's dataset, whichever dataset the reader uses

statement ok
DECLARE ASPECT here WITH $${"type": "string"}$$ AS MEASUREMENT ON COLUMN;

statement ok
DECLARE FUNCTION here FOR fin AS $$ SELECT current_schema() AS s FROM range(1) $$ RETURNS here
DEPENDS ON $$ SELECT current_schema() $$;

query TTTTT
SELECT here() FROM orders.amount;
----
here	fin.orders.amount	here	"fin"	true

statement ok
DECLARE DATASET ops SET (purpose: 'another dataset');

statement ok
USE ops;

query TT
SELECT aspect, current FROM GLOSSARY(fin.orders.amount, all => true) WHERE aspect = 'here';
----
here	true

query T
SELECT current_schema();
----
ops

statement ok
USE fin;

# --- a query that returns no row at the read, or fails: not current, and the read answers

statement ok
DECLARE ASPECT marked WITH $${"type": "integer"}$$ AS MEASUREMENT ON COLUMN;

statement ok
DECLARE FUNCTION marked FOR fin AS $$ SELECT 1 AS n FROM range(1) $$ RETURNS marked
DEPENDS ON $$ SELECT mark FROM fin.marks $$;

query TTTTT
SELECT marked() FROM orders.amount;
----
marked	fin.orders.amount	marked	1	true

query TT
SELECT aspect, current FROM GLOSSARY(orders.amount, all => true) WHERE aspect = 'marked';
----
marked	true

statement ok
DELETE FROM fin.marks;

query TT
SELECT aspect, current FROM GLOSSARY(orders.amount, all => true) WHERE aspect = 'marked';
----
marked	false

# at extraction the query must answer: no row, several rows and several columns are refused, each with its code

statement error
SELECT marked() FROM orders.amount;
----
depends_on_not_one_value

statement ok
INSERT INTO fin.marks VALUES ('a'), ('b');

statement error
SELECT marked() FROM orders.amount;
----
depends_on_not_one_value

statement ok
DROP TABLE fin.marks;

query TT
SELECT aspect, current FROM GLOSSARY(orders.amount, all => true) WHERE aspect = 'marked';
----
marked	false

query I
SELECT count(*) > 0 FROM TESTS();
----
true

statement error
SELECT marked() FROM orders.amount;
----
depends_on_failed

# nothing was stored by a refused extraction

query I
SELECT count(*) FROM measurements WHERE function = 'marked';
----
1

# a NULL is a value: the result is current while the query returns NULL

statement ok
DECLARE ASPECT unnoted WITH $${"type": "integer"}$$ AS MEASUREMENT ON COLUMN;

statement ok
DECLARE FUNCTION unnoted FOR fin AS $$ SELECT 1 AS n FROM range(1) $$ RETURNS unnoted
DEPENDS ON $$ SELECT string_agg(body::VARCHAR, '|') FROM main.glossary g WHERE g.subject = $subject AND g.aspect = 'flag' $$;

query TTTTT
SELECT unnoted() FROM orders.amount;
----
unnoted	fin.orders.amount	unnoted	1	true

statement ok
GLOSS note ON orders.amount AS $${"text": "fourth"}$$;

query TTTTT
SELECT unnoted() FROM orders.amount;
----
unnoted	fin.orders.amount	unnoted	1	false

statement ok
GLOSS flag ON orders.amount AS $${"text": "now flagged"}$$;

query TTTTT
SELECT unnoted() FROM orders.amount;
----
unnoted	fin.orders.amount	unnoted	1	true

# an empty text is a value too, and not the NULL

statement ok
DECLARE ASPECT blank WITH $${"type": "integer"}$$ AS MEASUREMENT ON COLUMN;

statement ok
DECLARE FUNCTION blank FOR fin AS $$ SELECT 1 AS n FROM range(1) $$ RETURNS blank
DEPENDS ON $$ SELECT coalesce(string_agg(body::VARCHAR, '|'), '') FROM main.glossary g WHERE g.subject = $subject AND g.aspect = 'later' $$;

query TTTTT
SELECT blank() FROM orders.amount;
----
blank	fin.orders.amount	blank	1	true

statement ok
GLOSS flag ON orders.id AS $${"text": "once more"}$$;

query TTTTT
SELECT blank() FROM orders.amount;
----
blank	fin.orders.amount	blank	1	false

query TT
SELECT aspect, current FROM GLOSSARY(orders.amount, all => true) WHERE aspect IN ('blank', 'unnoted') ORDER BY aspect;
----
blank	true
unnoted	true

# --- the clause belongs to a function that stores a result: without RETURNS the parser refuses it

statement error
DECLARE FUNCTION no_result FOR fin AS $$ SELECT subject, 'green' AS state, 0.0 AS score FROM annotations $$ DEPENDS ON $$ SELECT 1 $$;
----
Parser Error

# the clause carries a query

statement error
DECLARE FUNCTION not_a_query FOR fin AS $$ SELECT 1 AS n FROM range(1) $$ RETURNS marked DEPENDS ON $$ DELETE FROM fin.orders $$;
----
depends_on_not_a_query

query I
SELECT count(*) FROM functions WHERE name IN ('no_result', 'not_a_query');
----
0
