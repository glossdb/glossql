statement ok
RESET VARIABLE glossql_subject;

# --- a join's table is the table the lineage says holds the column, a name with a dot in it too

statement ok
CREATE TABLE fin."cust.eu" AS SELECT i AS id FROM range(3) r(i);

statement ok
CREATE TABLE fin.ord AS SELECT i AS cust_id, 1.0 AS amount FROM range(5) r(i);

statement ok
GLOSS dotted ON fin AS $${"kind": "metric", "sql": "SELECT sum(o.amount) AS value FROM fin.ord o JOIN fin.\"cust.eu\" c ON c.id = o.cust_id"}$$;

query T
SELECT "to" FROM lineage('fin') WHERE "from" = 'fin.dotted' AND kind = 'reads' AND "to" IN ('fin.cust', 'fin.cust.eu', 'fin.ord') ORDER BY ALL;
----
fin.cust.eu
fin.ord

# --- the source a table is loaded from: an edge of the lineage, and a place a body names. A table's source
# system is its recipe's source; a view's are those of the tables it reads

statement ok
COPY (SELECT 'M' || i AS matnr, i * 1.0 AS qty FROM range(3) r(i)) TO '{TEST_DIR}/stock_dk.csv' (HEADER);

statement ok
COPY (SELECT 'I' || i AS item, i * 2.0 AS amount FROM range(2) r(i)) TO '{TEST_DIR}/stock_ch.csv' (HEADER);

statement ok
DECLARE SOURCE erp_dk SET (type: csv, location: '{TEST_DIR}');

statement ok
DECLARE SOURCE erp_ch SET (type: csv, location: '{TEST_DIR}');

statement ok
DECLARE RECIPE stock_dk ON fin FROM erp_dk AS $$SELECT matnr, CAST(qty AS DOUBLE) AS qty FROM read_csv('stock_dk.csv')$$;

statement ok
DECLARE RECIPE stock_ch ON fin FROM erp_ch AS $$SELECT item, CAST(amount AS DOUBLE) AS amount FROM read_csv('stock_ch.csv')$$;

statement ok
GLOSS stock ON fin AS $${"kind": "table", "sql": "SELECT matnr AS part, qty AS quantity FROM fin.stock_dk UNION ALL SELECT item, amount FROM fin.stock_ch"}$$;

query TTT
SELECT "from", "to", kind FROM lineage('fin') WHERE kind = 'loaded from' ORDER BY ALL;
----
fin.stock_ch	erp_ch	loaded from
fin.stock_dk	erp_dk	loaded from

# a view's definition names the source each table it reads is loaded from
statement ok
SET VARIABLE glossql_subject = 'fin.stock';

query TT
SELECT r.table_name, r.source FROM definition('itself'), unnest(reads) t(r) ORDER BY ALL;
----
fin.stock_ch	erp_ch
fin.stock_dk	erp_dk

# what the view requires of each read: nothing here, one row per branch
query TIT
SELECT c.table_name, c.branch, c.condition FROM definition('itself'), unnest(conditions) t(c) ORDER BY ALL;
----
fin.stock_ch	2	NULL
fin.stock_dk	1	NULL

# a relationship from the view's own column is one of the view's relationships
statement ok
DECLARE RELATIONSHIP fin.stock.part -> fin.stock_dk.matnr;

query T
SELECT asset FROM place('its relationships');
----
fin.stock.part -> fin.stock_dk.matnr

statement ok
RESET VARIABLE glossql_subject;

statement ok
GLOSS conventions ON erp_dk AS $${"units": "quantities in cases"}$$;

statement ok
SET VARIABLE glossql_subject = 'fin.stock_dk';

query TTT
SELECT asset, value->>'units', state FROM annotations('conventions', 'its source systems');
----
erp_dk	quantities in cases	current

statement ok
SET VARIABLE glossql_subject = 'fin.stock';

query TT
SELECT asset, state FROM annotations('conventions', 'its source systems') ORDER BY asset;
----
erp_ch	missing
erp_dk	current

statement ok
RESET VARIABLE glossql_subject;

# a table loaded without a recipe has no source system
query I
SELECT count(*) FROM places('fin') WHERE "where" = 'its source systems' AND subject = 'fin.orders';
----
0

statement ok
DECLARE PROPERTY systems WITH $${"type": "object"}$$ AS MEASUREMENT ON TABLE;

statement ok
DECLARE FUNCTION systems FOR GLOBAL AS $$
  SELECT list({'system': asset, 'state': state} ORDER BY asset) AS systems, count(*) FILTER (WHERE state = 'missing') AS missing FROM annotations('conventions', 'its source systems')
$$ RETURNS systems;

statement ok
SELECT systems() FROM stock;

statement ok
SELECT systems() FROM stock_dk;

query TT
SELECT subject, value::VARCHAR FROM main.results WHERE function = 'systems' ORDER BY subject;
----
fin.stock	{"systems":[{"system":"erp_ch","state":"missing"},{"system":"erp_dk","state":"current"}],"missing":1}
fin.stock_dk	{"systems":[{"system":"erp_dk","state":"current"}],"missing":0}

# a source's conventions annotated: the results that read them through the place are out of date, a
# table of another source's are not
query I
SELECT count(*) FROM glossql_outdated() WHERE function = 'systems';
----
0

statement ok
GLOSS conventions ON erp_ch AS $${"units": "quantities in pieces"}$$;

query TT
SELECT subject, reason FROM glossql_outdated() WHERE function = 'systems' ORDER BY ALL;
----
fin.stock	changed
