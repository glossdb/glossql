# name: test/sql/glossql_lineage_stored.test
# description: a view's lineage is a stored result (SPEC §6): defining the view stores it in the same write with the nodes it read and the relations it reads as edges; a write it did not read leaves it as stored; a column added to a table three views read puts the three out of date, and computed again with the same value they keep the snapshot they changed at, so a result that read a view's sources stays current; a view redefined to read another table stores its new lineage and puts what read the old one out of date; a view of a view reads the definition of the view it reads; the macros a view calls are followed to any depth; a view ended takes its edges with it
# group: [sql]

require glossql

require json

require parquet

require ducklake

statement ok
ATTACH 'ducklake::memory:' AS ws (DATA_PATH '{TEST_DIR}/glossql_lineage_stored_lake/');

statement ok
USE ws;

statement ok
PRAGMA glossql;

statement ok
DECLARE DATASET fin SET (purpose: 'the stored lineage');

statement ok
USE fin;

statement ok
CREATE TABLE fin.orders AS SELECT i AS id, i % 3 AS customer, i * 1.5 AS amount FROM range(6) t(i);

statement ok
CREATE TABLE fin.refunds AS SELECT i AS id, i * 0.5 AS amount FROM range(3) t(i);

# --- a view defined: its lineage is stored in the same write, with the nodes it read and its edges

statement ok
GLOSS revenue ON fin AS $${"kind": "metric", "sql": "SELECT customer, sum(amount) AS total FROM fin.orders GROUP BY customer"}$$;

query II
SELECT count(*), bool_and(m.begin_snapshot = g.begin_snapshot) FROM main.results m
JOIN main.glossary g ON g.property = 'revenue' AND g.subject = 'fin'
WHERE m.function = 'lineage' AND m.subject = 'fin.revenue';
----
1	true

query TT
SELECT i.asset, i.what FROM main.inputs i JOIN main.results m ON m.id = i.result
WHERE m.function = 'lineage' AND m.subject = 'fin.revenue' ORDER BY ALL;
----
fin.orders	definition
fin.revenue	definition

query TTT
SELECT "from", "to", kind FROM lineage('fin') WHERE "from" = 'fin.revenue' AND kind = 'reads' ORDER BY ALL;
----
fin.revenue	fin.orders	reads
fin.revenue	fin.orders.amount	reads
fin.revenue	fin.orders.customer	reads

query TTT
SELECT "column", derivation, complete FROM views_lineage('fin') WHERE view = 'revenue' ORDER BY ALL;
----
customer	fin.orders.customer:BIGINT	true
total	sum(fin.orders.amount:DECIMAL(21,1))	true

# three views over orders, one of them a view of a view

statement ok
GLOSS big_orders ON fin AS $${"kind": "table", "sql": "SELECT id, amount FROM fin.orders WHERE amount > 3"}$$;

statement ok
GLOSS order_ids ON fin AS $${"kind": "table", "sql": "SELECT id FROM fin.orders"}$$;

statement ok
GLOSS big_ids ON fin AS $${"kind": "table", "sql": "SELECT id FROM fin.big_orders"}$$;

query TT
SELECT i.asset, i.what FROM main.inputs i JOIN main.results m ON m.id = i.result
WHERE m.function = 'lineage' AND m.subject = 'fin.big_ids' ORDER BY ALL;
----
fin.big_ids	definition
fin.big_orders	definition
fin.orders	definition

query TT
SELECT "to", kind FROM lineage('fin') WHERE "from" = 'fin.big_ids' AND kind = 'reads' ORDER BY ALL;
----
fin.big_orders	reads
fin.orders	reads
fin.orders.amount	reads
fin.orders.id	reads

# a result that read the sources of a view

statement ok
DECLARE PROPERTY width WITH $${"type": "integer"}$$ AS MEASUREMENT ON COLUMN;

statement ok
DECLARE FUNCTION width FOR GLOBAL AS $$ SELECT count(DISTINCT v) AS n FROM subject_column($subject) $$ RETURNS width;

statement ok
DECLARE PROPERTY sources_read WITH $${"type": "integer"}$$ AS MEASUREMENT ON TABLE;

statement ok
DECLARE FUNCTION sources_read FOR GLOBAL AS $$ SELECT count(*) AS n FROM results('width', 'its sources') $$ RETURNS sources_read;

statement ok
SELECT sources_read() FROM fin.revenue;

query TT
SELECT asset, what FROM main.inputs i JOIN main.results m ON m.id = i.result
WHERE m.function = 'sources_read' AND i.what IN ('result lineage', 'definition') ORDER BY ALL;
----
fin.revenue	result lineage

statement ok
CREATE TABLE memory.main.before AS SELECT subject, begin_snapshot, changed_at FROM main.results WHERE function = 'lineage';

# --- a write no lineage read leaves every lineage as stored

statement ok
DECLARE PROPERTY note WITH $${"type": "object"}$$ AS FACT;

statement ok
GLOSS note ON fin AS $${"text": "unrelated"}$$;

query I
SELECT count(*) FROM main.results m JOIN memory.main.before b USING (subject)
WHERE m.function = 'lineage' AND m.begin_snapshot <> b.begin_snapshot;
----
0

query I
SELECT count(*) FROM glossql_outdated();
----
0

# --- a column added to the table three views read: their lineages are out of date, the view of a view's
# --- among them; computed again with the same value, each keeps the snapshot it changed at, and the result
# --- that read a view's sources stays current

statement ok
ALTER TABLE fin.orders ADD COLUMN note VARCHAR;

query TTT
SELECT function, subject, reason FROM glossql_outdated() WHERE function = 'lineage' AND what = 'definition' AND asset = 'fin.orders' ORDER BY ALL;
----
lineage	fin.big_ids	changed
lineage	fin.big_orders	changed
lineage	fin.order_ids	changed
lineage	fin.revenue	changed

query TT
SELECT function, reason FROM glossql_outdated() WHERE function = 'sources_read';
----
sources_read	possibly

statement ok
SELECT lineage() FROM fin.revenue;

statement ok
SELECT lineage() FROM fin.big_orders;

statement ok
SELECT lineage() FROM fin.order_ids;

statement ok
SELECT lineage() FROM fin.big_ids;

query II
SELECT count(*), count(*) FILTER (WHERE m.begin_snapshot > b.begin_snapshot AND m.changed_at = b.changed_at)
FROM main.results m JOIN memory.main.before b USING (subject) WHERE m.function = 'lineage';
----
4	4

query I
SELECT count(*) FROM glossql_outdated();
----
0

# served while current: a second call computes nothing

statement ok
CREATE TABLE memory.main.served AS SELECT begin_snapshot FROM main.results WHERE function = 'lineage' AND subject = 'fin.revenue';

statement ok
SELECT lineage() FROM fin.revenue;

query I
SELECT count(*) FROM main.results m JOIN memory.main.served s USING (begin_snapshot) WHERE m.subject = 'fin.revenue';
----
1

# --- a view redefined to read another table: its lineage is stored in the same write, its edges follow,
# --- and the result that read its sources is out of date

statement ok
GLOSS revenue ON fin AS $${"kind": "metric", "sql": "SELECT id AS customer, sum(amount) AS total FROM fin.refunds GROUP BY id"}$$;

query TT
SELECT "to", kind FROM lineage('fin') WHERE "from" = 'fin.revenue' AND kind = 'reads' ORDER BY ALL;
----
fin.refunds	reads
fin.refunds.amount	reads
fin.refunds.id	reads

query TTTT
SELECT function, asset, what, reason FROM glossql_outdated() ORDER BY ALL;
----
sources_read	fin.revenue	result lineage	changed

# --- a view of a view: the view it reads redefined puts its lineage out of date; computed again it reads the new one

statement ok
GLOSS big_orders ON fin AS $${"kind": "table", "sql": "SELECT r.id, r.amount FROM fin.refunds r"}$$;

query TTT
SELECT subject, asset, reason FROM glossql_outdated() WHERE function = 'lineage' ORDER BY ALL;
----
fin.big_ids	fin.big_orders	changed

statement ok
SELECT lineage() FROM fin.big_ids;

query TT
SELECT "to", kind FROM lineage('fin') WHERE "from" = 'fin.big_ids' AND kind = 'reads' ORDER BY ALL;
----
fin.big_orders	reads
fin.refunds	reads
fin.refunds.amount	reads
fin.refunds.id	reads

# --- the macros a view calls are followed to any depth: a macro a macro calls changed puts its lineage out of
# --- date; a cycle of macros ends the walk, and the lineage stores the planner's refusal

statement ok
CREATE OR REPLACE MACRO main.ratio_inner(x) AS x * 2;

statement ok
CREATE OR REPLACE MACRO main.ratio_outer(x) AS ratio_inner(x) + 1;

statement ok
CREATE OR REPLACE MACRO main.scaled_ids() AS TABLE SELECT ratio_outer(id) AS v FROM fin.orders;

statement ok
GLOSS scaled ON fin AS $${"kind": "table", "sql": "SELECT v FROM main.scaled_ids()"}$$;

query T
SELECT i.asset FROM main.inputs i JOIN main.results m ON m.id = i.result
WHERE m.function = 'lineage' AND m.subject = 'fin.scaled' AND i.what = 'macro' ORDER BY ALL;
----
main.ratio_inner
main.ratio_outer
main.scaled_ids

statement ok
CREATE OR REPLACE MACRO main.ratio_inner(x) AS x * 3;

query TTT
SELECT asset, what, reason FROM glossql_outdated() WHERE function = 'lineage' AND subject = 'fin.scaled';
----
main.ratio_inner	macro	changed

statement ok
SELECT lineage() FROM fin.scaled;

query I
SELECT count(*) FROM glossql_outdated() WHERE function = 'lineage' AND subject = 'fin.scaled';
----
0

statement ok
CREATE OR REPLACE MACRO main.ratio_inner(x) AS ratio_outer(x);

statement error
SELECT lineage() FROM fin.scaled;
----
Invalid Input Error

query II
SELECT value IS NULL, error IS NOT NULL FROM main.results WHERE function = 'lineage' AND subject = 'fin.scaled';
----
true	true

# --- a view ended: its lineage and its edges go with it

statement ok
GLOSS order_ids ON fin AS $${"stopped": "no longer read"}$$;

query I
SELECT count(*) FROM main.results WHERE function = 'lineage' AND subject = 'fin.order_ids';
----
0

query I
SELECT count(*) FROM main.edges WHERE "from" = 'fin.order_ids';
----
0

# --- the lineage is no value of the glossary, and a subject that is no view has none

query I
SELECT count(*) FROM GLOSSARY(fin) WHERE property = 'lineage';
----
0

statement error
SELECT lineage() FROM fin.orders;
----
not_a_view
