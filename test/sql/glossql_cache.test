# name: test/sql/glossql_cache.test
# description: the instance keeps a dataset's read rows while the store and the lake are unchanged; a write or a definition on any connection moves them
# group: [sql]

require glossql

require json

require parquet

require ducklake

statement ok
ATTACH 'ducklake::memory:' AS ws (DATA_PATH '{TEST_DIR}/glossql_cache_lake/');

statement ok
USE ws;

statement ok
PRAGMA glossql;

statement ok
DECLARE DATASET fin SET (purpose: 'the read cache');

statement ok
USE fin;

statement ok
CREATE TABLE fin.orders AS SELECT i AS id, i * 1.5 AS amount FROM range(4) t(i);

statement ok
CREATE VIEW fin.spend AS SELECT sum(amount) AS total FROM fin.orders;

statement ok
DECLARE ASPECT meaning WITH $${"type": "object", "properties": {"value": {"type": "string"}}}$$ AS FACT ON COLUMN;

statement ok
GLOSS meaning ON orders.amount AS $${"value": "the order's amount"}$$;

# the first read computes the dataset's rows; the second serves them
query III
SELECT subject, aspect, state FROM GLOSSARY(orders);
----
fin.orders.amount	meaning	current

query III
SELECT subject, aspect, state FROM GLOSSARY(orders);
----
fin.orders.amount	meaning	current

# a write on another connection moves the store's version: the next read computes again
statement ok con1
PRAGMA glossql;

statement ok con1
USE ws.fin;

statement ok con1
GLOSS meaning ON orders.id AS $${"value": "the order's number"}$$;

statement ok con1
GLOSS meaning ON spend.total AS $${"value": "the orders' total"}$$;

query II
SELECT subject, state FROM GLOSSARY(fin) ORDER BY subject;
----
fin.orders.amount	current
fin.orders.id	current
fin.spend.total	current

# a definition replaced on another connection moves the lake's snapshot: the value on the view reads stale
statement ok con1
CREATE OR REPLACE VIEW fin.spend AS SELECT sum(amount) * 2 AS total FROM fin.orders;

query II
SELECT subject, state FROM GLOSSARY(spend) ORDER BY subject;
----
fin.spend.total	stale

# a narrowed read serves its subject's rows from the same kept rows
query II
SELECT subject, state FROM GLOSSARY(orders.id);
----
fin.orders.id	current

# a view over the read: a catalog scan binds it for its columns while a read
# is computed, and a read through it serves the rows
statement ok
CREATE VIEW fin.states AS SELECT subject, state FROM glossql_glossary('fin', NULL, false);

query I
SELECT count(*) FROM information_schema.columns WHERE table_schema = 'fin' AND table_name = 'states';
----
2

statement ok con1
GLOSS meaning ON orders.id AS $${"value": "the order's number, assigned at booking"}$$;

query II
SELECT subject, state FROM fin.states ORDER BY subject;
----
fin.orders.amount	current
fin.orders.id	current
fin.spend.total	stale

# the kept rows are a read's: collapsed, raw or tests
statement error
SELECT * FROM glossql_cached('results', 'fin', NULL);
----
Invalid Input Error

query I
SELECT count(*) FROM glossql_cached('tests', 'fin', NULL);
----
0

# --- a kit's read kept: the rows of a table macro of main on the caller's dataset, computed once per
# store version

statement ok
CREATE MACRO ws.main.meanings() AS TABLE
SELECT subject, value->>'value' AS v FROM glossql_glossary(current_schema(), 'meaning', false) ORDER BY subject;

query II
SELECT * FROM glossql_kept('meanings');
----
fin.orders.amount	the order's amount
fin.orders.id	the order's number, assigned at booking
fin.spend.total	the orders' total

# a write on another connection moves the version: the rows are the read's again
statement ok con1
GLOSS meaning ON orders.amount AS $${"value": "the order's amount in euro"}$$;

query II
SELECT * FROM glossql_kept('meanings');
----
fin.orders.amount	the order's amount in euro
fin.orders.id	the order's number, assigned at booking
fin.spend.total	the orders' total

# each dataset keeps its own rows
statement ok
DECLARE DATASET ops SET (purpose: 'a second dataset');

statement ok
USE ws.ops;

statement ok
CREATE TABLE ws.ops.t (x INTEGER);

statement ok
GLOSS meaning ON t.x AS $${"value": "a number"}$$;

query II
SELECT * FROM glossql_kept('meanings');
----
ops.t.x	a number

statement ok
USE ws.fin;

query I
SELECT count(*) FROM glossql_kept('meanings');
----
3

# a kept read names a table macro of main
statement error
SELECT * FROM glossql_kept('no_such_read');
----
Catalog Error

# --- a read is kept per lake: two workspaces attached to one instance, a dataset of one name in each,
# both at one version, each served its own rows

statement ok
ATTACH 'ducklake::memory:' AS a (DATA_PATH '{TEST_DIR}/glossql_cache_lake_a/');

statement ok
ATTACH 'ducklake::memory:' AS b (DATA_PATH '{TEST_DIR}/glossql_cache_lake_b/');

statement ok
SET VARIABLE glossql_workspace = 'a';

statement ok
USE a;

statement ok
PRAGMA glossql;

statement ok
DECLARE DATASET fin SET (purpose: 'lake a');

statement ok
USE a.fin;

statement ok
CREATE TABLE a.fin.t (x INTEGER);

statement ok
DECLARE ASPECT meaning WITH $${"type": "object"}$$ AS FACT ON COLUMN;

statement ok
GLOSS meaning ON t.x AS $${"value": "lake a"}$$;

statement ok
SET VARIABLE glossql_workspace = 'b';

statement ok
USE b;

statement ok
PRAGMA glossql;

statement ok
DECLARE DATASET fin SET (purpose: 'lake b');

statement ok
USE b.fin;

statement ok
CREATE TABLE b.fin.t (x INTEGER);

statement ok
DECLARE ASPECT meaning WITH $${"type": "object"}$$ AS FACT ON COLUMN;

statement ok
GLOSS meaning ON t.x AS $${"value": "lake b"}$$;

query I
SELECT (SELECT id FROM ducklake_current_snapshot('a')) = (SELECT id FROM ducklake_current_snapshot('b'));
----
true

statement ok
SET VARIABLE glossql_workspace = 'a';

statement ok
USE a.fin;

query II
SELECT subject, value->>'value' FROM GLOSSARY(fin);
----
fin.t.x	lake a

statement ok
SET VARIABLE glossql_workspace = 'b';

statement ok
USE b.fin;

query II
SELECT subject, value->>'value' FROM GLOSSARY(fin);
----
fin.t.x	lake b
