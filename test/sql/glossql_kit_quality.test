# name: test/sql/glossql_kit_quality.test
# description: the quality kit: the structure screens as table macros over dataset_cells, and the measurements that land them
# group: [sql]

require glossql

require json

require parquet

require ducklake

statement ok
ATTACH 'ducklake::memory:' AS ws (DATA_PATH '{TEST_DIR}/glossql_kit_quality_lake/');

statement ok
USE ws;

statement ok
PRAGMA glossql;

statement ok
DECLARE DATASET fin SET (purpose: 'quality');

statement ok
USE fin;

statement ok
CREATE TABLE main.kpi AS FROM glossql_kit('kits/kpi/kit.sql');

statement ok
CREATE TABLE main.quality AS FROM glossql_kit('kits/quality/kit.sql');

query TTI
SELECT name, location, statements FROM kits ORDER BY name;
----
kpi	kits/kpi/kit.sql	19
quality	kits/quality/kit.sql	23

# --- dataset_cells: every cell of the dataset's tables, or of one table, as one relation

statement ok
CREATE TABLE fin.customers AS SELECT * FROM (VALUES (1, 'ann'), (2, 'ann'), (3, 'bob'), (4, 'bob'), (5, 'cat')) t(id, name);

statement ok
CREATE TABLE fin.orders AS SELECT * FROM (VALUES (1, 1), (2, 2), (3, 2), (4, 3), (5, 9)) t(order_id, customer_id);

query TTITIT
SELECT * FROM dataset_cells('fin') ORDER BY "table", ci, rn LIMIT 3;
----
customers	id	0	INTEGER	1	1
customers	id	0	INTEGER	2	2
customers	id	0	INTEGER	3	3

query III
SELECT count(*), count(DISTINCT "table"), count(DISTINCT ci) FROM dataset_cells('fin');
----
20	2	4

query I
SELECT count(*) FROM dataset_cells('fin.orders');
----
10

# cells := n bounds a read: a table whose cells would pass the bound is read as a sample of its rows kept by
# the hash of each row, the same rows every run, about the bound divided by the table's width, and rn numbers
# the rows read (SPEC §6)
statement ok
DECLARE DATASET bound SET (purpose: 'the cells bound');

statement ok
CREATE TABLE bound.wide AS SELECT i AS a, i % 7 AS b, i % 3 AS c, 'x' || i AS d FROM range(1000) t(i);

query II
SELECT count(*), max(rn) FROM dataset_cells('bound.wide', cells := 400);
----
376	94

query II
SELECT count(*), max(rn) FROM dataset_cells('bound.wide', cells := 40000);
----
4000	1000

query I
SELECT (SELECT list(val ORDER BY rn) FROM dataset_cells('bound.wide', cells := 40) WHERE "column" = 'a')
     = (SELECT list(val ORDER BY rn) FROM dataset_cells('bound.wide', cells := 40) WHERE "column" = 'a');
----
true

statement error
SELECT count(*) FROM dataset_cells('bound.wide', cells := 0);
----
positive cells bound

# a table's own columns named rn, val or column are cells like any other: the row number is the read's, under its own name
statement ok
CREATE TABLE fin.odd AS SELECT 1 AS rn, 'a' AS val, 'x' AS "column";

query IIT
SELECT count(*), count(DISTINCT rn), string_agg("column", ',' ORDER BY ci) FROM dataset_cells('fin.odd');
----
3	1	rn,val,column

statement ok
DROP TABLE fin.odd;

# --- relationship_candidates: the key from orders to customers, the orphan 9, and the measurement over it

query ITTTRII
SELECT seq, from_col, to_col, cardinality, overlap, matched, orphans FROM relationship_candidates('fin') ORDER BY seq;
----
1	orders.order_id	customers.id	one-to-one	1.0	5	0
2	orders.customer_id	customers.id	many-to-one	0.75	3	1
3	customers.id	orders.order_id	one-to-one	1.0	5	0
4	orders.customer_id	orders.order_id	many-to-one	0.75	3	1

statement ok
SELECT detect_relationships() FROM fin;

query TT
SELECT json_extract_string(value, '$.summary.candidates'), json_extract_string(value, '$.candidates[0].from')
FROM GLOSSARY(fin::relationship_candidates);
----
4	orders.customer_id

# the composite rescue: a reference that keys only within its account
statement ok
CREATE TABLE fin.statement AS SELECT (i // 10)::INTEGER + 1 AS account_no, 'r' || (i % 10 + 1) AS reference FROM range(20) t(i);

statement ok
CREATE TABLE fin.payment AS SELECT * FROM (VALUES (1, 'r1'), (2, 'r1'), (1, 'r3'), (2, 'r12')) t(account_no, reference);

query TTTT
SELECT from_col, to_col, kc_from, kc_to FROM relationship_candidates('fin') WHERE kc_to IS NOT NULL;
----
payment.reference	statement.reference	payment.account_no	statement.account_no

statement ok
DROP TABLE fin.statement;

statement ok
DROP TABLE fin.payment;

# --- relationship_checks: orphans and the temporal pairs over declared edges

statement ok
CREATE TABLE fin.invoices AS SELECT i AS invoice_id, DATE '2024-01-01' + INTERVAL (i) DAY AS inv_date FROM range(1, 19) t(i);

statement ok
CREATE TABLE fin.payments AS
  SELECT i AS pay_id, CASE WHEN i <= 18 THEN i ELSE 80 + i END AS invoice_id,
         DATE '2024-01-01' + INTERVAL (CASE WHEN i <= 3 THEN i - 10 ELSE i + 30 END) DAY AS pay_date,
         CASE WHEN i <= 10 THEN 'a' ELSE 'b' END AS city,
         CASE WHEN i <= 10 THEN 'X' WHEN i <= 18 THEN 'Y' ELSE 'Z' END AS country
  FROM range(1, 21) t(i);

query TT
SELECT applicable, reason FROM relationship_checks('fin');
----
false	no declared relationships

statement ok
DECLARE RELATIONSHIP payments.invoice_id -> invoices.invoice_id;

statement ok
DECLARE RELATIONSHIP payments.city -> payments.country;

query TIIRTTII
SELECT relationship, filled, orphans, orphan_rate, child_column, parent_column, joined, precedes FROM relationship_checks('fin') ORDER BY seq, pair_seq;
----
fin.payments.invoice_id -> fin.invoices.invoice_id	20	2	0.1	pay_date	inv_date	18	3
fin.payments.city -> fin.payments.country	20	10	0.5	NULL	NULL	NULL	NULL

statement ok
SELECT relationship_coherence() FROM fin;

query TTT
SELECT json_extract_string(value, '$.applicable'), json_extract_string(value, '$.relationships[0].orphans'), json_extract_string(value, '$.relationships[0].temporal[0].precedes')
FROM GLOSSARY(fin::relationship_coherence);
----
true	2	3

# the bind read the record's edges beside the plan, and the row names them with the tables the edges read
query T
SELECT reads FROM main.measurements WHERE function = 'relationship_coherence';
----
fin.invoices,fin.payments,main.relationships

# --- hierarchy_candidates: the two planted dependencies, the exclusions, the measurement's ship line

statement ok
CREATE TABLE fin.geo AS
  SELECT 'z' || lpad((i % 27)::VARCHAR, 2, '0') AS zip, 'city' || ((i % 27) // 3) AS city, 'C' || ((i % 27) // 3) AS city_code,
         'state' || ((i % 27) // 9) AS state, CASE WHEN i < 2 THEN 'B' ELSE 'A' END AS flag
  FROM range(108) t(i);

query TTRR
SELECT from_col, to_col, round(g3, 3), round(gk_lambda, 3) FROM hierarchy_candidates('fin.geo') WHERE (from_col, to_col) IN (('zip', 'city'), ('city', 'state')) ORDER BY from_col;
----
city	state	0.0	1.0
zip	city	0.0	1.0

query I
SELECT count(*) FROM hierarchy_candidates('fin.geo') WHERE (from_col, to_col) IN (('city', 'zip'), ('state', 'city')) AND g3 = 0;
----
0

statement ok
SELECT detect_hierarchies() FROM fin.geo;

query TTT
SELECT json_extract_string(value, '$.applicable'),
       (SELECT string_agg(json_extract_string(c, '$.kind'), ',') FROM unnest(json_extract(value, '$.candidates')::JSON[]) t(c)
        WHERE json_extract_string(c, '$.from') = 'city' AND json_extract_string(c, '$.to') = 'city_code'),
       (SELECT round(json_extract_string(c, '$.lambda')::DOUBLE, 2) FROM unnest(json_extract(value, '$.candidates')::JSON[]) t(c)
        WHERE json_extract_string(c, '$.from') = 'zip' AND json_extract_string(c, '$.to') = 'flag')
FROM GLOSSARY(fin.geo::hierarchy_candidates);
----
true	alias	0.0

