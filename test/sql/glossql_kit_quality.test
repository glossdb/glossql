statement ok
CREATE TABLE fin.empty AS SELECT 1 AS a, 'x' AS b WHERE false;

query TT
SELECT applicable, reason FROM hierarchy_candidates('fin.empty');
----
false	empty table

statement ok
SELECT detect_hierarchies() FROM fin.empty;

query TTT
SELECT json_extract_string(value, '$.applicable'), json_extract_string(value, '$.reason'), json_type(value, '$.candidates')
FROM GLOSSARY(fin.empty::hierarchy_candidates);
----
false	empty table	NULL

# --- derivation_candidates: a product with two violations, a clean sum

statement ok
CREATE TABLE fin.lines AS
  SELECT (i % 5 + 1)::BIGINT AS units, (10 + i)::DOUBLE AS unit_price,
         ((i % 5 + 1) * (10 + i) * CASE WHEN i < 2 THEN 1.15 ELSE 1 END)::DOUBLE AS line_amount,
         (1000 + 13 * i)::DOUBLE AS net, (77 + 3 * i)::DOUBLE AS tax, (1077 + 16 * i)::DOUBLE AS gross
  FROM range(40) t(i);

query TTII
SELECT target, form, support, violations FROM derivation_candidates('fin.lines') WHERE match_rate >= 0.95 ORDER BY target;
----
gross	sum	40	0
line_amount	product	40	2

statement ok
SELECT detect_derivations() FROM fin.lines;

query TTT
SELECT json_extract_string(value, '$.applicable'),
       (SELECT json_extract_string(c, '$.violations') FROM unnest(json_extract(value, '$.candidates')::JSON[]) t(c) WHERE json_extract_string(c, '$.target') = 'line_amount'),
       (SELECT json_extract_string(c, '$.form') FROM unnest(json_extract(value, '$.candidates')::JSON[]) t(c) WHERE json_extract_string(c, '$.target') = 'gross')
FROM GLOSSARY(fin.lines::derivation_candidates);
----
true	2	sum

# --- grounding_collisions: the same SQL under two names, and the same series from different SQL

query I
SELECT groundings FROM grounding_collisions('fin');
----
0

statement ok
CREATE TABLE fin.ledger AS SELECT * FROM (VALUES (DATE '2024-01-15', 100.0), (DATE '2024-01-20', 200.0), (DATE '2024-02-10', 300.0), (DATE '2024-03-05', 400.0)) t(date, value);

statement ok
DECLARE ASPECT revenue WITH $${"title": "revenue"}$$ AS VIEW;

statement ok
DECLARE ASPECT turnover WITH $${"title": "turnover"}$$ AS VIEW;

statement ok
DECLARE ASPECT open_items WITH $${"title": "open items"}$$ AS VIEW;

statement ok
DECLARE ASPECT costs WITH $${"title": "costs"}$$ AS VIEW;

statement ok
GLOSS revenue ON fin AS $${"sql": "SELECT date AS period, value FROM fin.ledger"}$$;

statement ok
GLOSS turnover ON fin AS $${"sql": "select DATE as period,  value from fin.ledger"}$$;

statement ok
GLOSS open_items ON fin AS $${"sql": "SELECT date AS period, value FROM fin.ledger WHERE value IS NOT NULL"}$$;

statement ok
GLOSS costs ON fin AS $${"sql": "SELECT date AS period, value FROM fin.ledger WHERE value > 250"}$$;

query ITTI
SELECT groundings, kind, aspects::VARCHAR, months FROM grounding_collisions('fin') ORDER BY seq;
----
4	sql	[revenue, turnover]	NULL
4	served_series	[open_items, revenue, turnover]	3

# the series pass reads the view's claims: a view whose columns carry role timestamp and role measure under
# other names folds like one named period and value, and not before the roles are glossed
statement ok
DECLARE ASPECT margin WITH $${"title": "margin"}$$ AS VIEW;

statement ok
GLOSS margin ON fin AS $${"sql": "SELECT date AS day, value AS amount FROM fin.ledger"}$$;

query T
SELECT aspects::VARCHAR FROM grounding_collisions('fin') WHERE kind = 'served_series';
----
[open_items, revenue, turnover]

statement ok
GLOSS role ON margin.day AS $${"value": "timestamp"}$$;

statement ok
GLOSS role ON margin.amount AS $${"value": "measure"}$$;

query T
SELECT aspects::VARCHAR FROM grounding_collisions('fin') WHERE kind = 'served_series';
----
[margin, open_items, revenue, turnover]

# the behavior glossed on the value column folds the month: a stock keeps the month's last level, so open_items
# no longer agrees with the flows
statement ok
GLOSS behavior ON open_items.value AS $${"value": "stock"}$$;

query T
SELECT aspects::VARCHAR FROM grounding_collisions('fin') WHERE kind = 'served_series';
----
[margin, revenue, turnover]

statement ok
SELECT detect_grounding_collisions() FROM fin;

query TT
SELECT json_extract_string(value, '$.applicable'), json_extract_string(value, '$.groundings') FROM GLOSSARY(fin::grounding_collisions);
----
true	5

