# --- rate_tolerance: the validation detector. The expectation is a FACT gloss carrying a
# tolerance, the check a function returning the same aspect with the breach rate it measured

statement ok
DECLARE ASPECT ids_present WITH $${"type": "object", "required": ["outcome"], "properties": {"outcome": {"type": "string"}, "tolerance": {"type": "number"}, "breach_rate": {"type": "number"}}}$$ AS FACT ON TABLE;

statement ok
DECLARE TEST ids_w ON ids_present BY (AGENT, HUMAN) DETECTOR rate_tolerance THRESHOLD 0.0;

statement ok
GLOSS ids_present ON orders AS $${"outcome": "every order names a customer", "tolerance": 0.2}$$;

# no check has spoken: yellow, never green
query TTR
SELECT subject, band, score FROM TESTS(orders::ids_present);
----
fin.orders	yellow	0.0

statement ok
DECLARE FUNCTION ids_present_check FOR fin AS $$
  SELECT 'measured: orders whose customer is unknown' AS outcome,
         count(*) FILTER (WHERE c.id IS NULL) / count(*)::DOUBLE AS breach_rate
  FROM orders o LEFT JOIN customers c ON c.id = o.customer_id
$$ RETURNS ids_present;

statement ok
SELECT ids_present_check() FROM orders;

# one order in five names no customer: at the tolerance, green, the rate as the score
query TTR
SELECT subject, band, score FROM TESTS(orders::ids_present);
----
fin.orders	green	0.2

# the human's tolerance outranks the agent's: tightened, the same rate is red
statement ok
SET VARIABLE glossql_actor = 'human';

statement ok
GLOSS ids_present ON orders AS $${"outcome": "every order names a customer", "tolerance": 0.1}$$;

statement ok
RESET VARIABLE glossql_actor;

query TTR
SELECT subject, band, score FROM TESTS(orders::ids_present);
----
fin.orders	red	0.2

# --- behavior_evidence: the stock/flow evidence over declared edges; a level an event table's movements reconcile reads stock, a sum of them flow

statement ok
DECLARE DATASET beh SET (purpose: 'behavior');

statement ok
USE beh;

statement ok
CREATE TABLE beh.accounts AS SELECT * FROM (VALUES (1, 'cash', 10), (2, 'bank', 20), (3, 'card', 30)) t(id, name, rating);

# signed daily postings per account over six months
statement ok
CREATE TABLE beh.postings AS
  SELECT row_number() OVER () AS posting_id, a.id AS account_id, d::DATE AS posted, ((dayofyear(d) * a.id) % 7 - 3)::DOUBLE AS amount
  FROM generate_series(DATE '2024-01-01', DATE '2024-06-30', INTERVAL 1 DAY) g(d), beh.accounts a;

# month-end levels: an opening balance plus the postings to date; and the postings' monthly sums
statement ok
CREATE TABLE beh.balances AS
  SELECT account_id, last_day(date_trunc('month', posted))::DATE AS as_of,
         100.0 * account_id + sum(sum(amount)) OVER (PARTITION BY account_id ORDER BY date_trunc('month', posted)) AS balance
  FROM beh.postings GROUP BY account_id, date_trunc('month', posted);

statement ok
CREATE TABLE beh.totals AS SELECT account_id, date_trunc('month', posted)::DATE AS month, sum(amount) AS total FROM beh.postings GROUP BY ALL;

# no declared edge: nothing aligns, and the screen says why
query TT
SELECT applicable, reason FROM behavior_anchors('beh.balances.balance');
----
false	no declared relationships connect balances to an event table with a time axis

statement ok
DECLARE RELATIONSHIP postings.account_id -> accounts.id;

statement ok
DECLARE RELATIONSHIP balances.account_id -> accounts.id;

# a measurement over the edges, then a third edge declared: the record it read moved, and the repeat computes
statement ok
SELECT relationship_coherence() FROM beh;

statement ok
DECLARE RELATIONSHIP totals.account_id -> accounts.id;

statement ok
SELECT relationship_coherence() FROM beh;

query TI
SELECT json_extract_string(value, '$.relationships[2].relationship'),
       (SELECT count(*) FROM main.measurements WHERE function = 'relationship_coherence' AND dataset = 'beh')
FROM GLOSSARY(beh::relationship_coherence);
----
beh.totals.account_id -> beh.accounts.id	2

# no role glossed on the event tables: every anchor abstains and names the gloss to make
query TT
SELECT DISTINCT verdict, reason FROM behavior_anchors('beh.balances.balance') ORDER BY reason;
----
abstain	no role glossed on postings: gloss role on its columns
abstain	no role glossed on totals: gloss role on its columns

# the abstention is a measurement row: it names the roles it read, and the roles glossed below make the repeat compute
statement ok
SELECT behavior_evidence() FROM balances.balance;

query TT
SELECT json_extract_string(g.value, '$.summary.verdict'), m.reads
FROM GLOSSARY(beh.balances.balance::behavior_evidence) g, main.measurements m
WHERE m.subject = 'beh.balances.balance';
----
abstain	beh.accounts,beh.balances,beh.postings,beh.totals,main.glossary,main.relationships

statement ok
GLOSS role ON postings.amount AS $${"value": "measure"}$$;

statement ok
GLOSS role ON totals.total AS $${"value": "measure"}$$;

statement ok
GLOSS role ON balances.balance AS $${"value": "measure"}$$;

# the edges meet at the account. At the month, the coarser of the two sides' native grains, each account's postings sum
# to the balance's change: stock, r_stock 0; at the day only the month-end days align and nothing fits. The monotone
# reading abstains, since signed postings move the level both ways. The movements are the glossed measures; posting_id
# is an identifier, served as one
query ITTTTTIRRRT
SELECT seq, event, grain, scope, verdict, convention, voted, round(support, 4), round(r_flow, 2), r_stock, reason FROM behavior_anchors('beh.balances.balance') ORDER BY seq;
----
0	postings	day	none	abstain	NULL	NULL	NULL	NULL	NULL	no entity series reconciled: wrong anchor, short series, or dead values
1	postings	day	year	abstain	NULL	NULL	NULL	NULL	NULL	no entity series reconciled: wrong anchor, short series, or dead values
2	postings	month	none	stock	amount	3	0.4385	129.36	0.0	NULL
3	postings	month	year	stock	amount	3	0.4385	129.36	0.0	NULL
4	postings	day	none	abstain	monotone	3	0.0	NULL	NULL	3 of 3 moving entities decrease within the scope over 15 steps: not a cumulative here
5	postings	day	year	abstain	monotone	3	0.0	NULL	NULL	3 of 3 moving entities decrease within the scope over 15 steps: not a cumulative here
6	totals	month	none	stock	total	3	0.4385	129.36	0.0	NULL
7	totals	month	year	stock	total	3	0.4385	129.36	0.0	NULL
8	totals	day	none	abstain	monotone	3	0.0	NULL	NULL	3 of 3 moving entities decrease within the scope over 15 steps: not a cumulative here
9	totals	day	year	abstain	monotone	3	0.0	NULL	NULL	3 of 3 moving entities decrease within the scope over 15 steps: not a cumulative here

query TTIII
SELECT identifier_columns::VARCHAR, align, entities, viable_entities, sign_primary FROM behavior_anchors('beh.balances.balance') WHERE seq = 2;
----
[account_id, posting_id]	balances.account_id = postings.account_id	3	3	3

# the measurement: the election's summary, the anchors read back whole; the second row on the subject
statement ok
SELECT behavior_evidence() FROM balances.balance;

query TTTTTTI
SELECT json_extract_string(value, '$.summary.verdict'), json_extract_string(value, '$.summary.convention'), json_extract_string(value, '$.summary.event'),
       json_extract_string(value, '$.summary.grain'), json_extract_string(value, '$.summary.tiebreak'),
       json_extract_string(value, '$.anchors_n') || '/' || json_extract_string(value, '$.decided') || '/' || json_array_length(value, '$.anchors'),
       (SELECT count(*) FROM main.measurements WHERE subject = 'beh.balances.balance')
FROM GLOSSARY(beh.balances.balance::behavior_evidence);
----
stock	amount	postings	month	event-name	10/4/10	2

# the monthly sums match the postings' movement as they stand: flow
statement ok
SELECT behavior_evidence() FROM totals.total;

query TTTT
SELECT json_extract_string(value, '$.summary.verdict'), json_extract_string(value, '$.summary.convention'),
       json_extract_string(value, '$.summary.r_flow'), json_extract_string(value, '$.summary.sign.primary')
FROM GLOSSARY(beh.totals.total::behavior_evidence);
----
flow	amount	0.0	3

# no number, no time axis: examined, nothing to say
query TT
SELECT applicable, reason FROM behavior_anchors('beh.accounts.name');
----
false	beh.accounts.name is VARCHAR, not a number: the evidence reads a numeric measure

statement ok
SELECT behavior_evidence() FROM accounts.rating;

query TT
SELECT json_extract_string(value, '$.applicable'), json_extract_string(value, '$.reason') FROM GLOSSARY(beh.accounts.rating::behavior_evidence);
----
false	no period axis: no date column on accounts or one declared hop away

# an identifier is no measure: a leg of a declared relationship at bind, a key-shaped integer by its distinct share
query TT
SELECT applicable, reason FROM behavior_anchors('beh.postings.account_id');
----
false	beh.postings.account_id is a leg of a declared relationship: an identifier, no measure

query TT
SELECT applicable, reason FROM behavior_anchors('beh.postings.posting_id');
----
false	beh.postings.posting_id is key-shaped: 546 distinct values in 546 filled rows, an identifier, no measure; gloss role key

# the refusal is a measurement row keyed to the table it counted: rows appended, the repeat computes with the counts now
statement ok
SELECT behavior_evidence() FROM postings.posting_id;

statement ok
INSERT INTO beh.postings SELECT 546 + i, 1, DATE '2024-07-01' + (i % 30)::INTEGER, 1.0 FROM range(1, 201) t(i);

query TTTTT
SELECT behavior_evidence() FROM postings.posting_id;
----
behavior_evidence	beh.postings.posting_id	behavior_evidence	{"applicable":false,"reason":"beh.postings.posting_id is key-shaped: 746 distinct values in 746 filled rows, an identifier, no measure; gloss role key","anchors_n":null,"decided":null,"summary":null,"anchors":null}	true

query T
SELECT reads FROM main.measurements WHERE subject = 'beh.postings.posting_id' ORDER BY seq;
----
beh.accounts,beh.balances,beh.postings,beh.totals,main.relationships
beh.accounts,beh.balances,beh.postings,beh.totals,main.relationships

# --- the other alignment shapes, one dataset each: the same signed postings and month-end levels, keyed differently

# a direct edge between the event table and the measure table, no dimension table between them
statement ok
DECLARE DATASET direct SET (purpose: 'shape');

statement ok
USE direct;

statement ok
CREATE TABLE direct.postings AS
  SELECT row_number() OVER () AS posting_id, a AS account_id, d::DATE AS posted, ((dayofyear(d) * a) % 7 - 3)::DOUBLE AS amount
  FROM generate_series(DATE '2024-01-01', DATE '2024-06-30', INTERVAL 1 DAY) g(d), range(1, 4) t(a);

statement ok
CREATE TABLE direct.balances AS
  SELECT account_id, last_day(date_trunc('month', posted))::DATE AS as_of,
         100.0 * account_id + sum(sum(amount)) OVER (PARTITION BY account_id ORDER BY date_trunc('month', posted)) AS balance
  FROM direct.postings GROUP BY account_id, date_trunc('month', posted);

statement ok
DECLARE RELATIONSHIP postings.account_id -> balances.account_id;

# no role, then a role that is no measure, then the measure: the abstention names the act each time
query TT
SELECT DISTINCT verdict, reason FROM behavior_anchors('direct.balances.balance');
----
abstain	no role glossed on postings: gloss role on its columns

statement ok
GLOSS role ON postings.amount AS $${"value": "attribute"}$$;

query TT
SELECT DISTINCT verdict, reason FROM behavior_anchors('direct.balances.balance');
----
abstain	no measure among postings's roles: gloss role measure on its movement columns

statement ok
GLOSS role ON postings.amount AS $${"value": "measure"}$$;

query TTTTTT
SELECT align, grain, scope, verdict, convention, identifier_columns::VARCHAR FROM behavior_anchors('direct.balances.balance') WHERE verdict <> 'abstain' ORDER BY seq;
----
balances.account_id = postings.account_id	month	none	stock	amount	[account_id, posting_id]
balances.account_id = postings.account_id	month	year	stock	amount	[account_id, posting_id]

# the measure side borrows its entity through a document: the levels are per invoice, the invoice names the customer,
# and the payments key on the customer; a measure table whose every edge lands on a document keys on the document's dimension
statement ok
DECLARE DATASET viadoc SET (purpose: 'shape');

statement ok
USE viadoc;

statement ok
CREATE TABLE viadoc.customers AS SELECT i AS id, 'c' || i AS name FROM range(1, 4) t(i);

statement ok
CREATE TABLE viadoc.invoices AS SELECT i AS invoice_id, i AS customer_id, DATE '2023-12-31' AS issued FROM range(1, 4) t(i);

statement ok
CREATE TABLE viadoc.payments AS
  SELECT row_number() OVER () AS payment_id, c AS customer_id, d::DATE AS paid, ((dayofyear(d) * c) % 7 - 3)::DOUBLE AS amount
  FROM generate_series(DATE '2024-01-01', DATE '2024-06-30', INTERVAL 1 DAY) g(d), range(1, 4) t(c);

statement ok
CREATE TABLE viadoc.received AS
  SELECT customer_id AS invoice_id, last_day(date_trunc('month', paid))::DATE AS as_of,
         100.0 * customer_id + sum(sum(amount)) OVER (PARTITION BY customer_id ORDER BY date_trunc('month', paid)) AS received_to_date
  FROM viadoc.payments GROUP BY customer_id, date_trunc('month', paid);

# a table with no date column of its own: its axis is borrowed one hop away
statement ok
CREATE TABLE viadoc.lines AS SELECT i AS line_id, i AS invoice_id, 10.0 * i AS amount FROM range(1, 4) t(i);

statement ok
DECLARE RELATIONSHIP received.invoice_id -> invoices.invoice_id;

statement ok
DECLARE RELATIONSHIP lines.invoice_id -> invoices.invoice_id;

statement ok
DECLARE RELATIONSHIP invoices.customer_id -> customers.id;

statement ok
DECLARE RELATIONSHIP payments.customer_id -> customers.id;

statement ok
GLOSS role ON payments.amount AS $${"value": "measure"}$$;

statement ok
GLOSS role ON received.received_to_date AS $${"value": "measure"}$$;

query TTTTTT
SELECT align, grain, scope, verdict, convention, identifier_columns::VARCHAR FROM behavior_anchors('viadoc.received.received_to_date') WHERE verdict <> 'abstain' ORDER BY seq;
----
received via invoices.customer_id = payments.customer_id	month	none	stock	amount	[customer_id, payment_id]
received via invoices.customer_id = payments.customer_id	month	year	stock	amount	[customer_id, payment_id]

# the borrowed axis names the hop, on both alignments the lines have: meeting received at the invoice, and the
# customer borrowed through the invoice; one issue date per invoice is one period, so every anchor abstains on viability
query TTT
SELECT DISTINCT side, axis, align FROM glossql_behavior_cells('viadoc.lines.amount') WHERE side = 'measure' ORDER BY align;
----
measure	invoices.issued via invoice_id	invoice_id
measure	invoices.issued via invoice_id	invoices>customer_id

query TTI
SELECT measure_time, reason, viable_entities FROM behavior_anchors('viadoc.lines.amount') WHERE convention IS NULL ORDER BY seq LIMIT 1;
----
invoices.issued via invoice_id	fewer than two entities carry 4+ periods on this alignment	0

# the event side keys through its master: payment lines name the payment, the payment names the customer,
# and the measure keys on the customer directly; an event table that aligns no other way borrows through its document
statement ok
DECLARE DATASET viamaster SET (purpose: 'shape');

statement ok
USE viamaster;

statement ok
CREATE TABLE viamaster.customers AS SELECT i AS id, 'c' || i AS name FROM range(1, 4) t(i);

statement ok
CREATE TABLE viamaster.payments AS
  SELECT row_number() OVER () AS payment_id, c AS customer_id, d::DATE AS paid
  FROM generate_series(DATE '2024-01-01', DATE '2024-06-30', INTERVAL 1 DAY) g(d), range(1, 4) t(c);

statement ok
CREATE TABLE viamaster.payment_lines AS
  SELECT payment_id AS line_id, payment_id, paid AS booked, ((dayofyear(paid) * customer_id) % 7 - 3)::DOUBLE AS amount FROM viamaster.payments;

statement ok
CREATE TABLE viamaster.balances AS
  SELECT p.customer_id, last_day(date_trunc('month', l.booked))::DATE AS as_of,
         100.0 * p.customer_id + sum(sum(l.amount)) OVER (PARTITION BY p.customer_id ORDER BY date_trunc('month', l.booked)) AS balance
  FROM viamaster.payment_lines l JOIN viamaster.payments p USING (payment_id) GROUP BY p.customer_id, date_trunc('month', l.booked);

statement ok
DECLARE RELATIONSHIP payment_lines.payment_id -> payments.payment_id;

statement ok
DECLARE RELATIONSHIP payments.customer_id -> customers.id;

statement ok
DECLARE RELATIONSHIP balances.customer_id -> customers.id;

statement ok
GLOSS role ON payment_lines.amount AS $${"value": "measure"}$$;

query TTTTTT
SELECT align, grain, scope, verdict, convention, identifier_columns::VARCHAR FROM behavior_anchors('viamaster.balances.balance') WHERE verdict <> 'abstain' ORDER BY seq;
----
balances.customer_id = payment_lines via payments.customer_id	month	none	stock	amount	[line_id, payment_id]
balances.customer_id = payment_lines via payments.customer_id	month	year	stock	amount	[line_id, payment_id]

