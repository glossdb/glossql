# name: test/sql/glossql_tests.test
# description: a test's result is stored per subject and test, computed by SELECT <test>() FROM <subject>; GLOSSARY() discloses every gap, TESTS() every stored result
# group: [sql]

require glossql

require json

require parquet

require ducklake

statement ok
ATTACH 'ducklake::memory:' AS ws (DATA_PATH '{TEST_DIR}/glossql_tests_lake/');

statement ok
USE ws;

statement ok
PRAGMA glossql;

statement ok
DECLARE DATASET fin SET (purpose: 'tests');

statement ok
USE fin;

statement ok
CREATE TABLE fin.orders AS SELECT i AS id, i * 1.5 AS amount FROM range(4) t(i);

statement ok
DECLARE ASPECT additivity WITH $${"type": "object", "properties": {"value": {"enum": ["semi-additive", "additive"]}}}$$ AS FACT ON COLUMN;

# a detector is a function without RETURNS: one (subject, state, score) row per subject over its test's values
statement ok
DECLARE FUNCTION additivity_entropy FOR fin AS $$
  SELECT subject,
         CASE WHEN count(DISTINCT body->>'value') > 1 THEN 'red' ELSE 'green' END AS state,
         CASE WHEN count(DISTINCT body->>'value') > 1 THEN 1.0 ELSE 0.0 END AS score
  FROM annotations WHERE actor_kind IN ('agent', 'human') GROUP BY subject
$$;

statement ok
DECLARE TEST additivity_test ON additivity BY (AGENT, HUMAN) DETECTOR additivity_entropy THRESHOLD 0.7;

# an unchanged re-declaration is a no-op
statement ok
DECLARE TEST additivity_test ON additivity BY (AGENT, HUMAN) DETECTOR additivity_entropy THRESHOLD 0.7;

query TTTTR
SELECT name, aspect, actors, detector, threshold FROM tests;
----
additivity_test	additivity	[AGENT, HUMAN]	additivity_entropy	0.7

# --- what a test refuses

statement error
DECLARE TEST w2 ON nothing BY (AGENT);
----
Invalid Input Error

statement error
DECLARE TEST w3 ON additivity;
----
Parser Error

statement error
DECLARE TEST w4 ON additivity THRESHOLD 2;
----
Parser Error

statement ok
DECLARE ASPECT min_max WITH $${"type": "object"}$$ AS MEASUREMENT ON COLUMN;

statement error
DECLARE TEST w5 ON min_max BY (AGENT);
----
Invalid Input Error

statement ok
DECLARE FUNCTION min_max FOR GLOBAL AS $$ SELECT min(v) AS min, max(v) AS max FROM subject_column($subject) $$ RETURNS min_max;

statement error
DECLARE TEST w6 ON additivity DETECTOR min_max;
----
Invalid Input Error

statement error
DECLARE TEST w7 ON additivity DETECTOR nothing;
----
Invalid Input Error

# --- before anybody annotated: missing, every gap visible (SPEC §5.3)

query TTTTTT
SELECT subject, aspect, value, test_state, score, state FROM GLOSSARY(orders);
----
fin.orders.amount	additivity	NULL	NULL	NULL	missing
fin.orders.id	additivity	NULL	NULL	NULL	missing

query I
SELECT count(*) FROM TESTS();
----
0

# --- one annotation: current, judged green once the test computed its result

statement ok
GLOSS additivity ON orders.amount AS $${"value": "additive"}$$;

# a test's result is computed by its statement, not at read: nothing is judged yet
query TTTTTT
SELECT subject, aspect, value, test_state, score, state FROM GLOSSARY(orders);
----
fin.orders.amount	additivity	{"value": "additive"}	NULL	NULL	current
fin.orders.id	additivity	NULL	NULL	NULL	missing

# the test over the dataset judges each subject that holds a value, one row each
query TTTTT
SELECT additivity_test() FROM fin;
----
additivity_test	fin.orders.amount	additivity	{"state":"green","score":0.0}	true

# stored per subject and test, with the nodes it read
query TTTT
SELECT function, subject, aspect, value FROM measurements WHERE function = 'additivity_test';
----
additivity_test	fin.orders.amount	test	{"state":"green","score":0.0}

query T
SELECT string_agg(i.asset || ' ' || i.what, ',' ORDER BY i.asset, i.what) FROM measurements m JOIN inputs i ON i.result = m.id
WHERE m.function = 'additivity_test';
----
additivity property,additivity_entropy function,fin.orders.amount annotation additivity,fin.orders.amount definition,fin.orders.amount value additivity

# the stored result serves while it is current: nothing is computed again
query TTTTT
SELECT additivity_test() FROM fin;
----
additivity_test	fin.orders.amount	additivity	{"state":"green","score":0.0}	false

query TTTTTT
SELECT subject, aspect, value, test_state, score, state FROM GLOSSARY(orders);
----
fin.orders.amount	additivity	{"value": "additive"}	green	0.0	current
fin.orders.id	additivity	NULL	NULL	NULL	missing

# --- two annotations disagree: conflict, the value withheld, the result says how badly

statement ok
SET VARIABLE glossql_actor = 'human';

statement ok
GLOSS additivity ON orders.amount AS $${"value": "semi-additive"}$$;

statement ok
RESET VARIABLE glossql_actor;

# the stored result read the annotation that moved: it is out of date until the test computes it again,
# and its state is served marked
query TTTT
SELECT subject, test, state, current FROM TESTS(orders.amount::additivity);
----
fin.orders.amount	additivity_test	green	false

query TTTTTT
SELECT dataset, function, subject, asset, what, reason FROM glossql_outdated() WHERE function = 'additivity_test';
----
fin	additivity_test	fin.orders.amount	fin.orders.amount	annotation additivity	changed

# a narrowed statement computes the subjects under its subject alone
query TTTTT
SELECT additivity_test() FROM orders.amount;
----
additivity_test	fin.orders.amount	additivity	{"state":"red","score":1.0}	true

query TTTTT
SELECT subject, aspect, value, test_state, state FROM GLOSSARY(orders.amount);
----
fin.orders.amount	additivity	NULL	red	conflict

query TTTTR
SELECT subject, aspect, test, state, score FROM TESTS(orders.amount::additivity);
----
fin.orders.amount	additivity	additivity_test	red	1.0

query TTTTT
SELECT subject, aspect, test, state, current FROM TESTS() WHERE state = 'red';
----
fin.orders.amount	additivity	additivity_test	red	true

# a subject is a name, not a string: the quoted form is refused by its code, for both reads, with or without the
# aspect and the all flag, and not looked up as a table function of the read's name
statement error
SELECT * FROM TESTS('orders.amount');
----
quoted_subject

statement error
SELECT * FROM TESTS('orders.amount'::additivity);
----
quoted_subject

statement error
SELECT * FROM GLOSSARY('orders.amount');
----
quoted_subject

statement error
SELECT * FROM GLOSSARY('orders.amount', all => true) g;
----
quoted_subject

# the double-quoted name is an identifier, and reads as the bare one
query I
SELECT count(*) FROM TESTS("orders".amount::additivity);
----
1

# the raw read shows every value with its aspect's kind and its test
query TTTTT
SELECT subject, aspect, kind, test, actor FROM GLOSSARY(orders.amount, all => true) ORDER BY actor;
----
fin.orders.amount	additivity	FACT	additivity_test	agent
fin.orders.amount	additivity	FACT	additivity_test	human

# --- the human re-glosses to agree: the human's value is superseded, current again

statement ok
SET VARIABLE glossql_actor = 'human';

statement ok
GLOSS additivity ON orders.amount AS $${"value": "additive"}$$;

statement ok
RESET VARIABLE glossql_actor;

statement ok
SELECT additivity_test() FROM fin;

query TTTT
SELECT subject, value, test_state, state FROM GLOSSARY(orders.amount);
----
fin.orders.amount	{"value": "additive"}	green	current

# --- function annotations arrive through RETURNS: extraction stores a measurement, served beside the glosses

query TTTTT
SELECT min_max() FROM orders.amount;
----
min_max	fin.orders.amount	min_max	{"min":0.0,"max":4.5}	true

query TTT
SELECT subject, actor, body FROM GLOSSARY(orders.amount::min_max, all => true);
----
fin.orders.amount	function	{"min":0.0,"max":4.5}

query TTT
SELECT subject, aspect, value FROM GLOSSARY(orders.amount::min_max);
----
fin.orders.amount	min_max	{"min":0.0,"max":4.5}

# a measurement is never glossed
statement error
GLOSS min_max ON orders.amount AS $${"min": 0}$$;
----
Invalid Input Error

statement error
GLOSS nothing ON orders.amount AS $${}$$;
----
Invalid Input Error

# --- BY gates the actors

statement ok
DECLARE ASPECT note WITH $${"type": "object"}$$ AS FACT ON TABLE;

statement ok
DECLARE TEST note_test ON note BY (HUMAN);

statement error
GLOSS note ON orders AS $${"value": "x"}$$;
----
Invalid Input Error

statement ok
SET VARIABLE glossql_actor = 'human';

statement ok
GLOSS note ON orders AS $${"value": "x"}$$;

statement ok
RESET VARIABLE glossql_actor;

# a test without a detector judges nothing: the value serves as current, and its statement stores no result
query TTTTT
SELECT subject, aspect, value, test_state, state FROM GLOSSARY(orders::note);
----
fin.orders	note	{"value": "x"}	NULL	current

statement error
SELECT note_test() FROM fin;
----
no_detector

# --- a detector that cannot answer is the result `error` (SPEC §7.2): one row per subject holding values, score 0, the failure text

statement ok
DECLARE ASPECT role WITH $${"type": "object"}$$ AS FACT ON COLUMN;

statement ok
DECLARE FUNCTION broken FOR fin AS $$ SELECT subject, no_such_column AS state, 0.0 AS score FROM annotations $$;

statement ok
DECLARE TEST role_test ON role DETECTOR broken;

statement ok
GLOSS role ON orders.id AS $${"value": "key"}$$;

# a detector that fails stores its failure as each subject's result: the statement does not fail
statement ok
SELECT role_test() FROM fin;

# a plan the engine refuses
query TTTR
SELECT test, state, error, score FROM TESTS(orders.id::role);
----
role_test	error	Binder Error: Referenced column "no_such_column" not found in FROM clause!	0.0

# an error is not a judgment: the collapse serves the value, never withholds on it
query TTTT
SELECT subject, value, test_state, state FROM GLOSSARY(orders.id::role);
----
fin.orders.id	{"value": "key"}	error	current

# every other test still returns its result
query TTTT
SELECT subject, test, state, error FROM TESTS(orders);
----
fin.orders.amount	additivity_test	green	NULL
fin.orders.id	role_test	error	Binder Error: Referenced column "no_such_column" not found in FROM clause!

# a run the engine refuses
statement ok
DECLARE FUNCTION broken FOR fin AS $$ SELECT subject, error('boom') AS state, 0.0 AS score FROM annotations $$;

# the detector declared again puts the result out of date
statement ok
SELECT role_test() FROM fin;

query TT
SELECT state, error FROM TESTS(orders.id::role);
----
error	Invalid Input Error: boom

# a row outside the test-results schema
statement ok
DECLARE FUNCTION broken FOR fin AS $$ SELECT subject, 'blue' AS state, 0.0 AS score FROM annotations $$;

statement ok
SELECT role_test() FROM fin;

query TT
SELECT state, (error) IS NOT NULL FROM TESTS(orders.id::role);
----
error	true

# no row where nobody annotated: the error is served on subjects holding values
query I
SELECT count(*) FROM TESTS(orders.amount::role);
----
0

# --- a source is a workspace row (SPEC §5.1): its subject is the bare declared name, every dataset's sweep owes and serves it, and a gloss from any dataset supersedes

statement ok
DECLARE SOURCE erp SET (type: csv, location: '{TEST_DIR}');

statement ok
DECLARE ASPECT conventions WITH $${"type": "object"}$$ AS FACT ON SOURCE;

statement ok
DECLARE TEST conventions_test ON conventions BY (AGENT, HUMAN);

# required in the dataset's sweep, as the bare name; a narrowed read keeps to its subject
query TTT
SELECT subject, aspect, state FROM GLOSSARY() WHERE aspect = 'conventions';
----
erp	conventions	missing

query I
SELECT count(*) FROM GLOSSARY(orders) WHERE aspect = 'conventions';
----
0

query TT
SELECT subject, state FROM GLOSSARY(erp);
----
erp	missing

# the grain gate: a subject outside the aspect's declared grains is refused, never stored in silence

statement error
GLOSS conventions ON fin AS $${"fiscal_year_start": "04-01"}$$;
----
Invalid Input Error

statement error
GLOSS conventions ON orders AS $${"fiscal_year_start": "04-01"}$$;
----
Invalid Input Error

statement error
GLOSS note ON erp AS $${"value": "x"}$$;
----
Invalid Input Error

statement error
GLOSS role ON orders AS $${"value": "key"}$$;
----
Invalid Input Error

statement ok
GLOSS conventions ON erp AS $${"fiscal_year_start": "04-01"}$$;

# the row records the dataset it was deposited in
query TT
SELECT dataset, subject FROM glossary WHERE aspect = 'conventions';
----
fin	erp

query TTTT
SELECT subject, value, test_state, state FROM GLOSSARY(erp);
----
erp	{"fiscal_year_start": "04-01"}	NULL	current

# the next dataset reads the deposit, and its own gloss supersedes it workspace-wide
statement ok
DECLARE DATASET ops SET (purpose: 'reads the deposit');

statement ok
USE ops;

query TTT
SELECT subject, value, state FROM GLOSSARY() WHERE aspect = 'conventions';
----
erp	{"fiscal_year_start": "04-01"}	current

statement ok
GLOSS conventions ON erp AS $${"fiscal_year_start": "01-01"}$$;

statement ok
USE fin;

query TT
SELECT value, state FROM GLOSSARY(erp::conventions);
----
{"fiscal_year_start": "01-01"}	current

query TTT
SELECT actor, body, current FROM GLOSSARY(erp, all => true);
----
agent	{"fiscal_year_start": "01-01"}	true

# a grainless aspect on a source name stays dataset-scoped: the dataset that wrote it reads it, another does not
statement ok
DECLARE ASPECT remark WITH $${"type": "object"}$$ AS FACT;

statement ok
GLOSS remark ON erp AS $${"text": "fin's"}$$;

query TT
SELECT aspect, state FROM GLOSSARY(erp) ORDER BY aspect;
----
conventions	current
remark	current

statement ok
USE ops;

query TT
SELECT aspect, state FROM GLOSSARY(erp) ORDER BY aspect;
----
conventions	current

statement ok
USE fin;

# --- one annotation scored red is served with its state: a measurement alone never contests itself (SPEC §5.3)

statement ok
DECLARE ASPECT tie_out WITH $${"type": "object", "properties": {"breach_rate": {"type": "number"}, "tolerance": {"type": "number"}}}$$ AS FACT ON TABLE;

statement ok
DECLARE FUNCTION tie_out_check FOR GLOBAL AS $$ SELECT 1.0 AS breach_rate, 'every line against its order' AS outcome $$ RETURNS tie_out;

statement ok
DECLARE FUNCTION rate_red FOR GLOBAL AS $$ SELECT subject, CASE WHEN max(try_cast(body->>'breach_rate' AS DOUBLE)) > $threshold THEN 'red' ELSE 'green' END AS state, coalesce(max(try_cast(body->>'breach_rate' AS DOUBLE)), 0.0) AS score FROM annotations GROUP BY subject $$;

statement ok
DECLARE TEST tie_out_test ON tie_out BY (AGENT, HUMAN) DETECTOR rate_red THRESHOLD 0.0;

statement ok
SELECT tie_out_check() FROM orders;

statement ok
SELECT tie_out_test() FROM fin;

query TTRT
SELECT aspect, test_state, score, state FROM GLOSSARY(orders) WHERE aspect = 'tie_out';
----
tie_out	red	1.0	current

query TR
SELECT state, score FROM TESTS(orders::tie_out);
----
red	1.0

# a second annotation makes it a disagreement: conflict, the value withheld

statement ok
GLOSS tie_out ON orders AS $${"tolerance": 0.0}$$;

statement ok
SELECT tie_out_test() FROM fin;

query TTT
SELECT value, test_state, state FROM GLOSSARY(orders::tie_out);
----
NULL	red	conflict

# --- a measurement that reads another function's results is served while they hold, and computes once that function stores another value (SPEC §6)

statement ok
DECLARE ASPECT tie_out_count WITH $${"type": "object"}$$ AS MEASUREMENT ON TABLE;

statement ok
DECLARE FUNCTION tie_out_count FOR GLOBAL AS $$ SELECT count(value) AS n, max(value->>'breach_rate') AS what FROM results('tie_out_check', 'itself') $$ RETURNS tie_out_count;

query TTTTT
SELECT tie_out_count() FROM orders;
----
tie_out_count	fin.orders	tie_out_count	{"n":1,"what":"1.0"}	true

# the reader read the function it named, not every result: another function's result
# on the same subject leaves it current
statement ok
DECLARE ASPECT order_rows WITH $${"type": "integer"}$$ AS MEASUREMENT ON TABLE;

statement ok
DECLARE FUNCTION order_rows FOR GLOBAL AS $$ SELECT count(*) AS n FROM fin.orders $$ RETURNS order_rows;

statement ok
SELECT order_rows() FROM orders;

query TTTTT
SELECT tie_out_count() FROM orders;
----
tie_out_count	fin.orders	tie_out_count	{"n":1,"what":"1.0"}	false

statement ok
DECLARE FUNCTION tie_out_check FOR GLOBAL AS $$ SELECT 0.5 AS breach_rate, 'every line against its order' AS outcome $$ RETURNS tie_out;

statement ok
SELECT tie_out_check() FROM orders;

query TTTTT
SELECT tie_out_count() FROM orders;
----
tie_out_count	fin.orders	tie_out_count	{"n":1,"what":"0.5"}	true

query TTTTT
SELECT tie_out_count() FROM orders;
----
tie_out_count	fin.orders	tie_out_count	{"n":1,"what":"0.5"}	false

# --- a subject that holds no value any more retires its result

statement ok
DELETE FROM glossary WHERE subject = 'fin.orders.id' AND aspect = 'role';

statement ok
SELECT role_test() FROM fin;

query I
SELECT count(*) FROM measurements WHERE function = 'role_test';
----
0

# --- a detector that compares the subjects it runs over is refused at the test's declaration (SPEC §7.1): the
# result of one subject would read another's values

statement ok
DECLARE ASPECT rank_note WITH $${"type": "object"}$$ AS FACT ON COLUMN;

statement ok
DECLARE FUNCTION rank_share FOR fin AS $$
  SELECT subject, CASE WHEN rank() OVER (ORDER BY count(*) DESC) = 1 THEN 'red' ELSE 'green' END AS state, 0.0 AS score
  FROM annotations GROUP BY subject
$$;

statement error
DECLARE TEST rank_test ON rank_note DETECTOR rank_share;
----
cross_subject

statement ok
DECLARE FUNCTION share_of_all FOR fin AS $$
  SELECT a.subject, 'green' AS state, (SELECT count(*) FROM annotations)::DOUBLE / 100 AS score FROM annotations a
$$;

statement error
DECLARE TEST share_test ON rank_note DETECTOR share_of_all;
----
cross_subject

statement ok
DECLARE FUNCTION pairs FOR fin AS $$
  SELECT a.subject, 'green' AS state, 0.0 AS score FROM annotations a JOIN annotations b ON a.body = b.body
$$;

statement error
DECLARE TEST pair_test ON rank_note DETECTOR pairs;
----
cross_subject

# matched on the subject, a window, a subquery and a join judge each subject alone
statement ok
DECLARE FUNCTION own_rank FOR fin AS $$
  SELECT a.subject, 'green' AS state,
         (SELECT count(*) FROM annotations b WHERE b.subject = a.subject)::DOUBLE / 100 AS score
  FROM (SELECT subject, row_number() OVER (PARTITION BY subject ORDER BY actor_kind) AS n FROM annotations) a
  JOIN annotations c ON c.subject = a.subject WHERE a.n = 1
$$;

statement ok
DECLARE TEST own_test ON rank_note DETECTOR own_rank;
