# name: test/sql/glossql_tests.test
# description: tests adjudicate the slots at read; GLOSSARY() discloses every gap, TESTS() every verdict
# group: [sql]

require glossql

require json

require parquet

require ducklake

statement ok
ATTACH 'ducklake::memory:' AS ws (DATA_PATH '{TEST_DIR}/glossql_tests_lake/');

statement ok
USE ws;

statement ok
PRAGMA glossql;

statement ok
DECLARE DATASET fin SET (purpose: 'tests');

statement ok
USE fin;

statement ok
CREATE TABLE fin.orders AS SELECT i AS id, i * 1.5 AS amount FROM range(4) t(i);

statement ok
DECLARE ASPECT additivity WITH $${"type": "object", "properties": {"value": {"enum": ["semi-additive", "additive"]}}}$$ AS FACT ON COLUMN;

# a detector is a function without RETURNS: one (subject, band, score) row per subject over its test's slots
statement ok
DECLARE FUNCTION additivity_entropy FOR fin AS $$
  SELECT subject,
         CASE WHEN count(DISTINCT body->>'value') > 1 THEN 'red' ELSE 'green' END AS band,
         CASE WHEN count(DISTINCT body->>'value') > 1 THEN 1.0 ELSE 0.0 END AS score
  FROM slots WHERE speaker IN ('agent', 'human') GROUP BY subject
$$;

statement ok
DECLARE TEST additivity_test ON additivity BY (AGENT, HUMAN) DETECTOR additivity_entropy THRESHOLD 0.7;

# an unchanged re-declaration is a no-op
query T
DECLARE TEST additivity_test ON additivity BY (AGENT, HUMAN) DETECTOR additivity_entropy THRESHOLD 0.7;
----
test additivity_test unchanged: no-op

query TTTTR
SELECT name, aspect, actors, detector, threshold FROM tests;
----
additivity_test	additivity	[AGENT, HUMAN]	additivity_entropy	0.7

# --- what a test refuses

statement error
DECLARE TEST w2 ON nothing BY (AGENT);
----
aspect 'nothing' is not declared

statement error
DECLARE TEST w3 ON additivity;
----
names BY or DETECTOR

statement error
DECLARE TEST w4 ON additivity THRESHOLD 2;
----
THRESHOLD is in 0..1

statement ok
DECLARE ASPECT min_max WITH $${"type": "object"}$$ AS MEASUREMENT ON COLUMN;

statement error
DECLARE TEST w5 ON min_max BY (AGENT);
----
BY is refused on a MEASUREMENT aspect

statement ok
DECLARE FUNCTION min_max FOR GLOBAL AS $$ SELECT min(v) AS min, max(v) AS max FROM subject_column($subject) $$ RETURNS min_max;

statement error
DECLARE TEST w6 ON additivity DETECTOR min_max;
----
a measurement, not a detector

statement error
DECLARE TEST w7 ON additivity DETECTOR nothing;
----
detector 'nothing' is not a declared function

# --- before anybody spoke: missing, every gap visible (SPEC §5.3)

query TTTTTT
SELECT subject, aspect, value, band, score, state FROM GLOSSARY(orders);
----
fin.orders.amount	additivity	NULL	NULL	NULL	missing
fin.orders.id	additivity	NULL	NULL	NULL	missing

query I
SELECT count(*) FROM TESTS();
----
0

# --- one voice: current, judged green

statement ok
GLOSS additivity ON orders.amount AS $${"value": "additive"}$$;

query TTTTTT
SELECT subject, aspect, value, band, score, state FROM GLOSSARY(orders);
----
fin.orders.amount	additivity	{"value": "additive"}	green	0.0	current
fin.orders.id	additivity	NULL	NULL	NULL	missing

# --- two voices disagree: conflict, the value withheld, the verdict says how badly

statement ok
SET VARIABLE glossql_actor = 'human';

statement ok
GLOSS additivity ON orders.amount AS $${"value": "semi-additive"}$$;

statement ok
RESET VARIABLE glossql_actor;

query TTTTT
SELECT subject, aspect, value, band, state FROM GLOSSARY(orders.amount);
----
fin.orders.amount	additivity	NULL	red	conflict

query TTTTR
SELECT subject, aspect, test, band, score FROM TESTS(orders.amount::additivity);
----
fin.orders.amount	additivity	additivity_test	red	1.0

query TTTTT
SELECT subject, aspect, test, band, current FROM TESTS() WHERE band = 'red';
----
fin.orders.amount	additivity	additivity_test	red	true

# the raw read shows every slot with its aspect's kind and its test
query TTTTT
SELECT subject, aspect, kind, test, actor FROM GLOSSARY(orders.amount, all => true) ORDER BY actor;
----
fin.orders.amount	additivity	FACT	additivity_test	agent
fin.orders.amount	additivity	FACT	additivity_test	human

# --- the human re-glosses to agree: the human slot is superseded, current again

statement ok
SET VARIABLE glossql_actor = 'human';

statement ok
GLOSS additivity ON orders.amount AS $${"value": "additive"}$$;

statement ok
RESET VARIABLE glossql_actor;

query TTTT
SELECT subject, value, band, state FROM GLOSSARY(orders.amount);
----
fin.orders.amount	{"value": "additive"}	green	current

# --- function voices arrive through RETURNS: extraction lands a measurement, served beside the glosses

query TTTTT
SELECT min_max() FROM orders.amount;
----
min_max	fin.orders.amount	min_max	{"min":0.0,"max":4.5}	true

query TTT
SELECT subject, actor, body FROM GLOSSARY(orders.amount::min_max, all => true);
----
fin.orders.amount	function	{"min":0.0,"max":4.5}

query TTT
SELECT subject, aspect, value FROM GLOSSARY(orders.amount::min_max);
----
fin.orders.amount	min_max	{"min":0.0,"max":4.5}

# a measurement is never glossed
statement error
GLOSS min_max ON orders.amount AS $${"min": 0}$$;
----
never glossed

statement error
GLOSS nothing ON orders.amount AS $${}$$;
----
aspect 'nothing' is not declared

# --- BY gates the actors

statement ok
DECLARE ASPECT note WITH $${"type": "object"}$$ AS FACT ON TABLE;

statement ok
DECLARE TEST note_test ON note BY (HUMAN);

statement error
GLOSS note ON orders AS $${"value": "x"}$$;
----
admits HUMAN, not agent

statement ok
SET VARIABLE glossql_actor = 'human';

statement ok
GLOSS note ON orders AS $${"value": "x"}$$;

statement ok
RESET VARIABLE glossql_actor;

# a test without a detector judges nothing: the slot serves as current
query TTTTT
SELECT subject, aspect, value, band, state FROM GLOSSARY(orders::note);
----
fin.orders	note	{"value": "x"}	NULL	current

# --- a detector that cannot answer is the verdict `error` (SPEC §7.2): one row per subject holding slots, score 0, the failure text

statement ok
DECLARE ASPECT role WITH $${"type": "object"}$$ AS FACT ON COLUMN;

statement ok
DECLARE FUNCTION broken FOR fin AS $$ SELECT subject, no_such_column AS band, 0.0 AS score FROM slots $$;

statement ok
DECLARE TEST role_test ON role DETECTOR broken;

statement ok
GLOSS role ON orders.id AS $${"value": "key"}$$;

# a plan the engine refuses
query TTTR
SELECT test, band, error, score FROM TESTS(orders.id::role);
----
role_test	error	Binder Error: Referenced column "no_such_column" not found in FROM clause!	0.0

# an error is not a judgment: the collapse serves the value, never withholds on it
query TTTT
SELECT subject, value, band, state FROM GLOSSARY(orders.id::role);
----
fin.orders.id	{"value": "key"}	error	current

# every other test still speaks
query TTTT
SELECT subject, test, band, error FROM TESTS(orders);
----
fin.orders.amount	additivity_test	green	NULL
fin.orders.id	role_test	error	Binder Error: Referenced column "no_such_column" not found in FROM clause!

# a run the engine refuses
statement ok
DECLARE FUNCTION broken FOR fin AS $$ SELECT subject, error('boom') AS band, 0.0 AS score FROM slots $$;

query TT
SELECT band, error FROM TESTS(orders.id::role);
----
error	Invalid Input Error: boom

# a row outside the test-results schema
statement ok
DECLARE FUNCTION broken FOR fin AS $$ SELECT subject, 'blue' AS band, 0.0 AS score FROM slots $$;

query TT
SELECT band, error FROM TESTS(orders.id::role);
----
error	detector broken served (fin.orders.id, blue, 0.0), outside the test-results schema

# no row where nobody spoke: the error is served on subjects holding slots
query I
SELECT count(*) FROM TESTS(orders.amount::role);
----
0

# --- a source is a workspace row (SPEC §5.1): its subject is the bare declared name, every dataset's sweep owes and serves it, and a gloss from any dataset supersedes

statement ok
DECLARE SOURCE erp SET (type: csv, location: '{TEST_DIR}');

statement ok
DECLARE ASPECT conventions WITH $${"type": "object"}$$ AS FACT ON SOURCE;

statement ok
DECLARE TEST conventions_test ON conventions BY (AGENT, HUMAN);

# owed in the dataset's sweep, as the bare name; a narrowed read keeps to its subject
query TTT
SELECT subject, aspect, state FROM GLOSSARY() WHERE aspect = 'conventions';
----
erp	conventions	missing

query I
SELECT count(*) FROM GLOSSARY(orders) WHERE aspect = 'conventions';
----
0

query TT
SELECT subject, state FROM GLOSSARY(erp);
----
erp	missing

# the grain gate: a subject outside the aspect's declared grains is refused, never landed in silence

statement error
GLOSS conventions ON fin AS $${"fiscal_year_start": "04-01"}$$;
----
aspect 'conventions' is declared ON SOURCE; fin is a dataset

statement error
GLOSS conventions ON orders AS $${"fiscal_year_start": "04-01"}$$;
----
aspect 'conventions' is declared ON SOURCE; fin.orders is a table

statement error
GLOSS note ON erp AS $${"value": "x"}$$;
----
aspect 'note' is declared ON TABLE; erp is a source

statement error
GLOSS role ON orders AS $${"value": "key"}$$;
----
aspect 'role' is declared ON COLUMN; fin.orders is a table

query T
GLOSS conventions ON erp AS $${"fiscal_year_start": "04-01"}$$;
----
glossed conventions on erp as agent

# the row records the dataset it was deposited in, and carries no catalog snapshot: a source never goes stale
query TTT
SELECT dataset, subject, snapshot_id FROM glossary WHERE aspect = 'conventions';
----
fin	erp	NULL

query TTTT
SELECT subject, value, band, state FROM GLOSSARY(erp);
----
erp	{"fiscal_year_start": "04-01"}	NULL	current

# the next dataset reads the deposit, and its own gloss supersedes it workspace-wide
statement ok
DECLARE DATASET ops SET (purpose: 'reads the deposit');

statement ok
USE ops;

query TTT
SELECT subject, value, state FROM GLOSSARY() WHERE aspect = 'conventions';
----
erp	{"fiscal_year_start": "04-01"}	current

statement ok
GLOSS conventions ON erp AS $${"fiscal_year_start": "01-01"}$$;

statement ok
USE fin;

query TT
SELECT value, state FROM GLOSSARY(erp::conventions);
----
{"fiscal_year_start": "01-01"}	current

query TTT
SELECT actor, body, current FROM GLOSSARY(erp, all => true);
----
agent	{"fiscal_year_start": "01-01"}	true

# a grainless aspect on a source name stays dataset-scoped: the dataset that wrote it reads it, another does not
statement ok
DECLARE ASPECT remark WITH $${"type": "object"}$$ AS FACT;

statement ok
GLOSS remark ON erp AS $${"text": "fin's"}$$;

query TT
SELECT aspect, state FROM GLOSSARY(erp) ORDER BY aspect;
----
conventions	current
remark	current

statement ok
USE ops;

query TT
SELECT aspect, state FROM GLOSSARY(erp) ORDER BY aspect;
----
conventions	current

statement ok
USE fin;

# --- one voice scored red is served with its band: a measurement alone never contests itself (SPEC §5.3)

statement ok
DECLARE ASPECT tie_out WITH $${"type": "object", "properties": {"breach_rate": {"type": "number"}, "tolerance": {"type": "number"}}}$$ AS FACT ON TABLE;

statement ok
DECLARE FUNCTION tie_out_check FOR GLOBAL AS $$ SELECT 1.0 AS breach_rate, 'every line against its order' AS outcome $$ RETURNS tie_out;

statement ok
DECLARE FUNCTION rate_red FOR GLOBAL AS $$ SELECT subject, CASE WHEN max(try_cast(body->>'breach_rate' AS DOUBLE)) > $threshold THEN 'red' ELSE 'green' END AS band, coalesce(max(try_cast(body->>'breach_rate' AS DOUBLE)), 0.0) AS score FROM slots GROUP BY subject $$;

statement ok
DECLARE TEST tie_out_test ON tie_out BY (AGENT, HUMAN) DETECTOR rate_red THRESHOLD 0.0;

statement ok
SELECT tie_out_check() FROM orders;

query TTRT
SELECT aspect, band, score, state FROM GLOSSARY(orders) WHERE aspect = 'tie_out';
----
tie_out	red	1.0	current

query TR
SELECT band, score FROM TESTS(orders::tie_out);
----
red	1.0

# a second voice makes it a disagreement: conflict, the value withheld

statement ok
GLOSS tie_out ON orders AS $${"tolerance": 0.0}$$;

query TTT
SELECT value, band, state FROM GLOSSARY(orders::tie_out);
----
NULL	red	conflict

# --- a measurement that reads other measurements is served while they hold and computes once another function lands a row; its own rows are never its input (SPEC §6)

statement ok
DECLARE ASPECT tie_out_count WITH $${"type": "object"}$$ AS MEASUREMENT ON TABLE;

statement ok
DECLARE FUNCTION tie_out_count FOR GLOBAL AS $$ SELECT count(*) AS n, 'stored tie-outs' AS what FROM main.measurements WHERE function = 'tie_out_check' $$ RETURNS tie_out_count;

query TTTTT
SELECT tie_out_count() FROM orders;
----
tie_out_count	fin.orders	tie_out_count	{"n":1,"what":"stored tie-outs"}	true

# the reader's reads name the function it filtered to, not the whole relation
query T
SELECT reads FROM measurements WHERE function = 'tie_out_count' ORDER BY seq DESC LIMIT 1;
----
main.measurements/tie_out_check

query TTTTT
SELECT tie_out_count() FROM orders;
----
tie_out_count	fin.orders	tie_out_count	{"n":1,"what":"stored tie-outs"}	false

statement ok
DECLARE FUNCTION tie_out_check FOR GLOBAL AS $$ SELECT 0.5 AS breach_rate, 'every line against its order' AS outcome $$ RETURNS tie_out;

statement ok
SELECT tie_out_check() FROM orders;

query TTTTT
SELECT tie_out_count() FROM orders;
----
tie_out_count	fin.orders	tie_out_count	{"n":2,"what":"stored tie-outs"}	true

query TTTTT
SELECT tie_out_count() FROM orders;
----
tie_out_count	fin.orders	tie_out_count	{"n":2,"what":"stored tie-outs"}	false
