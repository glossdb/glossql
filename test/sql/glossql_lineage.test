# name: test/sql/glossql_lineage.test
# description: lineage: what computes each column of a query, read off its bound plan; a landing records it, a gloss reads stale once the derivation behind its column moved (SPEC §3), and the landings' diff is the drift record of what a source sends
# group: [sql]

require glossql

require json

require parquet

require ducklake

statement ok
ATTACH 'ducklake::memory:' AS ws (DATA_PATH '{TEST_DIR}/glossql_lineage_lake/');

statement ok
USE ws;

statement ok
PRAGMA glossql;

statement ok
DECLARE DATASET fin SET (purpose: 'lineage');

statement ok
USE fin;

statement ok
CREATE TABLE fin.orders AS SELECT i AS id, i * 1.5 AS amount, 'c' || (i % 2) AS customer FROM range(4) t(i);

statement ok
CREATE TABLE fin.customers AS SELECT 'c' || i AS customer, 'seg' || i AS segment FROM range(2) t(i);

# --- glossql_lineage(sql): each output column resolved to what computes it; a leaf is scan.column:type

query TTT
FROM glossql_lineage($$SELECT id, amount * 2 AS twice, id::VARCHAR AS id_text, 'x' AS tag FROM fin.orders WHERE id > 1$$);
----
id	fin.orders.id:BIGINT	true
twice	*(fin.orders.amount:DECIMAL(21,1), cast(2 as DECIMAL(31,0)))	true
id_text	cast(fin.orders.id:BIGINT as VARCHAR)	true
tag	'x'	true

query TTT
FROM glossql_lineage($$SELECT customer, sum(amount) AS total, count(*) AS n, count(DISTINCT id) AS ids FROM fin.orders GROUP BY customer$$);
----
customer	fin.orders.customer:VARCHAR	true
total	sum(fin.orders.amount:DECIMAL(21,1))	true
n	count_star()	true
ids	count(distinct fin.orders.id:BIGINT)	true

query TTT
FROM glossql_lineage($$SELECT o.id, c.segment FROM fin.orders o JOIN fin.customers c USING (customer)$$);
----
id	fin.orders.id:BIGINT	true
segment	fin.customers.segment:VARCHAR	true

# a subquery, a CTE, a union and a window resolve through; a correlated subquery is a mark
query TTT
FROM glossql_lineage($$SELECT s.id, s.net FROM (SELECT id, amount * 0.8 AS net FROM fin.orders) s$$);
----
id	fin.orders.id:BIGINT	true
net	*(fin.orders.amount:DECIMAL(21,1), cast(0.8 as DECIMAL(23,1)))	true

query TI
SELECT bool_and(complete), count(*) FROM glossql_lineage($$WITH big AS (SELECT id, amount FROM fin.orders WHERE amount > 2) SELECT b.id, b.amount * 10 AS scaled, row_number() OVER (ORDER BY b.id) AS rn FROM big b UNION ALL SELECT 0, 0.0, 0$$);
----
true	3

query TT
SELECT "column", derivation FROM glossql_lineage($$SELECT o.id, EXISTS (SELECT 1 FROM fin.customers c WHERE c.customer = o.customer) AS known FROM fin.orders o$$);
----
id	fin.orders.id:BIGINT
known	mark

# a filter, an order or a limit changes the rows, not what a column is
query I
SELECT count(DISTINCT derivation) FROM (SELECT derivation FROM glossql_lineage($$SELECT amount * 2 AS twice FROM fin.orders$$) UNION ALL SELECT derivation FROM glossql_lineage($$SELECT amount * 2 AS twice FROM fin.orders WHERE id > 2 ORDER BY id LIMIT 1$$));
----
1

statement error
FROM glossql_lineage($$CREATE TABLE x AS SELECT 1$$);
----
takes one SELECT

# --- a landing records its recipe's lineage per column

statement ok
COPY (SELECT i AS id, i * 10 AS amount, 'c' || (i % 2) AS customer FROM range(4) t(i)) TO '{TEST_DIR}/sales.csv' (HEADER);

statement ok
DECLARE SOURCE erp SET (type: csv, location: '{TEST_DIR}');

statement ok
DECLARE RECIPE sales ON fin FROM erp AS $$SELECT id::INTEGER AS id, amount::DOUBLE AS amount, customer FROM read_csv('sales.csv')$$;

query TT
SELECT table_name, lineage FROM imports;
----
sales	{"id":"cast(read_csv.id:BIGINT as INTEGER)","amount":"cast(read_csv.amount:BIGINT as DOUBLE)","customer":"read_csv.customer:VARCHAR"}

# --- re-derivation (SPEC §3): a gloss ages once the derivation behind its column moved, per column

statement ok
DECLARE ASPECT note WITH $${"type": "object"}$$ AS FACT ON TABLE, COLUMN;

statement ok
GLOSS note ON sales.amount AS $${"text": "gross"}$$;

statement ok
GLOSS note ON sales.id AS $${"text": "the key"}$$;

statement ok
GLOSS note ON sales AS $${"text": "the sales"}$$;

query TT
SELECT subject, state FROM GLOSSARY(sales) ORDER BY subject;
----
fin.sales	current
fin.sales.amount	current
fin.sales.id	current

# the recipe now derives amount differently: the same name, the same type, so the lake sees no change
statement ok
DECLARE RECIPE sales ON fin FROM erp AS $$SELECT id::INTEGER AS id, (amount * 0.8)::DOUBLE AS amount, customer FROM read_csv('sales.csv')$$;

query TT
SELECT subject, state FROM GLOSSARY(sales) ORDER BY subject;
----
fin.sales	stale
fin.sales.amount	stale
fin.sales.id	current

query TTT
SELECT subject, actor, current FROM GLOSSARY(sales, all => true) ORDER BY subject;
----
fin.sales	agent	false
fin.sales.amount	agent	false
fin.sales.id	agent	true

# a re-gloss stands at the newest landing
statement ok
GLOSS note ON sales.amount AS $${"text": "net"}$$;

statement ok
GLOSS note ON sales AS $${"text": "the sales, net"}$$;

query TT
SELECT subject, state FROM GLOSSARY(sales) ORDER BY subject;
----
fin.sales	current
fin.sales.amount	current
fin.sales.id	current

# a column added, or a filter changed, re-derives nothing
statement ok
DECLARE RECIPE sales ON fin FROM erp AS $$SELECT id::INTEGER AS id, (amount * 0.8)::DOUBLE AS amount, customer, 1 AS extra FROM read_csv('sales.csv') WHERE id >= 0$$;

query TT
SELECT subject, state FROM GLOSSARY(sales) ORDER BY subject;
----
fin.sales	current
fin.sales.amount	current
fin.sales.id	current

# a table made by hand has no landing and never re-derives
statement ok
GLOSS note ON orders.amount AS $${"text": "made by hand"}$$;

query TT
SELECT subject, state FROM GLOSSARY(orders.amount);
----
fin.orders.amount	current

# --- drift in what the source sends: under the same recipe the leaf moves, and the landings' diff shows it

statement ok
COPY (SELECT i AS id, i * 10 AS amount FROM range(3) t(i)) TO '{TEST_DIR}/raw.csv' (HEADER);

statement ok
DECLARE RECIPE raw ON fin FROM erp AS $$SELECT id, amount::DOUBLE AS amount FROM read_csv('raw.csv')$$;

statement ok
GLOSS note ON raw.amount AS $${"text": "whole units"}$$;

query T
SELECT lineage->>'amount' FROM imports WHERE table_name = 'raw';
----
cast(read_csv.amount:BIGINT as DOUBLE)

# the source now sends fractions: the landed column keeps its type, the lake sees no change, the lineage does
statement ok
COPY (SELECT i AS id, i * 10.5 AS amount FROM range(3) t(i)) TO '{TEST_DIR}/raw.csv' (HEADER);

statement ok
IMPORT raw;

query TT
SELECT subject, state FROM GLOSSARY(raw.amount);
----
fin.raw.amount	stale

query TT
SELECT mode, lineage->>'amount' FROM imports WHERE table_name = 'raw' ORDER BY seq;
----
replace	cast(read_csv.amount:BIGINT as DOUBLE)
replace	read_csv.amount:DOUBLE

query T
SELECT data_type FROM information_schema.columns WHERE table_schema = 'fin' AND table_name = 'raw' AND column_name = 'amount';
----
DOUBLE
