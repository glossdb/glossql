query II
SELECT count(*), count(DISTINCT "column") FROM glossql_views_lineage(NULL) WHERE view = 'wide';
----
2100	2100

# --- glossql_views_scans(dataset): every table a view scans, joins and filters included; NULL reads every dataset

statement ok
CREATE VIEW fin.big_customers AS SELECT o.id FROM fin.orders o JOIN fin.customers c USING (customer) WHERE c.segment = 'seg1';

# each scan names the columns the view reads of it, the join's and the filter's included
query TTTT
SELECT dataset, view, table_name, columns FROM glossql_views_scans('fin') WHERE view = 'big_customers' ORDER BY ALL;
----
fin	big_customers	fin.customers	[customer, segment]
fin	big_customers	fin.orders	[customer, id]

query TTT
SELECT dataset, view, table_name FROM glossql_views_scans(NULL) WHERE view = 'visit_count';
----
ops	visit_count	ops.visits

# --- glossql_views_joins(dataset): the column pairs a view's joins equate, a join's ON, USING and a WHERE alike; a shared column the view only reads is no pair

query TTT
SELECT view, left_column, right_column FROM glossql_views_joins('fin') WHERE view = 'big_customers';
----
big_customers	fin.customers.customer	fin.orders.customer

statement ok
CREATE VIEW fin.where_join AS SELECT o.id, c.segment FROM fin.orders o, fin.customers c WHERE o.customer = c.customer AND c.segment = 'seg1';

query TT
SELECT left_column, right_column FROM glossql_views_joins('fin') WHERE view = 'where_join';
----
fin.customers.customer	fin.orders.customer

statement ok
CREATE VIEW fin.no_join AS SELECT customer FROM fin.orders UNION ALL SELECT customer FROM fin.customers;

query I
SELECT count(*) FROM glossql_views_joins('fin') WHERE view = 'no_join';
----
0

# --- left_unique, right_unique: a side the view joins reduced to one row per value of the join columns. A GROUP BY on them, a DISTINCT, a row_number() filtered to 1 and a CTE each count; the plain table does not, nor a GROUP BY on more than the join columns, nor a reduced side joined to rows that repeat it before the join

query TTTT
SELECT left_column, right_column, left_unique, right_unique FROM glossql_views_joins('fin') WHERE view = 'big_customers';
----
fin.customers.customer	fin.orders.customer	false	false

statement ok
CREATE VIEW fin.join_grouped AS SELECT o.id, c.segment FROM fin.orders o JOIN (SELECT customer, max(segment) AS segment FROM fin.customers GROUP BY customer) c ON o.customer = c.customer;

statement ok
CREATE VIEW fin.join_latest AS SELECT o.id, c.segment FROM fin.orders o JOIN (SELECT * FROM fin.customers QUALIFY row_number() OVER (PARTITION BY customer ORDER BY segment DESC) = 1) c ON o.customer = c.customer;

statement ok
CREATE VIEW fin.join_latest_where AS SELECT o.id, c.segment FROM fin.orders o, (SELECT customer, segment FROM (SELECT customer, segment, row_number() OVER (PARTITION BY customer ORDER BY segment DESC) AS rn FROM fin.customers) WHERE rn = 1) c WHERE o.customer = c.customer;

statement ok
CREATE VIEW fin.join_distinct AS SELECT o.id FROM fin.orders o JOIN (SELECT DISTINCT customer FROM fin.customers) c ON o.customer = c.customer;

statement ok
CREATE VIEW fin.join_cte AS WITH c AS (SELECT customer, max(segment) AS segment FROM fin.customers GROUP BY ALL) SELECT o.id, c.segment FROM fin.orders o JOIN c USING (customer);

statement ok
CREATE VIEW fin.join_wider_key AS SELECT o.id, c.segment FROM fin.orders o JOIN (SELECT customer, segment, count(*) AS n FROM fin.customers GROUP BY customer, segment) c ON o.customer = c.customer;

statement ok
CREATE VIEW fin.join_after_fan AS SELECT o.id FROM fin.orders o JOIN (SELECT g.customer FROM (SELECT customer FROM fin.customers GROUP BY customer) g JOIN fin.orders x ON x.customer = g.customer) c ON o.customer = c.customer;

query TTTTT
SELECT view, left_column, right_column, left_unique, right_unique FROM glossql_views_joins('fin') WHERE view LIKE 'join_%' ORDER BY ALL;
----
join_after_fan	fin.customers.customer	fin.orders.customer	false	false
join_cte	fin.customers.customer	fin.orders.customer	true	false
join_distinct	fin.customers.customer	fin.orders.customer	true	false
join_grouped	fin.customers.customer	fin.orders.customer	true	false
join_latest	fin.customers.customer	fin.orders.customer	true	false
join_latest_where	fin.customers.customer	fin.orders.customer	true	false
join_wider_key	fin.customers.customer	fin.orders.customer	false	false

# --- shape: how a column was computed, where that decides how it adds up. A division by an aggregate is a ratio, an average an average, a distinct count distinct; a sum over one keeps it, a division by a constant has none

query TT
SELECT "column", shape FROM glossql_lineage($$SELECT customer, sum(amount) AS total, sum(amount) / 60.0 AS hours, sum(amount) / count(*) AS per_order, avg(amount) AS mean, count(DISTINCT id) AS buyers, amount / id AS row_ratio FROM fin.orders GROUP BY customer, amount, id$$) ORDER BY 1;
----
buyers	distinct
customer	NULL
hours	NULL
mean	average
per_order	ratio
row_ratio	NULL
total	NULL

statement ok
CREATE VIEW fin.daily_rate AS SELECT customer, sum(amount)::DOUBLE / count(*) AS value FROM fin.orders GROUP BY customer;

statement ok
CREATE VIEW fin.summed_rate AS WITH d AS (SELECT value FROM fin.daily_rate) SELECT sum(value) AS value FROM d;

query TTT
SELECT view, "column", shape FROM glossql_views_lineage('fin') WHERE view IN ('daily_rate', 'summed_rate', 'revenue') ORDER BY ALL;
----
daily_rate	customer	NULL
daily_rate	value	ratio
revenue	customer	NULL
revenue	total	NULL
summed_rate	value	ratio
