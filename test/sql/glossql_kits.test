# name: test/sql/glossql_kits.test
# description: a kit is a script of declarations glossql_kit() loads; the KPI kit's vocabulary, definition schema, detector, measurements and tests
# group: [sql]

require glossql

require json

require parquet

require ducklake

statement ok
ATTACH 'ducklake::memory:' AS ws (DATA_PATH '{TEST_DIR}/glossql_kits_lake/');

statement ok
USE ws;

statement ok
PRAGMA glossql;

# a stored result's reads are walked over the lineage kit's places
statement ok
FROM glossql_kit('kits/lineage/kit.sql');

statement ok
DECLARE DATASET fin SET (purpose: 'kits');

statement ok
USE fin;

statement ok
CREATE TABLE fin.orders AS SELECT i AS id, i * 1.5 AS amount, 'c' || (i % 2) AS customer FROM range(4) t(i);

# the loader runs the script statement by statement and serves one row each
statement ok
CREATE TABLE main.loaded AS FROM glossql_kit('kits/kpi/kit.sql');

query I
SELECT count(*) FROM main.loaded;
----
19

query TT
SELECT statement, (outcome) IS NOT NULL FROM main.loaded WHERE statement LIKE 'DECLARE TEST role_test%';
----
DECLARE TEST role_test ON role BY (AGENT, HUMAN) DETECTOR value_entropy THRESHOLD 0.7;	true

query TTI
SELECT name, location, statements FROM kits ORDER BY name;
----
kpi	kits/kpi/kit.sql	19
lineage	kits/lineage/kit.sql	23

query I
SELECT count(*) FROM aspects;
----
10

# a kit run again with the same text, as the opener does at start-up, is current: one row says so, nothing runs, no new kits row
query TT
FROM glossql_kit('kits/kpi/kit.sql');
----
kpi	current

query II
SELECT count(*), length(max(hash)) FROM kits WHERE name = 'kpi';
----
1	32

# a failing statement stops the load; the ones before it stay
statement error
FROM glossql_kit('kits/nothing/kit.sql');
----
nothing

# --- the vocabulary is required where a test is declared: role on every column, meaning and entity by grain;
# additivity, unit and dimension wait on a role (WHEN)

query TTT
SELECT subject, aspect, state FROM GLOSSARY(orders) ORDER BY subject, aspect;
----
fin.orders	entity	missing
fin.orders	meaning	missing
fin.orders.amount	meaning	missing
fin.orders.amount	role	missing
fin.orders.customer	meaning	missing
fin.orders.customer	role	missing
fin.orders.id	meaning	missing
fin.orders.id	role	missing

statement ok
GLOSS role ON orders.amount AS $${"value": "measure"}$$;

query TT
SELECT aspect, state FROM GLOSSARY(orders.amount) ORDER BY aspect;
----
additivity	missing
meaning	missing
role	current
unit	missing

# --- value_entropy judges the enum claims: the human disagrees, the role is in conflict, red at 0.7

statement ok
SET VARIABLE glossql_actor = 'human';

statement ok
GLOSS role ON orders.amount AS $${"value": "dimension"}$$;

statement ok
RESET VARIABLE glossql_actor;

query TTR
SELECT aspect, state, score FROM TESTS(orders.amount::role);
----
role	red	1.0

# the human's value wins the WHEN: dimension is required now, additivity and unit are not
query TTT
SELECT aspect, value, state FROM GLOSSARY(orders.amount) ORDER BY aspect;
----
dimension	NULL	missing
meaning	NULL	missing
role	NULL	conflict

# --- a metric's body is the definition contract; what a reader needs is glossed on the view's
# columns, under the kit's words — the kit declares no definition schema

statement ok
DECLARE ASPECT revenue WITH $${"title": "revenue"}$$ AS VIEW;

statement ok
GLOSS revenue ON fin AS $${"sql": "SELECT sum(amount) AS revenue FROM fin.orders"}$$;

query R
SELECT revenue FROM fin.revenue;
----
9.0

statement ok
GLOSS role ON revenue.revenue AS $${"value": "measure"}$$;

statement error
GLOSS additivity ON revenue.revenue AS $${"value": "stok"}$$;
----
Invalid Input Error

statement ok
GLOSS additivity ON revenue.revenue AS $${"value": "ratio", "numerator": "won", "denominator": "offered"}$$;

# --- the measurements are stored through extraction and serve beside the glosses

query TTTTT
SELECT column_profile() FROM orders.amount;
----
column_profile	fin.orders.amount	column_profile	{"total":4,"null_ratio":0.0,"distinct":4,"min":"0.0","max":"4.5"}	true

query TTTTT
SELECT outlier_profile() FROM orders.amount;
----
outlier_profile	fin.orders.amount	outlier_profile	{"applicable":true,"iqr":{"lower":-2.25,"upper":6.75,"count":0,"ratio":0.0},"zscore":{"count":0,"ratio":0.0}}	true

# a column that does not parse as numbers is examined and not applicable
query TTTTT
SELECT outlier_profile() FROM orders.customer;
----
outlier_profile	fin.orders.customer	outlier_profile	{"applicable":false,"iqr":null,"zscore":null}	true

query TTT
SELECT aspect, value, state FROM GLOSSARY(orders.amount) ORDER BY aspect;
----
column_profile	{"total":4,"null_ratio":0.0,"distinct":4,"min":"0.0","max":"4.5"}	current
dimension	NULL	missing
meaning	NULL	missing
outlier_profile	{"applicable":true,"iqr":{"lower":-2.25,"upper":6.75,"count":0,"ratio":0.0},"zscore":{"count":0,"ratio":0.0}}	current
role	NULL	conflict

# the measurement is a table macro too
query II
SELECT total, "distinct" FROM main.column_profile('fin.orders.id');
----
4	4

# --- a subject names a loaded table's column as DuckDB matches names: case-insensitively, in the catalog's spelling

statement ok
CREATE TABLE fin.cased AS SELECT 1 AS "OrderId", 2.5 AS amount;

statement ok
GLOSS meaning ON cased.orderid AS $${"value": "the order"}$$;

query TT
SELECT subject, state FROM GLOSSARY(cased) WHERE aspect = 'meaning' AND subject LIKE '%.OrderId';
----
fin.cased.OrderId	current

# --- a column's name may hold a dot, spelled quoted: the column is what follows the second dot (SPEC §4);
# a dataset's and a table's name carry none

statement ok
CREATE TABLE fin.dotted AS SELECT 1 AS "a.b", 2 AS c;

statement ok
GLOSS meaning ON dotted."a.b" AS $${"value": "dotted"}$$;

query TT
SELECT subject, state FROM GLOSSARY(dotted."a.b") WHERE aspect = 'meaning';
----
fin.dotted.a.b	current

statement ok
SELECT column_profile() FROM dotted."a.b";

query T
SELECT value->>'total' FROM measurements WHERE function = 'column_profile' AND subject = 'fin.dotted.a.b';
----
1

statement ok
CREATE OR REPLACE TABLE fin.dotted AS SELECT 2 AS c;

query TT
SELECT subject, state FROM GLOSSARY(dotted."a.b") WHERE aspect = 'meaning';
----
fin.dotted.a.b	stale

statement error
DECLARE DATASET "a.b" SET (purpose: 'none');
----
Invalid Input Error

statement error
DECLARE RECIPE "a.b" ON fin FROM nowhere AS $$SELECT 1$$;
----
Invalid Input Error

# --- a kit's name under a changed text runs whole and stores a new kits row; the original text is then not the
# newest row's for the name, so it runs again

statement ok
COPY (SELECT 'DECLARE ASPECT sample WITH $${"title": "Sample"}$$ AS FACT ON DATASET;' AS s) TO '{TEST_DIR}/glossql_kits_lake/kpi.sql' (FORMAT csv, HEADER false, QUOTE '');

query I
SELECT count(*) FROM (FROM glossql_kit('{TEST_DIR}/glossql_kits_lake/kpi.sql')) WHERE outcome <> 'current';
----
1

query I
SELECT count(*) FROM (FROM glossql_kit('kits/kpi/kit.sql')) WHERE outcome = 'current';
----
0

query TI
SELECT name, count(*) FROM kits GROUP BY name ORDER BY name;
----
kpi	1
lineage	1

# --- declared_by: a kit's declarations name the kit, the connection's own name its actor

query TT
SELECT DISTINCT declared_by, (SELECT DISTINCT declared_by FROM tests WHERE name = 'unit_test') FROM aspects WHERE name IN ('meaning', 'unit');
----
kit:kpi	kit:kpi

statement ok
DECLARE ASPECT house_rule WITH $${"type": "object"}$$ AS FACT ON DATASET;

statement ok
SET VARIABLE glossql_actor = 'human';

statement ok
SET VARIABLE glossql_actor_id = 'ana';

statement ok
DECLARE TEST house_rule_test ON house_rule BY (AGENT, HUMAN);

statement ok
RESET VARIABLE glossql_actor_id;

statement ok
RESET VARIABLE glossql_actor;

query TT
SELECT (SELECT declared_by FROM aspects WHERE name = 'house_rule'), (SELECT declared_by FROM tests WHERE name = 'house_rule_test');
----
agent	human:ana
