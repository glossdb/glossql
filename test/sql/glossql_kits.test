# name: test/sql/glossql_kits.test
# description: a kit is a script of declarations glossql_kit() loads; the KPI kit's vocabulary, grounding schema, detector, measurements and witnesses
# group: [sql]

require glossql

require json

require parquet

require ducklake

statement ok
ATTACH 'ducklake::memory:' AS ws (DATA_PATH '{TEST_DIR}/glossql_kits_lake/');

statement ok
USE ws;

statement ok
PRAGMA glossql;

statement ok
DECLARE DATASET fin SET (purpose: 'kits');

statement ok
USE fin;

statement ok
CREATE TABLE fin.orders AS SELECT i AS id, i * 1.5 AS amount, 'c' || (i % 2) AS customer FROM range(4) t(i);

# the loader runs the script statement by statement and serves one row each
statement ok
CREATE TABLE main.loaded AS FROM glossql_kit('kits/kpi/kit.sql');

query I
SELECT count(*) FROM main.loaded;
----
19

query TT
SELECT statement, outcome FROM main.loaded WHERE statement LIKE 'DECLARE WITNESS role_w%';
----
DECLARE WITNESS role_w ON role BY (AGENT, HUMAN) DETECTOR slot_entropy THRESHOLD 0.7;	declared witness role_w on role

query TTI
SELECT name, location, statements FROM glossql.kits;
----
kpi	kits/kpi/kit.sql	19

query I
SELECT count(*) FROM glossql.aspects;
----
10

# a kit run again, as the opener does at start-up, is silent: every declaration unchanged, no new kits row
query I
SELECT count(*) FROM (FROM glossql_kit('kits/kpi/kit.sql')) WHERE outcome <> 'ok' AND outcome NOT LIKE '%unchanged: no-op';
----
0

query I
SELECT count(*) FROM glossql.kits;
----
1

# a failing statement stops the load; the ones before it stand
statement error
FROM glossql_kit('kits/nothing/kit.sql');
----
nothing

# --- the vocabulary is owed where a witness stands: role on every column, meaning and entity by grain;
# behavior, unit and dimension wait on a role (WHEN)

query TTT
SELECT subject, aspect, state FROM GLOSSARY(orders) ORDER BY subject, aspect;
----
fin.orders	entity	unassessed
fin.orders	meaning	unassessed
fin.orders.amount	meaning	unassessed
fin.orders.amount	role	unassessed
fin.orders.customer	meaning	unassessed
fin.orders.customer	role	unassessed
fin.orders.id	meaning	unassessed
fin.orders.id	role	unassessed

statement ok
GLOSS role ON orders.amount AS $${"value": "measure"}$$;

query TT
SELECT aspect, state FROM GLOSSARY(orders.amount) ORDER BY aspect;
----
behavior	unassessed
meaning	unassessed
role	current
unit	unassessed

# --- slot_entropy judges the enum claims: the human disagrees, the role is contested, red at 0.7

statement ok
SET VARIABLE glossql_actor = 'human';

statement ok
GLOSS role ON orders.amount AS $${"value": "dimension"}$$;

statement ok
RESET VARIABLE glossql_actor;

query TTR
SELECT aspect, band, score FROM ATTEST(orders.amount::role);
----
role	red	1.0

# the human's slot wins the WHEN: dimension is owed now, behavior and unit are not
query TTT
SELECT aspect, value, state FROM GLOSSARY(orders.amount) ORDER BY aspect;
----
dimension	NULL	unassessed
meaning	NULL	unassessed
role	NULL	contested

# --- a metric's body is the grounding contract; what a reader needs is glossed on the view's
# columns, under the kit's words — the kit declares no grounding schema

statement ok
DECLARE ASPECT revenue WITH $${"title": "revenue"}$$ AS QUERY;

statement ok
GLOSS revenue ON fin AS $${"sql": "SELECT sum(amount) AS revenue FROM fin.orders"}$$;

query R
SELECT revenue FROM fin.revenue;
----
9.0

query T
GLOSS role ON revenue.revenue AS $${"value": "measure"}$$;
----
glossed role on fin.revenue.revenue as agent

statement error
GLOSS behavior ON revenue.revenue AS $${"value": "stok"}$$;
----
at $.value

query T
GLOSS behavior ON revenue.revenue AS $${"value": "ratio", "numerator": "won", "denominator": "offered"}$$;
----
glossed behavior on fin.revenue.revenue as agent

# --- the measurements land through extraction and serve beside the glosses

query TTTTT
SELECT column_profile() FROM orders.amount;
----
column_profile	fin.orders.amount	column_profile	{"total":4,"null_ratio":0.0,"distinct":4,"min":"0.0","max":"4.5"}	true

query TTTTT
SELECT outlier_profile() FROM orders.amount;
----
outlier_profile	fin.orders.amount	outlier_profile	{"applicable":true,"iqr":{"lower":-2.25,"upper":6.75,"count":0,"ratio":0.0},"zscore":{"count":0,"ratio":0.0}}	true

# a column that does not parse as numbers is examined and not applicable
query TTTTT
SELECT outlier_profile() FROM orders.customer;
----
outlier_profile	fin.orders.customer	outlier_profile	{"applicable":false,"iqr":null,"zscore":null}	true

query TTT
SELECT aspect, value, state FROM GLOSSARY(orders.amount) ORDER BY aspect;
----
column_profile	{"total":4,"null_ratio":0.0,"distinct":4,"min":"0.0","max":"4.5"}	current
dimension	NULL	unassessed
meaning	NULL	unassessed
outlier_profile	{"applicable":true,"iqr":{"lower":-2.25,"upper":6.75,"count":0,"ratio":0.0},"zscore":{"count":0,"ratio":0.0}}	current
role	NULL	contested

# the measurement is a table macro too
query II
SELECT total, "distinct" FROM glossql.column_profile('fin.orders.id');
----
4	4

# --- a subject names a landed column as DuckDB matches names: case-insensitively, in the catalog's spelling

statement ok
CREATE TABLE fin.cased AS SELECT 1 AS "OrderId", 2.5 AS amount;

query T
GLOSS meaning ON cased.orderid AS $${"value": "the order"}$$;
----
glossed meaning on fin.cased.OrderId as agent

query TT
SELECT subject, state FROM GLOSSARY(cased) WHERE aspect = 'meaning' AND subject LIKE '%.OrderId';
----
fin.cased.OrderId	current
