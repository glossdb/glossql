# name: test/sql/glossql_schema.test
# description: every body is JSON validated by a JSON Schema; definitions are views; WHEN bounds disclosure
# group: [sql]

require glossql

require json

require parquet

require ducklake

statement ok
ATTACH 'ducklake::memory:' AS ws (DATA_PATH '{TEST_DIR}/glossql_schema_lake/');

statement ok
USE ws;

statement ok
PRAGMA glossql;

statement ok
DECLARE DATASET fin SET (purpose: 'schemas');

statement ok
USE fin;

statement ok
CREATE TABLE fin.orders AS SELECT i AS id, i * 1.5 AS amount, 'c' || i AS currency_code FROM range(4) t(i);

# --- json_schema_check is a scalar function for any SQL: NULL when the document conforms

query T
SELECT json_schema_check('{"type": "object", "required": ["value"]}', '{"value": 1}');
----
NULL

query T
SELECT (json_schema_check('{"type": "object", "required": ["value"]}', '{}')) IS NOT NULL;
----
true

query T
SELECT (json_schema_check('{"type": "string"}', '42')) IS NOT NULL;
----
true

query T
SELECT (json_schema_check('{"type": "array", "items": {"enum": ["a", "b"]}, "minItems": 1}', '["a", "c"]')) IS NOT NULL;
----
true

query T
SELECT (json_schema_check('{"properties": {"n": {"type": "number", "minimum": 0, "maximum": 1}}}', '{"n": 1.5}')) IS NOT NULL;
----
true

# --- a FACT body validates against the property's WITH schema

statement ok
DECLARE PROPERTY unit WITH $${"type": "object", "properties": {"value": {"type": "string"}, "source_column": {"type": "string"}}, "required": ["value"], "additionalProperties": false}$$ AS FACT ON COLUMN;

statement error
GLOSS unit ON orders.amount AS $${"value": 5}$$;
----
Invalid Input Error

statement error
GLOSS unit ON orders.amount AS $${"unit": "EUR"}$$;
----
Invalid Input Error

statement error
GLOSS unit ON orders.amount AS $${"value": "EUR", "note": "x"}$$;
----
Invalid Input Error

statement ok
GLOSS unit ON orders.amount AS $${"value": "EUR", "source_column": "currency_code"}$$;

# a TABLE or COLUMN grain takes loaded subjects only
statement error
GLOSS unit ON orders.nothing AS $${"value": "EUR"}$$;
----
Invalid Input Error

statement error
GLOSS unit ON nothing.amount AS $${"value": "EUR"}$$;
----
Invalid Input Error

# --- a view definition meets the contract (sql or stopped, its kind, assumptions disclosed); a definition is a view

statement error
GLOSS revenue ON fin AS $${"formula": "x"}$$;
----
Invalid Input Error

statement error
GLOSS revenue ON fin AS $${"kind": "metric", "sql": "SELECT 1", "stopped": "x"}$$;
----
Invalid Input Error

statement error
GLOSS revenue ON fin AS $${"kind": "metric", "sql": 1}$$;
----
Invalid Input Error

statement error
GLOSS revenue ON fin AS $${"kind": "metric", "sql": "SELECT 1", "assumptions": [{"basis": "guess"}]}$$;
----
Invalid Input Error

statement error
GLOSS revenue ON orders AS $${"kind": "metric", "sql": "SELECT 1"}$$;
----
Invalid Input Error

# a key beside the contract's is admitted
statement ok
GLOSS revenue ON fin AS $${"kind": "metric", "sql": "SELECT sum(amount) AS revenue FROM fin.orders", "window": "7 days"}$$;

statement ok
GLOSS revenue ON fin AS $${"kind": "metric", "sql": "SELECT sum(amount) AS revenue FROM fin.orders", "additivity": "additive", "assumptions": [{"assumption": "amounts are net", "basis": "column_stats", "confidence": 0.9}]}$$;

query R
SELECT revenue FROM fin.revenue;
----
9.0

query T
SELECT view_name FROM duckdb_views() WHERE schema_name = 'fin';
----
revenue

query TTT
SELECT subject, property, value->>'additivity' FROM GLOSSARY(fin::revenue);
----
fin	revenue	additive

# a stop ends the view; the stop serves
statement ok
SET VARIABLE glossql_actor = 'human';

statement ok
GLOSS revenue ON fin AS $${"stopped": "no cost basis loaded yet"}$$;

statement ok
RESET VARIABLE glossql_actor;

query I
SELECT count(*) FROM duckdb_views() WHERE schema_name = 'fin' AND view_name = 'revenue';
----
0

query TT
SELECT subject, value FROM GLOSSARY(fin::revenue);
----
fin	{"stopped": "no cost basis loaded yet"}

# a stop that names no kind keeps the kind of the newest definition with sql
query TT
SELECT view, kind FROM view_bodies('fin');
----
revenue	metric

# the first definition declared the name, a VIEW property by the actor that wrote it; a refused definition
# declares nothing, and a kind outside the four is refused
query TT
SELECT kind, declared_by FROM properties WHERE name = 'revenue';
----
VIEW	agent

statement error
GLOSS chart ON fin AS $${"kind": "chart", "sql": "SELECT 1 AS value"}$$;
----
Invalid Input Error

query I
SELECT count(*) FROM properties_history WHERE name IN ('chart');
----
0

# a view definition on a loaded table's name is refused
statement error
GLOSS orders ON fin AS $${"kind": "metric", "sql": "SELECT 1"}$$;
----
Invalid Input Error

# --- a measurement's output validates against the property's schema at extraction

statement ok
DECLARE PROPERTY min_max WITH $${"type": "object", "required": ["min", "max"], "properties": {"min": {"type": "number"}, "max": {"type": "number"}}}$$ AS MEASUREMENT ON COLUMN;

statement ok
DECLARE FUNCTION min_max FOR GLOBAL AS $$ SELECT min(v) AS min, max(v) AS max FROM subject_column($subject) $$ RETURNS min_max;

query TTTTT
SELECT min_max() FROM orders.amount;
----
min_max	fin.orders.amount	min_max	{"min":0.0,"max":4.5}	true

statement ok
DECLARE FUNCTION lowest FOR fin AS $$ SELECT min(v) AS lowest FROM subject_column($subject) $$ RETURNS min_max;

statement error
SELECT lowest() FROM orders.amount;
----
Invalid Input Error

# --- re-declaring a property: identical content is a no-op, a change under glosses is refused

statement ok
DECLARE PROPERTY unit WITH $${"type": "object", "properties": {"value": {"type": "string"}, "source_column": {"type": "string"}}, "required": ["value"], "additionalProperties": false}$$ AS FACT ON COLUMN;

query I
SELECT count(*) FROM properties WHERE name = 'unit';
----
1

statement error
DECLARE PROPERTY unit WITH $${"type": "object"}$$ AS FACT ON COLUMN;
----
Invalid Input Error

# --- WHEN names a sibling property and a value: required only while the sibling's winning value carries it

statement ok
DECLARE PROPERTY role WITH $${"type": "object", "properties": {"value": {"enum": ["measure", "dimension", "key"]}}}$$ AS FACT ON COLUMN;

statement error
DECLARE PROPERTY currency WITH $${"type": "object"}$$ AS FACT ON COLUMN WHEN nothing = 'measure';
----
Invalid Input Error

statement error
DECLARE PROPERTY currency WITH $${"type": "object"}$$ AS FACT ON COLUMN WHEN role = 'colour';
----
Invalid Input Error

statement ok
DECLARE PROPERTY currency WITH $${"type": "object"}$$ AS FACT ON COLUMN WHEN role = 'measure';

query TT
SELECT name, condition FROM properties WHERE name = 'currency';
----
currency	{"property":"role","value":"measure"}

statement ok
DECLARE TEST currency_test ON currency BY (AGENT, HUMAN);

# no sibling value given: nothing required yet
query I
SELECT count(*) FROM GLOSSARY(orders::currency);
----
0

statement ok
GLOSS role ON orders.amount AS $${"value": "measure"}$$;

statement ok
GLOSS role ON orders.id AS $${"value": "key"}$$;

query TT
SELECT subject, state FROM GLOSSARY(orders::currency);
----
fin.orders.amount	missing

# writes stay gated by grain alone: a gloss outside the condition serves normally
statement ok
GLOSS currency ON orders.id AS $${"value": "none"}$$;

query TTT
SELECT subject, value, state FROM GLOSSARY(orders::currency);
----
fin.orders.amount	NULL	missing
fin.orders.id	{"value": "none"}	current

# --- WHEN TYPE names the columns' data type: required on those columns alone; the base type, DECIMAL for DECIMAL(18,2)

statement error
DECLARE PROPERTY precision WITH $${"type": "object"}$$ AS FACT ON TABLE, COLUMN WHEN TYPE = 'DOUBLE';
----
Invalid Input Error

statement ok
DECLARE PROPERTY precision WITH $${"type": "object"}$$ AS FACT ON COLUMN WHEN TYPE IN ('double', 'DECIMAL');

statement ok
DECLARE PROPERTY identity WITH $${"type": "object"}$$ AS FACT ON COLUMN WHEN TYPE = 'bigint';

query TT
SELECT name, condition FROM properties WHERE name IN ('precision', 'identity') ORDER BY name;
----
identity	{"type":["BIGINT"]}
precision	{"type":["DOUBLE","DECIMAL"]}

statement ok
DECLARE TEST precision_test ON precision BY (AGENT, HUMAN);

statement ok
DECLARE TEST identity_test ON identity BY (AGENT, HUMAN);

query TTT
SELECT subject, property, state FROM GLOSSARY(orders) WHERE property IN ('precision', 'identity') ORDER BY subject, property;
----
fin.orders.amount	precision	missing
fin.orders.id	identity	missing
