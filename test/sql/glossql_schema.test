# name: test/sql/glossql_schema.test
# description: every body is JSON validated by a JSON Schema; definitions are views; WHEN bounds disclosure
# group: [sql]

require glossql

require json

require parquet

require ducklake

statement ok
ATTACH 'ducklake::memory:' AS ws (DATA_PATH '{TEST_DIR}/glossql_schema_lake/');

statement ok
USE ws;

statement ok
PRAGMA glossql;

statement ok
DECLARE DATASET fin SET (purpose: 'schemas');

statement ok
USE fin;

statement ok
CREATE TABLE fin.orders AS SELECT i AS id, i * 1.5 AS amount, 'c' || i AS currency_code FROM range(4) t(i);

# --- json_schema_check is a scalar function for any SQL: NULL when the document conforms

query T
SELECT json_schema_check('{"type": "object", "required": ["value"]}', '{"value": 1}');
----
NULL

query T
SELECT (json_schema_check('{"type": "object", "required": ["value"]}', '{}')) IS NOT NULL;
----
true

query T
SELECT (json_schema_check('{"type": "string"}', '42')) IS NOT NULL;
----
true

query T
SELECT (json_schema_check('{"type": "array", "items": {"enum": ["a", "b"]}, "minItems": 1}', '["a", "c"]')) IS NOT NULL;
----
true

query T
SELECT (json_schema_check('{"properties": {"n": {"type": "number", "minimum": 0, "maximum": 1}}}', '{"n": 1.5}')) IS NOT NULL;
----
true

# --- a FACT body validates against the aspect's WITH schema

statement ok
DECLARE ASPECT unit WITH $${"type": "object", "properties": {"value": {"type": "string"}, "source_column": {"type": "string"}}, "required": ["value"], "additionalProperties": false}$$ AS FACT ON COLUMN;

statement error
GLOSS unit ON orders.amount AS $${"value": 5}$$;
----
Invalid Input Error

statement error
GLOSS unit ON orders.amount AS $${"unit": "EUR"}$$;
----
Invalid Input Error

statement error
GLOSS unit ON orders.amount AS $${"value": "EUR", "note": "x"}$$;
----
Invalid Input Error

statement ok
GLOSS unit ON orders.amount AS $${"value": "EUR", "source_column": "currency_code"}$$;

# a TABLE or COLUMN grain takes loaded subjects only
statement error
GLOSS unit ON orders.nothing AS $${"value": "EUR"}$$;
----
Invalid Input Error

statement error
GLOSS unit ON nothing.amount AS $${"value": "EUR"}$$;
----
Invalid Input Error

# --- a VIEW body meets the definition contract (sql or stopped, assumptions disclosed),
# then every definition schema a kit declared; a definition is a view

statement ok
DECLARE ASPECT revenue WITH $${"title": "revenue", "description": "income from sales", "x-kind": "measure"}$$ AS VIEW;

statement error
GLOSS revenue ON fin AS $${"formula": "x"}$$;
----
Invalid Input Error

statement error
GLOSS revenue ON fin AS $${"sql": "SELECT 1", "stopped": "x"}$$;
----
Invalid Input Error

statement error
GLOSS revenue ON fin AS $${"sql": 1}$$;
----
Invalid Input Error

statement error
GLOSS revenue ON fin AS $${"sql": "SELECT 1", "assumptions": [{"basis": "guess"}]}$$;
----
Invalid Input Error

statement error
GLOSS revenue ON orders AS $${"sql": "SELECT 1"}$$;
----
Invalid Input Error

# no kit declared a definition schema yet: a key beside the contract's is admitted
statement ok
GLOSS revenue ON fin AS $${"sql": "SELECT sum(amount) AS revenue FROM fin.orders", "window": "7 days"}$$;

# a kit's definition schema is an aspect flavored x-kind definition: the engine validates every
# VIEW body against it after the contract, and refuses a schema that would strand a current value
statement error
DECLARE ASPECT definition WITH $${"x-kind": "definition", "type": "object", "additionalProperties": false, "properties": {"sql": {}, "stopped": {}, "assumptions": {}, "additivity": {"enum": ["semi-additive", "additive"]}}}$$ AS FACT ON DATASET;
----
Invalid Input Error

statement ok
GLOSS revenue ON fin AS $${"sql": "SELECT sum(amount) AS revenue FROM fin.orders", "additivity": "additive", "assumptions": [{"assumption": "amounts are net", "basis": "column_stats", "confidence": 0.9}]}$$;

statement ok
DECLARE ASPECT definition WITH $${"x-kind": "definition", "type": "object", "additionalProperties": false, "properties": {"sql": {}, "stopped": {}, "assumptions": {}, "additivity": {"enum": ["semi-additive", "additive"]}}}$$ AS FACT ON DATASET;

statement error
GLOSS revenue ON fin AS $${"sql": "SELECT 1", "additivity": "stok"}$$;
----
Invalid Input Error

statement error
GLOSS revenue ON fin AS $${"sql": "SELECT 1", "window": "7 days"}$$;
----
Invalid Input Error

query R
SELECT revenue FROM fin.revenue;
----
9.0

query T
SELECT view_name FROM duckdb_views() WHERE schema_name = 'fin';
----
revenue

query TTT
SELECT subject, aspect, value->>'additivity' FROM GLOSSARY(fin::revenue);
----
fin	revenue	additive

# a stop ends the view; the stop serves
statement ok
SET VARIABLE glossql_actor = 'human';

statement ok
GLOSS revenue ON fin AS $${"stopped": "no cost basis loaded yet"}$$;

statement ok
RESET VARIABLE glossql_actor;

query I
SELECT count(*) FROM duckdb_views() WHERE schema_name = 'fin' AND view_name = 'revenue';
----
0

query TT
SELECT subject, value FROM GLOSSARY(fin::revenue);
----
fin	{"stopped": "no cost basis loaded yet"}

# a view definition on a loaded table's name is refused
statement ok
DECLARE ASPECT orders WITH $${}$$ AS VIEW;

statement error
GLOSS orders ON fin AS $${"sql": "SELECT 1"}$$;
----
Invalid Input Error

# --- a measurement's output validates against the aspect's schema at extraction

statement ok
DECLARE ASPECT min_max WITH $${"type": "object", "required": ["min", "max"], "properties": {"min": {"type": "number"}, "max": {"type": "number"}}}$$ AS MEASUREMENT ON COLUMN;

statement ok
DECLARE FUNCTION min_max FOR GLOBAL AS $$ SELECT min(v) AS min, max(v) AS max FROM subject_column($subject) $$ RETURNS min_max;

query TTTTT
SELECT min_max() FROM orders.amount;
----
min_max	fin.orders.amount	min_max	{"min":0.0,"max":4.5}	true

statement ok
DECLARE FUNCTION lowest FOR fin AS $$ SELECT min(v) AS lowest FROM subject_column($subject) $$ RETURNS min_max;

statement error
SELECT lowest() FROM orders.amount;
----
Invalid Input Error

# --- re-declaring an aspect: identical content is a no-op, a change under glosses is refused

statement ok
DECLARE ASPECT unit WITH $${"type": "object", "properties": {"value": {"type": "string"}, "source_column": {"type": "string"}}, "required": ["value"], "additionalProperties": false}$$ AS FACT ON COLUMN;

query I
SELECT count(*) FROM aspects WHERE name = 'unit';
----
1

statement error
DECLARE ASPECT unit WITH $${"type": "object"}$$ AS FACT ON COLUMN;
----
Invalid Input Error

# a title and a description validate nothing: adding them under glosses is admitted, and so is taking them away

query I
SELECT count(*) > 0 FROM glossary WHERE aspect = 'unit';
----
true

statement ok
DECLARE ASPECT unit WITH $${"title": "Unit", "description": "The unit a column is measured in.", "type": "object", "properties": {"value": {"type": "string"}, "source_column": {"type": "string"}}, "required": ["value"], "additionalProperties": false}$$ AS FACT ON COLUMN;

query T
SELECT schema->>'description' FROM aspects WHERE name = 'unit' ORDER BY seq DESC LIMIT 1;
----
The unit a column is measured in.

# a description with any other change is a change: a key deeper in the schema, the grain

statement error
DECLARE ASPECT unit WITH $${"title": "Unit", "description": "The unit.", "type": "object", "properties": {"value": {"type": "string", "description": "the unit"}, "source_column": {"type": "string"}}, "required": ["value"], "additionalProperties": false}$$ AS FACT ON COLUMN;
----
Invalid Input Error

statement error
DECLARE ASPECT unit WITH $${"title": "Unit", "description": "The unit.", "type": "object", "properties": {"value": {"type": "string"}, "source_column": {"type": "string"}}, "required": ["value"], "additionalProperties": false}$$ AS FACT ON TABLE;
----
Invalid Input Error

statement ok
DECLARE ASPECT unit WITH $${"type": "object", "properties": {"value": {"type": "string"}, "source_column": {"type": "string"}}, "required": ["value"], "additionalProperties": false}$$ AS FACT ON COLUMN;

query II
SELECT count(*), (SELECT schema->>'description' FROM aspects WHERE name = 'unit' ORDER BY seq DESC LIMIT 1) IS NULL FROM aspects WHERE name = 'unit';
----
3	true

# --- WHEN names a sibling aspect and a value: required only while the sibling's winning value carries it

statement ok
DECLARE ASPECT role WITH $${"type": "object", "properties": {"value": {"enum": ["measure", "dimension", "key"]}}}$$ AS FACT ON COLUMN;

statement error
DECLARE ASPECT currency WITH $${"type": "object"}$$ AS FACT ON COLUMN WHEN nothing = 'measure';
----
Invalid Input Error

statement error
DECLARE ASPECT currency WITH $${"type": "object"}$$ AS FACT ON COLUMN WHEN role = 'colour';
----
Invalid Input Error

statement ok
DECLARE ASPECT currency WITH $${"type": "object"}$$ AS FACT ON COLUMN WHEN role = 'measure';

query TT
SELECT name, condition FROM aspects WHERE name = 'currency';
----
currency	{"aspect":"role","value":"measure"}

statement ok
DECLARE TEST currency_test ON currency BY (AGENT, HUMAN);

# no sibling value given: nothing required yet
query I
SELECT count(*) FROM GLOSSARY(orders::currency);
----
0

statement ok
GLOSS role ON orders.amount AS $${"value": "measure"}$$;

statement ok
GLOSS role ON orders.id AS $${"value": "key"}$$;

query TT
SELECT subject, state FROM GLOSSARY(orders::currency);
----
fin.orders.amount	missing

# writes stay gated by grain alone: a gloss outside the condition serves normally
statement ok
GLOSS currency ON orders.id AS $${"value": "none"}$$;

query TTT
SELECT subject, value, state FROM GLOSSARY(orders::currency);
----
fin.orders.amount	NULL	missing
fin.orders.id	{"value": "none"}	current

# --- WHEN TYPE names the columns' data type: required on those columns alone; the base type, DECIMAL for DECIMAL(18,2)

statement error
DECLARE ASPECT precision WITH $${"type": "object"}$$ AS FACT ON TABLE, COLUMN WHEN TYPE = 'DOUBLE';
----
Invalid Input Error

statement ok
DECLARE ASPECT precision WITH $${"type": "object"}$$ AS FACT ON COLUMN WHEN TYPE IN ('double', 'DECIMAL');

statement ok
DECLARE ASPECT identity WITH $${"type": "object"}$$ AS FACT ON COLUMN WHEN TYPE = 'bigint';

query TT
SELECT name, condition FROM aspects WHERE name IN ('precision', 'identity') ORDER BY name;
----
identity	{"type":["BIGINT"]}
precision	{"type":["DOUBLE","DECIMAL"]}

statement ok
DECLARE TEST precision_test ON precision BY (AGENT, HUMAN);

statement ok
DECLARE TEST identity_test ON identity BY (AGENT, HUMAN);

query TTT
SELECT subject, aspect, state FROM GLOSSARY(orders) WHERE aspect IN ('precision', 'identity') ORDER BY subject, aspect;
----
fin.orders.amount	precision	missing
fin.orders.id	identity	missing
