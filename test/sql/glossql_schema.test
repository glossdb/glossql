# name: test/sql/glossql_schema.test
# description: every body is JSON validated by a JSON Schema; groundings are views; WHEN bounds disclosure
# group: [sql]

require glossql

require json

require parquet

require ducklake

statement ok
ATTACH 'ducklake::memory:' AS ws (DATA_PATH '{TEST_DIR}/glossql_schema_lake/');

statement ok
USE ws;

statement ok
PRAGMA glossql;

statement ok
DECLARE DATASET fin SET (purpose: 'schemas');

statement ok
USE fin;

statement ok
CREATE TABLE fin.orders AS SELECT i AS id, i * 1.5 AS amount, 'c' || i AS currency_code FROM range(4) t(i);

# --- json_schema_check is a scalar function for any SQL: NULL when the document conforms

query T
SELECT json_schema_check('{"type": "object", "required": ["value"]}', '{"value": 1}');
----
NULL

query T
SELECT json_schema_check('{"type": "object", "required": ["value"]}', '{}');
----
at $: missing required property 'value'

query T
SELECT json_schema_check('{"type": "string"}', '42');
----
at $: expected string, got integer

query T
SELECT json_schema_check('{"type": "array", "items": {"enum": ["a", "b"]}, "minItems": 1}', '["a", "c"]');
----
at $[1]: "c" is not one of ["a","b"]

query T
SELECT json_schema_check('{"properties": {"n": {"type": "number", "minimum": 0, "maximum": 1}}}', '{"n": 1.5}');
----
at $.n: 1.5 is above the maximum 1

# --- a FACT body validates against the aspect's WITH schema

statement ok
DECLARE ASPECT unit WITH $${"type": "object", "properties": {"value": {"type": "string"}, "source_column": {"type": "string"}}, "required": ["value"], "additionalProperties": false}$$ AS FACT ON COLUMN;

statement error
GLOSS unit ON orders.amount AS $${"value": 5}$$;
----
at $.value: expected string, got integer

statement error
GLOSS unit ON orders.amount AS $${"unit": "EUR"}$$;
----
missing required property 'value'

statement error
GLOSS unit ON orders.amount AS $${"value": "EUR", "note": "x"}$$;
----
property 'note' is not allowed

statement ok
GLOSS unit ON orders.amount AS $${"value": "EUR", "source_column": "currency_code"}$$;

# a TABLE or COLUMN grain takes landed subjects only
statement error
GLOSS unit ON orders.nothing AS $${"value": "EUR"}$$;
----
names no column of fin.orders

statement error
GLOSS unit ON nothing.amount AS $${"value": "EUR"}$$;
----
names no column of fin.nothing

# --- a VIEW body meets the grounding contract (sql or stopped, assumptions disclosed),
# then every grounding schema a kit declared; a grounding is a view

statement ok
DECLARE ASPECT revenue WITH $${"title": "revenue", "description": "income from sales", "x-kind": "measure"}$$ AS VIEW;

statement error
GLOSS revenue ON fin AS $${"formula": "x"}$$;
----
grounding contract: at $: matches 0 of oneOf

statement error
GLOSS revenue ON fin AS $${"sql": "SELECT 1", "stopped": "x"}$$;
----
matches 2 of oneOf

statement error
GLOSS revenue ON fin AS $${"sql": 1}$$;
----
at $.sql: expected string

statement error
GLOSS revenue ON fin AS $${"sql": "SELECT 1", "assumptions": [{"basis": "guess"}]}$$;
----
at $.assumptions[0]: missing required property 'assumption'

statement error
GLOSS revenue ON orders AS $${"sql": "SELECT 1"}$$;
----
takes the dataset as its subject

# no kit declared a grounding schema yet: a key beside the contract's is admitted
statement ok
GLOSS revenue ON fin AS $${"sql": "SELECT sum(amount) AS revenue FROM fin.orders", "window": "7 days"}$$;

# a kit's grounding schema is an aspect flavored x-kind grounding: the engine validates every
# VIEW body against it after the contract, and refuses a schema that would strand a current slot
statement error
DECLARE ASPECT grounding WITH $${"x-kind": "grounding", "type": "object", "additionalProperties": false, "properties": {"sql": {}, "stopped": {}, "assumptions": {}, "behavior": {"enum": ["stock", "flow"]}}}$$ AS FACT ON DATASET;
----
would strand the revenue gloss on fin: at $: property 'window' is not allowed

statement ok
GLOSS revenue ON fin AS $${"sql": "SELECT sum(amount) AS revenue FROM fin.orders", "behavior": "flow", "assumptions": [{"assumption": "amounts are net", "basis": "column_stats", "confidence": 0.9}]}$$;

statement ok
DECLARE ASPECT grounding WITH $${"x-kind": "grounding", "type": "object", "additionalProperties": false, "properties": {"sql": {}, "stopped": {}, "assumptions": {}, "behavior": {"enum": ["stock", "flow"]}}}$$ AS FACT ON DATASET;

statement error
GLOSS revenue ON fin AS $${"sql": "SELECT 1", "behavior": "stok"}$$;
----
grounding schema grounding: at $.behavior

statement error
GLOSS revenue ON fin AS $${"sql": "SELECT 1", "window": "7 days"}$$;
----
grounding schema grounding: at $: property 'window' is not allowed

query R
SELECT revenue FROM fin.revenue;
----
9.0

query T
SELECT view_name FROM duckdb_views() WHERE schema_name = 'fin';
----
revenue

query TTT
SELECT subject, aspect, value->>'behavior' FROM GLOSSARY(fin::revenue);
----
fin	revenue	flow

# a stop ends the view; the stop serves
statement ok
SET VARIABLE glossql_actor = 'human';

statement ok
GLOSS revenue ON fin AS $${"stopped": "no cost basis landed yet"}$$;

statement ok
RESET VARIABLE glossql_actor;

query I
SELECT count(*) FROM duckdb_views() WHERE schema_name = 'fin' AND view_name = 'revenue';
----
0

query TT
SELECT subject, value FROM GLOSSARY(fin::revenue);
----
fin	{"stopped": "no cost basis landed yet"}

# a grounding on a landed table's name is refused
statement ok
DECLARE ASPECT orders WITH $${}$$ AS VIEW;

statement error
GLOSS orders ON fin AS $${"sql": "SELECT 1"}$$;
----
a grounding on a landed table's name is refused

# --- a measurement's output validates against the aspect's schema at extraction

statement ok
DECLARE ASPECT min_max WITH $${"type": "object", "required": ["min", "max"], "properties": {"min": {"type": "number"}, "max": {"type": "number"}}}$$ AS MEASUREMENT ON COLUMN;

statement ok
DECLARE FUNCTION min_max FOR GLOBAL AS $$ SELECT min(v) AS min, max(v) AS max FROM subject_column($subject) $$ RETURNS min_max;

query TTTTT
SELECT min_max() FROM orders.amount;
----
min_max	fin.orders.amount	min_max	{"min":0.0,"max":4.5}	true

statement ok
DECLARE FUNCTION lowest FOR fin AS $$ SELECT min(v) AS lowest FROM subject_column($subject) $$ RETURNS min_max;

statement error
SELECT lowest() FROM orders.amount;
----
does not conform to the schema of min_max

# --- re-declaring an aspect: identical content is a no-op, a change under glosses is refused

statement ok
DECLARE ASPECT unit WITH $${"type": "object", "properties": {"value": {"type": "string"}, "source_column": {"type": "string"}}, "required": ["value"], "additionalProperties": false}$$ AS FACT ON COLUMN;

query I
SELECT count(*) FROM aspects WHERE name = 'unit';
----
1

statement error
DECLARE ASPECT unit WITH $${"type": "object"}$$ AS FACT ON COLUMN;
----
has glosses: delete them before changing it

# --- WHEN names a sibling aspect and a value: owed only while the sibling's winning slot carries it

statement ok
DECLARE ASPECT role WITH $${"type": "object", "properties": {"value": {"enum": ["measure", "dimension", "key"]}}}$$ AS FACT ON COLUMN;

statement error
DECLARE ASPECT currency WITH $${"type": "object"}$$ AS FACT ON COLUMN WHEN nothing = 'measure';
----
aspect 'nothing' is not declared

statement error
DECLARE ASPECT currency WITH $${"type": "object"}$$ AS FACT ON COLUMN WHEN role = 'colour';
----
'colour' is not one of ["measure","dimension","key"]

statement ok
DECLARE ASPECT currency WITH $${"type": "object"}$$ AS FACT ON COLUMN WHEN role = 'measure';

query TT
SELECT name, condition FROM aspects WHERE name = 'currency';
----
currency	{"aspect":"role","value":"measure"}

statement ok
DECLARE TEST currency_test ON currency BY (AGENT, HUMAN);

# no sibling slot spoken: nothing owed yet
query I
SELECT count(*) FROM GLOSSARY(orders::currency);
----
0

statement ok
GLOSS role ON orders.amount AS $${"value": "measure"}$$;

statement ok
GLOSS role ON orders.id AS $${"value": "key"}$$;

query TT
SELECT subject, state FROM GLOSSARY(orders::currency);
----
fin.orders.amount	unassessed

# writes stay gated by grain alone: a gloss outside the condition serves normally
statement ok
GLOSS currency ON orders.id AS $${"value": "none"}$$;

query TTT
SELECT subject, value, state FROM GLOSSARY(orders::currency);
----
fin.orders.amount	NULL	unassessed
fin.orders.id	{"value": "none"}	current

# --- WHEN TYPE names the columns' data type: owed on those columns alone; the base type, DECIMAL for DECIMAL(18,2)

statement error
DECLARE ASPECT precision WITH $${"type": "object"}$$ AS FACT ON TABLE, COLUMN WHEN TYPE = 'DOUBLE';
----
WHEN TYPE narrows columns; aspect 'precision' is declared ON ["TABLE","COLUMN"]

statement ok
DECLARE ASPECT precision WITH $${"type": "object"}$$ AS FACT ON COLUMN WHEN TYPE IN ('double', 'DECIMAL');

statement ok
DECLARE ASPECT identity WITH $${"type": "object"}$$ AS FACT ON COLUMN WHEN TYPE = 'bigint';

query TT
SELECT name, condition FROM aspects WHERE name IN ('precision', 'identity') ORDER BY name;
----
identity	{"type":["BIGINT"]}
precision	{"type":["DOUBLE","DECIMAL"]}

statement ok
DECLARE TEST precision_test ON precision BY (AGENT, HUMAN);

statement ok
DECLARE TEST identity_test ON identity BY (AGENT, HUMAN);

query TTT
SELECT subject, aspect, state FROM GLOSSARY(orders) WHERE aspect IN ('precision', 'identity') ORDER BY subject, aspect;
----
fin.orders.amount	precision	unassessed
fin.orders.id	identity	unassessed
