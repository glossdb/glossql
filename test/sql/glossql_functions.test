# name: test/sql/glossql_functions.test
# description: functions are table macros; extraction computes them for a subject and lands measurements
# group: [sql]

require glossql

require json

require parquet

require ducklake

statement ok
ATTACH 'ducklake::memory:' AS ws (DATA_PATH '{TEST_DIR}/glossql_functions_lake/');

statement ok
USE ws;

statement ok
PRAGMA glossql;

statement ok
DECLARE DATASET fin SET (purpose: 'functions');

statement ok
USE fin;

statement ok
COPY (SELECT i AS id, 'seg' || (i % 3) AS segment, i * 1.5 AS amount FROM range(10) t(i)) TO '{TEST_DIR}/orders.csv' (HEADER);

statement ok
DECLARE SOURCE files SET (type: csv, location: '{TEST_DIR}');

statement ok
DECLARE RECIPE orders ON fin FROM files AS $$SELECT id::INTEGER AS id, segment, amount::DOUBLE AS amount FROM read_csv('orders.csv')$$;

# --- a measurement is a function with RETURNS; its body is one query over subject_column($subject)

statement ok
DECLARE ASPECT min_max WITH $${"type": "object", "properties": {"min": {}, "max": {}}}$$ AS MEASUREMENT ON COLUMN;

statement ok
DECLARE FUNCTION min_max FOR GLOBAL AS $$ SELECT min(v) AS min, max(v) AS max FROM subject_column($subject) $$ RETURNS min_max;

# an unchanged re-declaration is a no-op
query T
DECLARE FUNCTION min_max FOR GLOBAL AS $$ SELECT min(v) AS min, max(v) AS max FROM subject_column($subject) $$ RETURNS min_max;
----
function min_max unchanged: no-op

query TTTT
SELECT name, scope, returns, script LIKE '%subject_column($subject)%' FROM functions;
----
min_max	GLOBAL	min_max	true

# the function is a table macro in the lake's main schema: a UDF for any SQL
query TT
SELECT function_name, function_type FROM duckdb_functions() WHERE schema_name = 'main' AND function_name = 'min_max';
----
min_max	table_macro

query RR
SELECT min, max FROM main.min_max('fin.orders.amount');
----
0.0	13.5

# --- extraction: SELECT f() FROM subject computes at the subject and lands a measurement

query TTTTT
SELECT min_max() FROM orders.amount;
----
min_max	fin.orders.amount	min_max	{"min":0.0,"max":13.5}	true

query TTTT
SELECT dataset, function, subject, value FROM measurements;
----
fin	min_max	fin.orders.amount	{"min":0.0,"max":13.5}

# one row and one column is the value; many rows are an array of row objects

statement ok
DECLARE ASPECT row_count WITH $${"type": "integer"}$$ AS MEASUREMENT ON COLUMN;

statement ok
DECLARE FUNCTION row_count FOR fin AS $$ SELECT count(*) AS n FROM subject_column($subject) $$ RETURNS row_count;

statement ok
DECLARE ASPECT tops WITH $${"type": "array"}$$ AS MEASUREMENT ON COLUMN;

statement ok
DECLARE FUNCTION tops FOR fin AS $$ SELECT v, count(*) AS n FROM subject_column($subject) GROUP BY v ORDER BY n DESC, v LIMIT 2 $$ RETURNS tops;

# extraction is the whole statement; many calls land in call order
query TTTTT
SELECT row_count(), tops() FROM orders.segment;
----
row_count	fin.orders.segment	row_count	10	true
tops	fin.orders.segment	tops	[{"v":"seg0","n":4},{"v":"seg1","n":3}]	true

query I
SELECT count(*) FROM measurements;
----
3

# a dataset function lives in the dataset's schema
query T
SELECT function_name FROM duckdb_functions() WHERE schema_name = 'fin' AND function_type = 'table_macro' ORDER BY 1;
----
row_count
tops

query I
SELECT n FROM fin.row_count('orders.id');
----
10

# --- what is not an extraction

# an extraction names declared functions only
statement error
SELECT min_max(), nothing() FROM orders.amount;
----
not a declared function

# a column is a subject, never a relation: a call on one that names no declared function is refused as one
statement error
SELECT nothing() FROM orders.amount;
----
nothing() is no declared function over fin.orders.amount

# a SELECT of zero-argument calls over a table that names no glossql function is plain SQL
query I
SELECT count() FROM orders;
----
10

query I
SELECT count() FROM orders
----
10

# the end of the statement is the terminator too, with more statements after it
query I
SELECT count() FROM fin.orders; SELECT 1;
----
10

query T
SELECT json_serialize_sql('SELECT nothing() FROM orders')::JSON->>'error' AS err;
----
false

# a SELECT with anything after the subject is plain SQL
query I
SELECT count() FROM orders WHERE id > 5;
----
4

# a detector has no RETURNS and runs at read, never through extraction
statement ok
DECLARE FUNCTION bands FOR fin AS $$ SELECT subject, 'green' AS band, 0.0 AS score FROM slots GROUP BY subject $$;

statement error
SELECT bands() FROM orders.amount;
----
is a detector

statement error
DECLARE FUNCTION x FOR nowhere AS $$ SELECT 1 $$ RETURNS min_max;
----
dataset 'nowhere' is not declared

query T
SELECT trim(script) FROM functions WHERE name = 'bands';
----
SELECT subject, 'green' AS band, 0.0 AS score FROM slots GROUP BY subject
