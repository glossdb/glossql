# name: test/sql/glossql_views.test
# description: a view counts as a table (SPEC §3) — a definition's view and its columns are subjects, glossed, measured and required like a table's; the view's definition is the shape its glosses age by and a part of what is measured over it
# group: [sql]

require glossql

require json

require parquet

require ducklake

statement ok
ATTACH 'ducklake::memory:' AS ws (DATA_PATH '{TEST_DIR}/glossql_views_lake/');

statement ok
USE ws;

statement ok
PRAGMA glossql;

statement ok
DECLARE DATASET fin SET (purpose: 'views');

statement ok
USE fin;

statement ok
CREATE TABLE fin.t (d DATE, a DOUBLE, k VARCHAR);

statement ok
INSERT INTO fin.t VALUES (DATE '2024-01-01', 1, 'x'), (DATE '2024-02-01', 2, 'y');

statement ok
DECLARE PROPERTY role WITH $${"type": "object", "required": ["value"], "properties": {"value": {"enum": ["key", "measure", "dimension", "timestamp", "attribute"]}}}$$ AS FACT ON COLUMN;

statement ok
DECLARE PROPERTY entity WITH $${"type": "object"}$$ AS FACT ON TABLE;

statement ok
DECLARE PROPERTY spend WITH $${"title": "Spend"}$$ AS VIEW;

statement ok
GLOSS spend ON fin AS $${"sql": "SELECT d AS period, a AS value FROM fin.t"}$$;

# --- the view's columns are subjects: relative or qualified, in the catalog's spelling

statement ok
GLOSS role ON spend.VALUE AS $${"value": "measure"}$$;

statement ok
GLOSS role ON fin.spend.period AS $${"value": "timestamp"}$$;

# the view itself is a table's subject

statement ok
GLOSS entity ON spend AS $${"value": "spend by period"}$$;

# a column the view does not serve is refused as a table's would be

statement error
GLOSS role ON spend.amount AS $${"value": "measure"}$$;
----
Invalid Input Error

query TTT
SELECT subject, property, state FROM GLOSSARY(spend) ORDER BY subject, property;
----
fin.spend	entity	current
fin.spend.period	role	current
fin.spend.value	role	current

# --- measured like a table's column, and served while the view and what it reads are unchanged

statement ok
DECLARE PROPERTY min_max WITH $${"type": "object", "properties": {"min": {}, "max": {}}}$$ AS MEASUREMENT ON COLUMN;

statement ok
DECLARE FUNCTION min_max FOR GLOBAL AS $$ SELECT min(v) AS min, max(v) AS max FROM subject_column($subject) $$ RETURNS min_max;

query TTTTT
SELECT min_max() FROM spend.value;
----
min_max	fin.spend.value	min_max	{"min":1.0,"max":2.0}	true

# it read the data of its subject: the view at the definition it holds and the stored lineage that walked
# to the table behind it, and that table

query T
SELECT (SELECT string_agg(i.asset || ' ' || i.what, ',' ORDER BY i.asset, i.what) FROM inputs i WHERE i.begin_snapshot = m.begin_snapshot) FROM results m WHERE m.function = 'min_max';
----
fin.spend definition,fin.spend result lineage,fin.t data,min_max function,min_max property

query TTTTT
SELECT min_max() FROM spend.value;
----
min_max	fin.spend.value	min_max	{"min":1.0,"max":2.0}	false

# a load into the table behind the view reruns it

statement ok
INSERT INTO fin.t VALUES (DATE '2024-03-01', 5, 'z');

query TTTTT
SELECT min_max() FROM spend.value;
----
min_max	fin.spend.value	min_max	{"min":1.0,"max":5.0}	true

# the same sql glossed again keeps the view and the column's gloss current; the annotation that defines
# the view is written, so a result that read the view computes again

statement ok
GLOSS spend ON fin AS $${"sql": "SELECT d AS period, a AS value FROM fin.t", "assumptions": [{"assumption": "a is net of tax"}]}$$;

query TTTTT
SELECT min_max() FROM spend.value;
----
min_max	fin.spend.value	min_max	{"min":1.0,"max":5.0}	true

query TT
SELECT subject, state FROM GLOSSARY(spend.value::role);
----
fin.spend.value	current

# --- other sql is a new definition: the measurement reruns, and the glosses on the view and its columns read stale

statement ok
GLOSS spend ON fin AS $${"sql": "SELECT d AS period, a * 2 AS value FROM fin.t"}$$;

query TTTTT
SELECT min_max() FROM spend.value;
----
min_max	fin.spend.value	min_max	{"min":2.0,"max":10.0}	true

query TTT
SELECT subject, property, state FROM GLOSSARY(spend) WHERE property IN ('role', 'entity') ORDER BY subject, property;
----
fin.spend	entity	stale
fin.spend.period	role	stale
fin.spend.value	role	stale

# glossed again, the value is current at the new definition

statement ok
GLOSS role ON spend.value AS $${"value": "measure"}$$;

query TT
SELECT subject, state FROM GLOSSARY(spend.value::role);
----
fin.spend.value	current

# --- a view over the view: its data is both views' and the table's

statement ok
DECLARE PROPERTY spend_total WITH $${"title": "Spend, total"}$$ AS VIEW;

statement ok
GLOSS spend_total ON fin AS $${"sql": "SELECT sum(value) AS value FROM (SELECT * FROM spend) s"}$$;

query TTTTT
SELECT min_max() FROM spend_total.value;
----
min_max	fin.spend_total.value	min_max	{"min":16.0,"max":16.0}	true

query T
SELECT (SELECT string_agg(i.asset || ' ' || i.what, ',' ORDER BY i.asset, i.what) FROM inputs i WHERE i.begin_snapshot = m.begin_snapshot) FROM results m ORDER BY begin_snapshot DESC LIMIT 1;
----
fin.spend definition,fin.spend result lineage,fin.spend_total definition,fin.spend_total result lineage,fin.t data,min_max function,min_max property

statement ok
GLOSS spend ON fin AS $${"sql": "SELECT d AS period, a AS value FROM fin.t"}$$;

query TTTTT
SELECT min_max() FROM spend_total.value;
----
min_max	fin.spend_total.value	min_max	{"min":8.0,"max":8.0}	true

# --- a view's rows are kept once per store version: the cells read serves them; a write to its table
# and a re-gloss each move the version
query I
SELECT count(*) FROM dataset_cells('fin', true) WHERE "table" = 'spend';
----
6

statement ok
INSERT INTO fin.t VALUES (DATE '2024-04-01', 7, 'w');

query IR
SELECT count(*), sum(TRY_CAST(val AS DOUBLE)) FILTER (WHERE "column" = 'value') FROM dataset_cells('fin', true) WHERE "table" = 'spend';
----
8	15.0

statement ok
GLOSS spend ON fin AS $${"sql": "SELECT d AS period, a * 2 AS value FROM fin.t"}$$;

query R
SELECT sum(TRY_CAST(val AS DOUBLE)) FROM dataset_cells('fin', true) WHERE "table" = 'spend' AND "column" = 'value';
----
30.0

# 'views' takes the views alone
query II
SELECT count(DISTINCT "table") FILTER (WHERE "table" IN ('spend', 'spend_total')), count(*) FILTER (WHERE "table" = 't')
FROM dataset_cells('fin', 'views');
----
2	0

statement error
SELECT * FROM dataset_cells('fin', 'some');
----
Invalid Input Error

# --- a stop drops the view: its columns' glosses read stale, and a new gloss on them is refused

statement ok
GLOSS spend ON fin AS $${"stopped": "retired"}$$;

query TT
SELECT subject, state FROM GLOSSARY(spend.value::role);
----
fin.spend.value	stale

statement error
GLOSS role ON spend.period AS $${"value": "timestamp"}$$;
----
Invalid Input Error
