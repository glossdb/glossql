statement ok
SELECT metric_forecast() FROM fin;

# the other metrics got no point from the stand-in; sales its twelve steps and two totals, each once,
# though both month bodies answered the service's coverage at the month
query TTT
SELECT metric, applicable, reason FROM glossql.forecast_points() WHERE metric <> 'sales' ORDER BY metric;
----
balance	false	the service answered no point for this metric
hires	false	the service answered no point for this metric
spend	false	the service answered no point for this metric

query I
SELECT count(*) FROM glossql.forecast_points() WHERE metric = 'sales';
----
14

query IIITTRRRRT
SELECT point_seq, step, span, to_go, period, p10, p50, p90, held_80, held_from FROM glossql.forecast_points() WHERE metric = 'sales' AND point_seq IN (0, 2, 12, 13) ORDER BY point_seq;
----
0	1	NULL	NULL	2025-03-01	80.0	100.0	120.0	0.8	service
2	3	NULL	NULL	2025-05-01	80.0	100.0	120.0	NULL	NULL
12	1	1	quarter	2025-03-01	80.0	100.0	120.0	0.79	service
13	10	10	year	2025-12-01	1000.0	1100.0	1400.0	0.79	service

query TTTT
SELECT grain, origin, served_by, current FROM glossql.forecast_points() WHERE metric = 'sales' LIMIT 1;
----
month	2025-02-01	glossthesi test	true

# nothing has landed past the origin: the record tallies no point yet, and says so with no row
query I
SELECT count(*) FROM glossql.forecast_coverage();
----
0

# the forecast world: the medians at the forecast's grain, under the metric
query TTIR
SELECT metric, world, count(*), any_value(value) FROM glossql.metric_series(world := 'forecast', grain := 'month') GROUP BY ALL;
----
sales	forecast	12	100.0

# --- the plan: a QUERY aspect with x-kind plan and x-plan-of, read through the metric it plans

statement ok
DECLARE ASPECT sales_budget WITH $${"title": "Sales budget", "x-kind": "plan", "x-plan-of": "sales"}$$ AS QUERY;

# declared and not grounded: no fact row yet, as for a metric; the plan goal asks for the grounding
query I
SELECT count(*) FROM glossql.metric_axes() WHERE metric = 'sales_budget';
----
0

statement ok
GLOSS sales_budget ON fin AS $${"sql": "SELECT month AS period, planned AS value FROM fin.budget"}$$;

query TTTTTT
SELECT metric, plan_of, applicable, period_column, value_column, behavior FROM glossql.metric_axes() WHERE metric = 'sales_budget';
----
sales_budget	sales	true	period	value	flow

# a plan is no metric of the actual world, and neither the walk nor the forecast reads it
query I
SELECT count(*) FROM glossql.metric_series(grain := 'month') WHERE metric = 'sales_budget';
----
0

query I
SELECT count(*) FROM glossql.band_request() WHERE metric = 'sales_budget';
----
0

query TTIR
SELECT metric, world, count(*), sum(value) FROM glossql.metric_series(world := 'plan', plan := 'sales_budget', grain := 'month') GROUP BY ALL;
----
sales	plan	12	2120.0

query TR
SELECT period::DATE, value FROM glossql.metric_series(world := 'plan', plan := 'sales_budget', grain := 'year');
----
2025-01-01	2120.0

query I
SELECT count(*) FROM glossql.metric_series(world := 'plan', plan := 'sales_budget', grain := 'day');
----
0

statement error
SELECT * FROM glossql.metric_series(world := 'plan', grain := 'month');
----
names the plan it serves

statement error
SELECT * FROM glossql.metric_series(world := 'plan', plan := 'nothing');
----
no aspect of that name is declared

statement error
SELECT * FROM glossql.metric_series(world := 'plan', plan := 'sales');
----
sales is no plan

statement error
SELECT * FROM glossql.metric_series(world := 'dream');
----
the worlds are actual, plan, forecast and scenario

# plan_points(): the year first — whole, begun, not complete: the actual to date plus the year to go bands it; then the months,
# landed through the origin with their variance, the rest against their own step's band
query TTTRRRRRRTTRT
SELECT grain, label, period::DATE, value, actual, variance, low, expected, high, stands, covers, held_80, origin
FROM glossql.plan_points() WHERE plan = 'sales_budget' AND (grain = 'year' OR label IN ('2025-01', '2025-02', '2025-03', '2025-04', '2025-12'))
ORDER BY CASE grain WHEN 'year' THEN 0 ELSE 1 END, period;
----
year	2025	2025-01-01	2120.0	141.0	NULL	1141.0	1241.0	1541.0	above	NULL	0.79	2025-02-01
month	2025-01	2025-01-01	120.0	124.0	4.0	NULL	NULL	NULL	landed	NULL	NULL	NULL
month	2025-02	2025-02-01	10.0	17.0	7.0	NULL	NULL	NULL	landed	NULL	NULL	NULL
month	2025-03	2025-03-01	90.0	NULL	NULL	80.0	100.0	120.0	inside	NULL	0.8	2025-02-01
month	2025-04	2025-04-01	200.0	NULL	NULL	80.0	100.0	120.0	above	NULL	0.8	2025-02-01
month	2025-12	2025-12-01	1000.0	NULL	NULL	80.0	100.0	120.0	above	NULL	NULL	2025-02-01

query I
SELECT count(*) FROM glossql.plan_points() WHERE plan = 'sales_budget';
----
13

# --- the judgement lands on the plan: wanted on its row until one stands, measured over it, witnessed; the routes read it
query T
SELECT wanted FROM glossql.metric_axes() WHERE metric = 'sales_budget';
----
[metric_plan over fin.sales_budget]

statement ok
SELECT metric_plan() FROM fin.sales_budget;

query T
SELECT wanted FROM glossql.metric_axes() WHERE metric = 'sales_budget';
----
[]

query TTTTI
SELECT plan, metric, plan_grain, forecast_run = (SELECT max(seq) FROM glossql.measurements WHERE function = 'metric_forecast'), count(*)
FROM glossql.plan_record() GROUP BY ALL;
----
sales_budget	sales	month	true	13

query TTR
SELECT label, stands, value FROM glossql.plan_record() WHERE stands IN ('below', 'above')
ORDER BY CASE grain WHEN 'year' THEN 0 ELSE 1 END, period;
----
2025	above	2120.0
2025-04	above	200.0
2025-12	above	1000.0

query TTTR
SELECT subject, witness, band, round(score, 2) FROM ATTEST() WHERE witness = 'plan_w';
----
fin.sales_budget	plan_w	red	0.27

# a change to what the judgement read owes it again
statement ok
INSERT INTO fin.ledger VALUES (DATE '2025-02-05', 2.0, 'water');

query T
SELECT current FROM ATTEST() WHERE witness = 'plan_w';
----
false

statement ok
SELECT metric_plan() FROM fin.sales_budget;

query IT
SELECT count(*), bool_and(current) FROM glossql.measurements m, ATTEST() a WHERE m.function = 'metric_plan' AND a.witness = 'plan_w';
----
2	true

# the routes judge the plan from the record: the judgement asked for, asked again, then the gap
query III
SELECT count(*) FILTER (WHERE arms LIKE '%''plan'', 7, ''next'', ''metric_plan''%'),
       count(*) FILTER (WHERE arms LIKE '%''plan'', 8, ''next'', ''metric_plan''%'),
       count(*) FILTER (WHERE arms LIKE '%''plan'', 9, ''next'', ''GLOSS scenario''%')
FROM glossql.routes_futures();
----
1	1	1

# --- the scenario: a lever on a column of a metric's view, a scenario of a factor per period, the estimate ahead from the service

statement ok
DECLARE ASPECT priced WITH $${"title": "Priced spend"}$$ AS QUERY;

statement ok
GLOSS priced ON fin AS $${"sql": "SELECT booked AS period, amount AS value, 10.0 + amount / 10 AS price FROM fin.ledger"}$$;

statement ok
GLOSS role ON priced.period AS $${"value": "timestamp"}$$;

statement ok
GLOSS role ON priced.value AS $${"value": "measure"}$$;

statement ok
SELECT temporal() FROM priced.period;

statement ok
GLOSS behavior ON priced.value AS $${"value": "flow"}$$;

statement ok
DECLARE ASPECT price_up WITH $${"title": "Price +10% in February", "x-kind": "scenario", "type": "object", "required": ["levers"], "properties": {"levers": {"type": "array"}}}$$ AS FACT ON DATASET;

# declared and not glossed
query TTTT
SELECT scenario, glossed, applicable, reason FROM glossql.scenarios();
----
price_up	false	false	declared and not glossed: a scenario is a factor per period on declared levers

# a lever nobody glossed refuses the scenario at read
statement ok
GLOSS price_up ON fin AS $${"levers": [{"column": "priced.price", "factor": {"2025-02": 1.1}, "basis": "the February price list"}]}$$;

query TT
SELECT applicable, reason FROM glossql.scenarios();
----
false	priced.price carries no lever gloss: a lever is a column someone sets, glossed lever true on the metric's view

statement ok
GLOSS lever ON priced.price AS $${"value": true, "grounds": "the list price, set each quarter"}$$;

query TTT
SELECT applicable, reason, len(levers) FROM glossql.scenarios();
----
true	NULL	1

# the reach: priced runs daily, its last actual 2025-02-05; the scenario names February, so 23 days ahead
query TTTTII
SELECT scenario, metric, grain, origin::DATE, history, len(ahead) FROM glossql.scenario_request();
----
price_up	priced	day	2025-02-05	402	23

# a scenario whose factors are all one, or whose lever stands at nothing, moves no input: judged, never sent
statement ok
DECLARE ASPECT price_flat WITH $${"title": "Prices held", "x-kind": "scenario", "type": "object", "required": ["levers"], "properties": {"levers": {"type": "array"}}}$$ AS FACT ON DATASET;

statement ok
GLOSS price_flat ON fin AS $${"levers": [{"column": "priced.price", "factor": {"2025-02": 1.0}, "basis": "nothing changes"}]}$$;

query TTT
SELECT scenario, applicable, reason FROM glossql.scenario_request() WHERE scenario = 'price_flat';
----
price_flat	false	the scenario moves no input of priced: every factor on priced.price over the periods ahead is one

query I
SELECT count(*) FROM glossql.scenario_bodies() WHERE body IS NOT NULL;
----
1

# the request: the history, then each day ahead twice; the lever held at its last value as planned, times the factor under the scenario
query TITTRR
SELECT metric, json_array_length(json_extract(body, '/table/member')), json_extract_string(body, '/table/status/402'), json_extract_string(body, '/table/status/403'),
       json_extract(body, '/table/priced.price/402')::DOUBLE, round(json_extract(body, '/table/priced.price/403')::DOUBLE, 2)
FROM glossql.scenario_bodies();
----
priced	448	plan	scenario	10.2	11.22

query TR
SELECT json_extract_string(body, '/table/period/401'), json_extract(body, '/table/priced.price/401')::DOUBLE FROM glossql.scenario_bodies();
----
2025-02-05	10.2

# with the lever's forecast as the planned input: its median where it reaches, its last median past that
query RRRR
SELECT json_extract(body, '/table/priced.price/402')::DOUBLE, round(json_extract(body, '/table/priced.price/403')::DOUBLE, 2),
       json_extract(body, '/table/priced.price/406')::DOUBLE, round(json_extract(body, '/table/priced.price/407')::DOUBLE, 2)
FROM glossql.scenario_bodies(paths := '{"price_up|priced|priced.price": [{"period": "2025-02-06", "value": 10.5}, {"period": "2025-02-07", "value": 10.6}]}');
----
10.5	11.55	10.6	11.66

# the lever's own forecast request: the series as the member, 23 days ahead within the day grain's reach of 31
query TTTIIT
SELECT lever, grain, horizon, json_array_length(json_extract(body, '/table/member')), json_extract(body, '/spec/horizon')::INTEGER, json_extract_string(body, '/table/status/402')
FROM glossql.lever_bodies();
----
priced.price	day	23	425	23	forecast

statement ok
CREATE OR REPLACE MACRO glossql.service_soft(route, body) AS '{"table":{"member":["priced.price","priced.price","priced.price"],"step":[1,2,3],"period":["2025-02-06","2025-02-07","2025-02-08"],"column":["value","value","value"],"level":[0.5,0.5,0.5],"value":[10.5,10.6,10.7]},"answer":{"service":"glossthesi","version":"test","errors":[],"coverage":[]}}'::JSON;

statement ok
CREATE OR REPLACE MACRO glossql.service(route, body) AS '{"table":{"member":["priced","priced","priced","priced","priced","priced","priced","priced","priced"],"period":["2025-02-06","2025-02-06","2025-02-06","2025-02-07","2025-02-07","2025-02-07","2025-02-08","2025-02-08","2025-02-08"],"column":["value","value","value","value","value","value","value","value","value"],"status":["scenario","scenario","scenario","scenario","scenario","scenario","scenario","scenario","scenario"],"level":[0.1,0.5,0.9,0.1,0.5,0.9,0.1,0.5,0.9],"value":[4.0,5.0,6.0,4.1,5.1,6.1,4.2,5.2,6.2],"history_value":[5.5,5.5,5.5,5.6,5.6,5.6,5.7,5.7,5.7],"history_low":[5.0,5.0,5.0,5.0,5.0,5.0,5.0,5.0,5.0],"history_high":[6.0,6.0,6.0,6.0,6.0,6.0,6.0,6.0,6.0],"sign":["+","+","+","+","+","+","+","+","+"],"confidence":["direction","direction","direction","direction","direction","direction","direction","direction","direction"],"basis":["the history shows spend up where the price was higher","the history shows spend up where the price was higher","the history shows spend up where the price was higher","the history shows spend up where the price was higher","the history shows spend up where the price was higher","the history shows spend up where the price was higher","the history shows spend up where the price was higher","the history shows spend up where the price was higher","the history shows spend up where the price was higher"],"explains":[0.4,0.4,0.4,0.4,0.4,0.4,0.4,0.4,0.4],"error":[1.5,1.5,1.5,1.5,1.5,1.5,1.5,1.5,1.5]},"answer":{"service":"glossthesi","version":"test","errors":[],"changed":["priced.price"],"parts":[{"member":"priced","column":"value","input":"priced.price","history_shift":0.5,"history_low":0.2,"history_high":0.8}]}}'::JSON;

statement ok
SELECT metric_scenario() FROM fin;

query TTTITRRRTT
SELECT scenario, metric, grain, step, period::DATE, low, value, high, sign, confidence FROM glossql.scenario_points('price_up');
----
price_up	priced	day	1	2025-02-06	4.0	5.0	6.0	+	direction
price_up	priced	day	2	2025-02-07	4.1	5.1	6.1	+	direction
price_up	priced	day	3	2025-02-08	4.2	5.2	6.2	+	direction

query TTTRRR
SELECT metric, lever, planned_from, history_shift, history_low, history_high FROM glossql.scenario_levers('price_up');
----
priced	priced.price	forecast	0.5	0.2	0.8

# the scenario world under the metric: the estimate's medians ahead
query TTIR
SELECT metric, world, count(*), sum(value) FROM glossql.metric_series(world := 'scenario', scenario := 'price_up') GROUP BY ALL;
----
priced	scenario	3	15.3

statement error
SELECT * FROM glossql.metric_series(world := 'scenario');
----
names the scenario it serves

statement error
SELECT * FROM glossql.metric_series(world := 'scenario', scenario := 'nothing');
----
no scenario of that name is declared

query TTTT
SELECT subject, witness, band, current FROM ATTEST() WHERE witness = 'scenario_w';
----
fin	scenario_w	green	true

# a lever whose forecast the service refuses is held, and the estimate stands
statement ok
CREATE OR REPLACE MACRO glossql.service_soft(route, body) AS '{"error": "the service answered 422 on /forecast: 3 periods of history, a forecast needs 6"}'::JSON;

statement ok
INSERT INTO fin.ledger VALUES (DATE '2025-02-06', 4.0, 'parks');

statement ok
SELECT metric_scenario() FROM fin;

query TT
SELECT lever, planned_from FROM glossql.scenario_levers('price_up');
----
priced.price	held: the service answered 422 on /forecast: 3 periods of history, a forecast needs 6

# a lever that stands at nothing as planned — held at zero, its forecast refused — moves nothing: judged in the measurement, no call
statement ok
GLOSS priced ON fin AS $${"sql": "SELECT booked AS period, amount AS value, 10.0 + amount / 10 AS price, CASE WHEN booked >= DATE '2025-02-01' THEN 0.0 ELSE 1.0 END AS promo FROM fin.ledger"}$$;

statement ok
GLOSS lever ON priced.promo AS $${"value": true, "grounds": "the promotion flag"}$$;

statement ok
DECLARE ASPECT promo_on WITH $${"title": "Promotion doubled", "x-kind": "scenario", "type": "object", "required": ["levers"], "properties": {"levers": {"type": "array"}}}$$ AS FACT ON DATASET;

statement ok
GLOSS promo_on ON fin AS $${"levers": [{"column": "priced.promo", "factor": {"2025-02": 2.0}, "basis": "twice the promotion"}]}$$;

query TTT
SELECT scenario, applicable, reason FROM glossql.scenario_request() WHERE scenario = 'promo_on';
----
promo_on	true	NULL

query TT
SELECT scenario, unmoved FROM glossql.scenario_bodies() WHERE scenario = 'promo_on';
----
promo_on	priced.promo stands at 0.0 as planned over the periods ahead, and a factor on nothing is nothing

statement ok
SELECT metric_scenario() FROM fin;

query TTTT
SELECT scenario, metric, applicable, reason FROM glossql.scenario_points('promo_on');
----
promo_on	priced	false	the scenario moves no input of priced: priced.promo stands at 0.0 as planned over the periods ahead, and a factor on nothing is nothing

# the routes: the estimate asked for, asked again, and the gap judged under the scenario
query III
SELECT count(*) FILTER (WHERE arms LIKE '%''plan'', 10, ''next'', ''metric_scenario''%'),
       count(*) FILTER (WHERE arms LIKE '%''plan'', 11, ''next'', ''metric_scenario''%'),
       count(*) FILTER (WHERE arms LIKE '%''plan'', 12, ''next'', ''GLOSS plan''%')
FROM glossql.routes_futures();
----
1	1	1
