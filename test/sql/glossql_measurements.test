# name: test/sql/glossql_measurements.test
# description: a measurement is stored at its data version with what it read; a later extraction serves it while those reads are unchanged, and a function annotation is current while they are
# group: [sql]

require glossql

require json

require parquet

require ducklake

statement ok
ATTACH 'ducklake::memory:' AS ws (DATA_PATH '{TEST_DIR}/glossql_measurements_lake/');

statement ok
USE ws;

statement ok
PRAGMA glossql;

statement ok
DECLARE DATASET fin SET (purpose: 'measurements');

statement ok
USE fin;

statement ok
CREATE TABLE fin.orders AS SELECT i AS id, i * 1.5 AS amount FROM range(4) t(i);

statement ok
CREATE TABLE fin.other AS SELECT 1 AS x;

statement ok
DECLARE ASPECT min_max WITH $${"type": "object", "properties": {"min": {}, "max": {}}}$$ AS MEASUREMENT ON COLUMN;

statement ok
DECLARE FUNCTION min_max FOR GLOBAL AS $$ SELECT min(v) AS min, max(v) AS max FROM subject_column($subject) $$ RETURNS min_max;

# --- extraction stores the row with what it read: one row per input, at its version now

query TTTTT
SELECT min_max() FROM orders.amount;
----
min_max	fin.orders.amount	min_max	{"min":0.0,"max":4.5}	true

# reads names what the body read, by name; inputs holds each at its version, a table's the
# last snapshot that wrote it
query TT
SELECT i.input, i.version = (SELECT max(snapshot_id)::VARCHAR FROM ducklake_snapshots('ws') s WHERE list_contains(map_keys(s.changes), 'tables_created') AND list_contains(s.changes['tables_created'], 'fin.orders'))
FROM measurements m JOIN inputs i USING (begin_snapshot);
----
fin.orders	true

# --- a repeat is a serve, not a rerun

query TTTTT
SELECT min_max() FROM orders.amount;
----
min_max	fin.orders.amount	min_max	{"min":0.0,"max":4.5}	false

query I
SELECT count(*) FROM measurements;
----
1

# a write the body never reads is not its staleness: another table, the glossary

statement ok
INSERT INTO fin.other VALUES (2);

statement ok
DECLARE ASPECT note WITH $${"type": "object"}$$ AS FACT ON COLUMN;

statement ok
GLOSS note ON orders.amount AS $${"text": "loaded"}$$;

query TTTTT
SELECT min_max() FROM orders.amount;
----
min_max	fin.orders.amount	min_max	{"min":0.0,"max":4.5}	false

# --- one of its reads moving makes the next extraction compute; old rows stay as the drift record

statement ok
INSERT INTO fin.orders VALUES (9, 9.0);

query TTTTT
SELECT min_max() FROM orders.amount;
----
min_max	fin.orders.amount	min_max	{"min":0.0,"max":9.0}	true

query TT
SELECT value, (SELECT string_agg(i.input, ',' ORDER BY i.input) FROM inputs_history i WHERE i.begin_snapshot = m.begin_snapshot) FROM measurements_history m ORDER BY begin_snapshot;
----
{"min":0.0,"max":4.5}	fin.orders
{"min":0.0,"max":9.0}	fin.orders

# a re-declared function is never served from a measurement of its older body

statement ok
DECLARE FUNCTION min_max FOR GLOBAL AS $$ SELECT min(v) AS min, max(v) + 1 AS max FROM subject_column($subject) $$ RETURNS min_max;

query TTTTT
SELECT min_max() FROM orders.amount;
----
min_max	fin.orders.amount	min_max	{"min":0.0,"max":10.0}	true

# --- the store relations are parts too: a body that reads the glossary moves with it

statement ok
DECLARE ASPECT notes WITH $${"type": "integer"}$$ AS MEASUREMENT ON COLUMN;

statement ok
DECLARE FUNCTION notes FOR fin AS $$ SELECT count(*) AS n FROM main.glossary g WHERE g.subject = $subject AND g.aspect = 'note' $$ RETURNS notes;

query TTTTT
SELECT notes() FROM orders.amount;
----
notes	fin.orders.amount	notes	1	true

query T
SELECT (SELECT string_agg(i.input, ',' ORDER BY i.input) FROM inputs i WHERE i.begin_snapshot = m.begin_snapshot) FROM measurements m WHERE function = 'notes';
----
main.glossary/note

statement ok
INSERT INTO fin.orders VALUES (10, 10.0);

query TTTTT
SELECT notes() FROM orders.amount;
----
notes	fin.orders.amount	notes	1	false

statement ok
GLOSS note ON orders.amount AS $${"text": "loaded again"}$$;

# the annotation replaced the agent's earlier one: one current row, and the result is computed again
query TTTTT
SELECT notes() FROM orders.amount;
----
notes	fin.orders.amount	notes	1	true

# --- a body that reads nothing is current for ever; one whose reads cannot be named is current at its exact data version

statement ok
DECLARE ASPECT answer WITH $${"type": "integer"}$$ AS MEASUREMENT ON COLUMN;

statement ok
DECLARE FUNCTION answer FOR fin AS $$ SELECT 42 AS n FROM range(1) $$ RETURNS answer;

statement ok
DECLARE ASPECT tables WITH $${"type": "integer"}$$ AS MEASUREMENT ON COLUMN;

statement ok
DECLARE FUNCTION tables FOR fin AS $$ SELECT count(*) AS n FROM duckdb_tables() WHERE schema_name = split_part($subject, '.', 1) $$ RETURNS tables;

query TTTTT
SELECT answer(), tables() FROM orders.amount;
----
answer	fin.orders.amount	answer	42	true
tables	fin.orders.amount	tables	2	true

query TT
SELECT function, (SELECT string_agg(i.input, ',' ORDER BY i.input) FROM inputs i WHERE i.begin_snapshot = m.begin_snapshot) FROM measurements m WHERE function IN ('answer', 'tables') ORDER BY function;
----
answer	NULL
tables	fin.**

statement ok
INSERT INTO fin.other VALUES (3);

query TTTTT
SELECT answer(), tables() FROM orders.amount;
----
answer	fin.orders.amount	answer	42	false
tables	fin.orders.amount	tables	2	true

# ** moves with the store too

statement ok
GLOSS note ON orders.amount AS $${"text": "third"}$$;

query TTTTT
SELECT answer(), tables() FROM orders.amount;
----
answer	fin.orders.amount	answer	42	false
tables	fin.orders.amount	tables	2	true

query TTTTT
SELECT tables() FROM orders.amount;
----
tables	fin.orders.amount	tables	2	false

# --- a body that carries a top-level summary serves the summary; the whole value is stored

statement ok
DECLARE ASPECT profile WITH $${"type": "object", "required": ["summary", "detail"]}$$ AS MEASUREMENT ON COLUMN;

statement ok
DECLARE FUNCTION profile FOR fin AS $$ SELECT {'n': count(*)} AS summary, list(v ORDER BY v) AS detail FROM subject_column($subject) $$ RETURNS profile;

query TTTTT
SELECT profile() FROM orders.amount;
----
profile	fin.orders.amount	profile	{"n":6}	true

query T
SELECT value FROM measurements WHERE function = 'profile';
----
{"summary":{"n":6},"detail":[0.0,1.5,3.0,4.5,9.0,10.0]}

query TT
SELECT aspect, value FROM GLOSSARY(orders.amount::profile);
----
profile	{"summary":{"n":6},"detail":[0.0,1.5,3.0,4.5,9.0,10.0]}

# --- a function annotation is current while what it read is unchanged, and the result says so

statement ok
DECLARE FUNCTION all_current FOR fin AS $$ SELECT subject, CASE WHEN bool_and(current) THEN 'green' ELSE 'red' END AS state, 0.0 AS score FROM annotations GROUP BY subject $$;

statement ok
DECLARE TEST min_max_test ON min_max DETECTOR all_current THRESHOLD 0.5;

query TTTTT
SELECT min_max() FROM orders.amount;
----
min_max	fin.orders.amount	min_max	{"min":0.0,"max":11.0}	true

query TTTT
SELECT subject, state, current, error FROM TESTS(orders.amount::min_max);
----
fin.orders.amount	green	true	NULL

query TTT
SELECT actor, body, current FROM GLOSSARY(orders.amount::min_max, all => true);
----
function	{"min":0.0,"max":11.0}	true

query TTT
SELECT value, test_state, state FROM GLOSSARY(orders.amount::min_max);
----
{"min":0.0,"max":11.0}	green	current

statement ok
DELETE FROM fin.orders WHERE id = 10;

# the detector sees the value's current; the result's current is every function annotation it read

query TTTT
SELECT subject, state, current, error FROM TESTS(orders.amount::min_max);
----
fin.orders.amount	red	false	NULL

query TTT
SELECT actor, body, current FROM GLOSSARY(orders.amount::min_max, all => true);
----
function	{"min":0.0,"max":11.0}	false

# served and marked: the annotation stays, stale beside it

query TTT
SELECT value, test_state, state FROM GLOSSARY(orders.amount::min_max);
----
{"min":0.0,"max":11.0}	red	stale

query TTTTT
SELECT min_max() FROM orders.amount;
----
min_max	fin.orders.amount	min_max	{"min":0.0,"max":10.0}	true

query TTT
SELECT value, test_state, state FROM GLOSSARY(orders.amount::min_max);
----
{"min":0.0,"max":10.0}	green	current

# a gloss's own staleness is the subject's shape (SPEC §5.2), a annotation's is its reads: a load ages the annotation only

statement ok
DECLARE TEST note_test ON note BY (AGENT, HUMAN);

query TTT
SELECT aspect, actor, current FROM GLOSSARY(orders.amount, all => true) ORDER BY aspect, actor;
----
answer	function	true
min_max	function	true
note	agent	true
notes	function	false
profile	function	false
tables	function	false

statement ok
INSERT INTO fin.orders VALUES (11, 1.0);

query TTT
SELECT aspect, actor, current FROM GLOSSARY(orders.amount, all => true) WHERE aspect IN ('min_max', 'note') ORDER BY aspect;
----
min_max	function	false
note	agent	true

# --- a table named like its dataset: a two-part subject is the table's column when the column exists, the dataset's table otherwise; a resolved subject resolves to itself

statement ok
CREATE TABLE fin.fin AS SELECT 1 AS id, 2.5 AS amount;

query TTTTT
SELECT min_max() FROM fin.amount;
----
min_max	fin.fin.amount	min_max	{"min":2.5,"max":3.5}	true

query TTTTT
SELECT min_max() FROM fin.fin.amount;
----
min_max	fin.fin.amount	min_max	{"min":2.5,"max":3.5}	false

query T
SELECT DISTINCT subject FROM GLOSSARY(fin.id);
----
fin.fin.id

query T
SELECT count(*) > 0 FROM GLOSSARY(fin.orders) WHERE subject LIKE 'fin.orders.%';
----
true

# --- * is the dataset's every table: a new view moves no * row, a table's load does

statement ok
DECLARE ASPECT cell_count WITH $${"type": "integer"}$$ AS MEASUREMENT ON DATASET;

statement ok
DECLARE FUNCTION cell_count FOR fin AS $$ SELECT count(*) AS n FROM dataset_cells('fin') $$ RETURNS cell_count;

statement ok
SELECT cell_count() FROM fin;

query IT
SELECT count(*), bool_and(EXISTS (SELECT 1 FROM inputs i WHERE i.begin_snapshot = m.begin_snapshot AND i.input = 'fin.*')) FROM measurements m WHERE function = 'cell_count';
----
1	true

statement ok
CREATE VIEW fin.order_view AS SELECT * FROM fin.orders;

statement ok
SELECT cell_count() FROM fin;

query I
SELECT count(*) FROM measurements WHERE function = 'cell_count';
----
1

statement ok
INSERT INTO fin.other VALUES (4);

statement ok
SELECT cell_count() FROM fin;

query I
SELECT count(*) FROM measurements_history WHERE function = 'cell_count';
----
2

# --- which result is out of date, and which input moved: a join of the inputs with the parts now

statement ok
INSERT INTO fin.orders VALUES (11, 11.0);

query TII
SELECT i.input, count(*) > 0, bool_and(p.version::BIGINT > i.version::BIGINT)
FROM measurements m JOIN inputs i USING (begin_snapshot) LEFT JOIN glossql_parts() p ON p.name = i.input
WHERE p.version IS DISTINCT FROM i.version AND m.subject = 'fin.orders.amount' AND i.input = 'fin.orders'
GROUP BY i.input;
----
fin.orders	true	true

# --- a read of the glossary names the property it read: an annotation on another property leaves the result current, one on its own outdates it

statement ok
DECLARE ASPECT note_count WITH $${"type": "integer"}$$ AS MEASUREMENT ON COLUMN;

statement ok
DECLARE FUNCTION note_count FOR fin AS $$ SELECT count(*) AS n FROM glossql_glossary('fin', 'note', true) WHERE subject = $subject $$ RETURNS note_count;

query TTTTT
SELECT note_count() FROM orders.amount;
----
note_count	fin.orders.amount	note_count	1	true

statement ok
DECLARE ASPECT remark WITH $${"type": "object"}$$ AS FACT ON COLUMN;

statement ok
GLOSS remark ON orders.amount AS $${"text": "another property"}$$;

query TTTTT
SELECT note_count() FROM orders.amount;
----
note_count	fin.orders.amount	note_count	1	false

statement ok
GLOSS note ON orders.id AS $${"text": "the same property"}$$;

query TTTTT
SELECT note_count() FROM orders.amount;
----
note_count	fin.orders.amount	note_count	1	true

# a declaration and a load in another dataset leave a reader of the glossary current

statement ok
DECLARE DATASET other SET (purpose: 'elsewhere');

statement ok
CREATE TABLE other.t AS SELECT 1 AS a, 2 AS b;

statement ok
DECLARE FUNCTION elsewhere FOR other AS $$ SELECT 1 AS n $$ RETURNS answer;

statement ok
USE other;

statement ok
DECLARE RELATIONSHIP t.a -> t.b;

statement ok
USE fin;

query TTTTT
SELECT note_count() FROM orders.amount;
----
note_count	fin.orders.amount	note_count	1	false

# --- a result that read a result: top reads min_max's value, top_twice reads top's. Each is current while nothing moved

statement ok
DECLARE ASPECT top WITH $${"type": "number"}$$ AS MEASUREMENT ON COLUMN;

statement ok
DECLARE FUNCTION top FOR fin AS $$ SELECT max((body->>'max')::DOUBLE) AS top FROM glossql_glossary('fin', 'min_max', true) WHERE subject = $subject $$ RETURNS top;

statement ok
DECLARE ASPECT top_twice WITH $${"type": "number"}$$ AS MEASUREMENT ON COLUMN;

statement ok
DECLARE FUNCTION top_twice FOR fin AS $$ SELECT max(body::DOUBLE) * 2 AS v FROM glossql_glossary('fin', 'top', true) WHERE subject = $subject $$ RETURNS top_twice;

query TTTTT
SELECT min_max(), top(), top_twice() FROM orders.amount;
----
min_max	fin.orders.amount	min_max	{"min":0.0,"max":12.0}	true
top	fin.orders.amount	top	12.0	true
top_twice	fin.orders.amount	top_twice	24.0	true

query TTTTT
SELECT min_max(), top(), top_twice() FROM orders.amount;
----
min_max	fin.orders.amount	min_max	{"min":0.0,"max":12.0}	false
top	fin.orders.amount	top	12.0	false
top_twice	fin.orders.amount	top_twice	24.0	false

# min_max's input moves: it is out of date, and so is every result that read it, directly or through another

statement ok
INSERT INTO fin.orders VALUES (12, 12.0);

query TT
SELECT aspect, current FROM GLOSSARY(orders.amount, all => true) WHERE aspect IN ('min_max', 'top', 'top_twice') ORDER BY aspect;
----
min_max	false
top	false
top_twice	false

# min_max computed again: top and top_twice stay out of date until they are computed again

query TTTTT
SELECT min_max() FROM orders.amount;
----
min_max	fin.orders.amount	min_max	{"min":0.0,"max":13.0}	true

query TT
SELECT aspect, current FROM GLOSSARY(orders.amount, all => true) WHERE aspect IN ('min_max', 'top', 'top_twice') ORDER BY aspect;
----
min_max	true
top	false
top_twice	false

query TTTTT
SELECT top(), top_twice() FROM orders.amount;
----
top	fin.orders.amount	top	13.0	true
top_twice	fin.orders.amount	top_twice	26.0	true

query TT
SELECT aspect, current FROM GLOSSARY(orders.amount, all => true) WHERE aspect IN ('min_max', 'top', 'top_twice') ORDER BY aspect;
----
min_max	true
top	true
top_twice	true

# a result computed while the result it read was out of date is out of date

statement ok
INSERT INTO fin.orders VALUES (13, 1.0);

query TTTTT
SELECT top() FROM orders.amount;
----
top	fin.orders.amount	top	13.0	true

query TT
SELECT aspect, current FROM GLOSSARY(orders.amount, all => true) WHERE aspect IN ('min_max', 'top') ORDER BY aspect;
----
min_max	false
top	false

# --- a function that reads its own property: what it stored is no input of its own, on any subject

statement ok
DECLARE ASPECT seen WITH $${"type": "integer"}$$ AS MEASUREMENT ON COLUMN;

statement ok
DECLARE FUNCTION seen FOR fin AS $$ SELECT count(*) AS n FROM glossql_glossary('fin', 'seen', true) $$ RETURNS seen;

statement ok
SELECT seen() FROM orders.amount;

statement ok
SELECT seen() FROM orders.id;

query TT
SELECT subject, current FROM GLOSSARY(fin, all => true) WHERE aspect = 'seen' ORDER BY subject;
----
fin.orders.amount	true
fin.orders.id	true

# two functions that read every property: each reads the other's results, and neither outdates the other

statement ok
DECLARE ASPECT values_a WITH $${"type": "integer"}$$ AS MEASUREMENT ON TABLE;

statement ok
DECLARE FUNCTION values_a FOR fin AS $$ SELECT count(*) AS n FROM glossql_glossary('fin', NULL, true) $$ RETURNS values_a;

statement ok
DECLARE ASPECT values_b WITH $${"type": "integer"}$$ AS MEASUREMENT ON TABLE;

statement ok
DECLARE FUNCTION values_b FOR fin AS $$ SELECT count(*) AS n FROM glossql_glossary('fin', NULL, true) $$ RETURNS values_b;

statement ok
SELECT values_a(), values_b() FROM orders;

statement ok
SET VARIABLE others = (SELECT version FROM glossql_parts() WHERE name = 'main.measurements/~values_a');

statement ok
SELECT values_b() FROM fin.other;

query T
SELECT version = getvariable('others') FROM glossql_parts() WHERE name = 'main.measurements/~values_a';
----
true
