# name: test/sql/glossql_lineage_kept.test
# description: a view's lineage is planned once per state of the catalog and served to every connection; a view redefined, a table's column added or a view dropped on either connection serves the new lineage on both
# group: [sql]

require glossql

require json

require parquet

require ducklake

statement ok
ATTACH 'ducklake::memory:' AS ws (DATA_PATH '{TEST_DIR}/glossql_lineage_kept_lake/');

statement ok
USE ws;

statement ok
PRAGMA glossql;

statement ok
DECLARE DATASET fin SET (purpose: 'the kept lineage');

statement ok
USE fin;

statement ok
CREATE TABLE fin.orders AS SELECT i AS id, i * 1.5 AS amount FROM range(4) t(i);

statement ok
CREATE VIEW fin.spend AS SELECT sum(amount) AS total FROM fin.orders;

statement ok
CREATE VIEW fin.everything AS SELECT * FROM fin.orders;

query TTT
SELECT view, "column", derivation FROM glossql_views_lineage('fin') ORDER BY ALL;
----
everything	amount	fin.orders.amount:DECIMAL(21,1)
everything	id	fin.orders.id:BIGINT
spend	total	sum(fin.orders.amount:DECIMAL(21,1))

query TTT
SELECT view, table_name, columns FROM glossql_views_scans('fin') ORDER BY ALL;
----
everything	fin.orders	[amount, id]
spend	fin.orders	[amount]

# a second read serves the same rows, on this connection and on another
query TTT
SELECT view, "column", derivation FROM glossql_views_lineage('fin') ORDER BY ALL;
----
everything	amount	fin.orders.amount:DECIMAL(21,1)
everything	id	fin.orders.id:BIGINT
spend	total	sum(fin.orders.amount:DECIMAL(21,1))

statement ok con1
USE ws.fin;

query TTT con1
SELECT view, table_name, columns FROM glossql_views_scans('fin') ORDER BY ALL;
----
everything	fin.orders	[amount, id]
spend	fin.orders	[amount]

# a view redefined on this connection: both connections read its new lineage
statement ok
CREATE OR REPLACE VIEW fin.spend AS SELECT max(id) AS total FROM fin.orders;

query TTT
SELECT view, "column", derivation FROM glossql_views_lineage('fin') WHERE view = 'spend';
----
spend	total	max(fin.orders.id:BIGINT)

query TTT con1
SELECT view, table_name, columns FROM glossql_views_scans('fin') WHERE view = 'spend';
----
spend	fin.orders	[id]

# a column added to a table on the other connection: the view that reads every column reads it on both
statement ok con1
ALTER TABLE fin.orders ADD COLUMN region VARCHAR;

query TTT con1
SELECT view, table_name, columns FROM glossql_views_scans('fin') WHERE view = 'everything';
----
everything	fin.orders	[amount, id, region]

query TTT
SELECT view, "column", derivation FROM glossql_views_lineage('fin') WHERE view = 'everything' ORDER BY ALL;
----
everything	amount	fin.orders.amount:DECIMAL(21,1)
everything	id	fin.orders.id:BIGINT
everything	region	fin.orders.region:VARCHAR

# a view redefined on the other connection, with a join: the joins read the new definition on both
statement ok
CREATE TABLE fin.regions AS SELECT 'north' AS region, 'n' AS code;

statement ok con1
CREATE OR REPLACE VIEW fin.spend AS SELECT r.code, sum(o.amount) AS total FROM fin.orders o JOIN fin.regions r ON o.region = r.region GROUP BY r.code;

query TT
SELECT left_column, right_column FROM glossql_views_joins('fin') WHERE view = 'spend';
----
fin.orders.region	fin.regions.region

query TT con1
SELECT left_column, right_column FROM glossql_views_joins('fin') WHERE view = 'spend';
----
fin.orders.region	fin.regions.region

# a view dropped on one connection is gone from the other's lineage
statement ok con1
DROP VIEW fin.everything;

query T
SELECT DISTINCT view FROM glossql_views_lineage('fin') ORDER BY ALL;
----
spend

# a write to the store keeps the lineage: the rows stay what the views define
statement ok
DECLARE ASPECT meaning WITH $${"type": "object"}$$ AS FACT ON COLUMN;

statement ok
GLOSS meaning ON orders.amount AS $${"value": "the order's amount"}$$;

query TTT
SELECT view, "column", derivation FROM glossql_views_lineage('fin') ORDER BY ALL;
----
spend	code	fin.regions.code:VARCHAR
spend	total	sum(fin.orders.amount:DECIMAL(21,1))
