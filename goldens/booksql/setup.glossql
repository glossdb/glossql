-- booksql: the composite endpoints corpus fixture 14 transcribed
-- (2026-08-05) — every surviving edge is composite on the business id,
-- which is why the tuple became the key. Table and column names are the
-- export's own: the master spells it `business Id`, every dimension
-- spells it `Business Id`, and four columns have no name at all.
USE books;

DECLARE RELATIONSHIP Master_txn_table.("business Id", "payment method")
  -> payment_method.("Business Id", "Payment method");
DECLARE RELATIONSHIP Master_txn_table.("business Id", "Account")
  -> chart_of_account_OB.("Business Id", "Account name");
DECLARE RELATIONSHIP Master_txn_table.("business Id", "Product_Service")
  -> product_service_table.("Business Id", "Product_Service");
DECLARE RELATIONSHIP Master_txn_table.("business Id", "Customer name")
  -> customer_table.("Business Id", "Customer name");
DECLARE RELATIONSHIP Master_txn_table.("business Id", "Vendor name")
  -> vendor_table.("Business Id", "Vendor name");
