-- fin: the FK truth the finance generator ground-truths, transcribed
-- from the workspace's sqlite `relationships` table on 2026-08-17, when
-- the relation crossed to the lake. The workspace is a fixture with real
-- glosses, so it was re-declared rather than re-landed — declaring an
-- edge is what a user does, and there is no migration machinery
-- (schema is CREATE-only; a shim would need a ruling).
USE fin;

DECLARE RELATIONSHIP account_balances.account_id -> chart_of_accounts.account_id;
DECLARE RELATIONSHIP ap_invoices.entry_id -> journal_entries.entry_id;
DECLARE RELATIONSHIP ap_payments.ap_invoice_id -> ap_invoices.ap_invoice_id;
DECLARE RELATIONSHIP ar_invoices.customer_id -> customers.customer_id;
DECLARE RELATIONSHIP ar_invoices.order_id -> sales_orders.order_id;
DECLARE RELATIONSHIP chart_of_accounts.parent_id -> chart_of_accounts.account_id;
DECLARE RELATIONSHIP inventory_positions.product_id -> products.product_id;
DECLARE RELATIONSHIP journal_lines.account_id -> chart_of_accounts.account_id;
DECLARE RELATIONSHIP journal_lines.entry_id -> journal_entries.entry_id;
DECLARE RELATIONSHIP receipts.ar_invoice_id -> ar_invoices.ar_invoice_id;
DECLARE RELATIONSHIP receipts.customer_id -> customers.customer_id;
DECLARE RELATIONSHIP sales_order_lines.order_id -> sales_orders.order_id;
DECLARE RELATIONSHIP sales_order_lines.product_id -> products.product_id;
DECLARE RELATIONSHIP sales_orders.customer_id -> customers.customer_id;

-- The workspace-authored vocabulary: everything the fixture declared
-- beyond the shipped bootstrap, transcribed from its sqlite store on
-- 2026-08-17 when the declaration relations crossed to the lake.
-- Declaring is idempotent, so this runs on every capture.
DECLARE ASPECT accounts_payable WITH $${"title": "Accounts payable", "x-kind": "metric"}$$ AS QUERY ON DATASET;
DECLARE ASPECT accounts_receivable WITH $${"title": "Accounts receivable", "x-kind": "metric"}$$ AS QUERY ON DATASET;
DECLARE ASPECT ap_ties_to_ledger WITH $${"type": "object", "required": ["outcome"], "properties": {"outcome": {"type": "string"}, "tolerance": {"type": "number"}, "breach_rate": {"type": "number"}}}$$ AS FACT ON DATASET;
DECLARE ASPECT ar_ties_to_ledger WITH $${"type": "object", "required": ["outcome"], "properties": {"outcome": {"type": "string"}, "tolerance": {"type": "number"}, "breach_rate": {"type": "number"}}}$$ AS FACT ON DATASET;
DECLARE ASPECT ccc WITH $${"title": "Cash conversion cycle", "x-kind": "metric"}$$ AS QUERY ON DATASET;
DECLARE ASPECT cogs WITH $${"title": "Cost of goods sold", "x-kind": "metric"}$$ AS QUERY ON DATASET;
DECLARE ASPECT dio WITH $${"title": "DIO", "x-kind": "metric"}$$ AS QUERY ON DATASET;
DECLARE ASPECT dpo WITH $${"title": "DPO", "x-kind": "metric"}$$ AS QUERY ON DATASET;
DECLARE ASPECT dso WITH $${"title": "DSO", "x-kind": "metric"}$$ AS QUERY ON DATASET;
DECLARE ASPECT gross_margin WITH $${"title": "Gross margin", "x-kind": "metric"}$$ AS QUERY ON DATASET;
DECLARE ASPECT gross_profit WITH $${"title": "Gross profit", "x-kind": "metric"}$$ AS QUERY ON DATASET;
DECLARE ASPECT inventory_value WITH $${"title": "Inventory", "x-kind": "metric"}$$ AS QUERY ON DATASET;
DECLARE ASPECT journal_balanced WITH $${"type": "object", "required": ["outcome"], "properties": {"outcome": {"type": "string"}, "tolerance": {"type": "number"}, "breach_rate": {"type": "number"}}}$$ AS FACT ON DATASET;
DECLARE ASPECT price_rise WITH $${
  "title": "List prices +10% from October 2025",
  "description": "What the last quarter would have looked like at higher prices, with no demand response modelled.",
  "x-kind": "scenario",
  "type": "object", "required": ["overrides"],
  "properties": {"overrides": {"type": "array", "items": {
    "type": "object", "required": ["column", "factor", "from", "basis"],
    "properties": {"column": {"type": "string"}, "factor": {"type": "number"},
                   "from": {"type": "string"}, "basis": {"type": "string"}}}}}
}$$ AS FACT ON DATASET;
DECLARE ASPECT revenue WITH $${"title": "Revenue", "x-kind": "metric"}$$ AS QUERY ON DATASET;
DECLARE FUNCTION ap_ties_check FOR fin AS $$
  let m = db.query(`WITH oi AS (SELECT date AS d, sum(value) AS ap FROM read.accounts_payable() GROUP BY 1),
                         gl AS (SELECT period_start AS d, -sum(ending_balance) AS gl FROM account_balances
                                WHERE account_id IN ('2110','2120') GROUP BY 1)
                    SELECT count(*) AS n, count(*) FILTER (WHERE abs(oi.ap - gl.gl) > 0.01) AS bad
                    FROM oi JOIN gl ON gl.d = oi.d`);
  let n = m.cell("n").parse_float();
  #{
    "outcome": "measured: the payables grounding against the ledger balance, per month",
    "breach_rate": if n > 0.0 { m.cell("bad").parse_float() / n } else { 1.0 }
  }
$$ RETURNS ap_ties_to_ledger;
DECLARE FUNCTION ar_ties_check FOR fin AS $$
  let m = db.query(`WITH oi AS (SELECT date AS d, sum(value) AS ar FROM read.accounts_receivable() GROUP BY 1),
                         gl AS (SELECT period_start AS d, sum(ending_balance) AS gl FROM account_balances
                                WHERE account_id IN ('1210','1220') GROUP BY 1)
                    SELECT count(*) AS n, count(*) FILTER (WHERE abs(oi.ar - gl.gl) > 0.01) AS bad
                    FROM oi JOIN gl ON gl.d = oi.d`);
  let n = m.cell("n").parse_float();
  #{
    "outcome": "measured: the receivables grounding against the ledger balance, per month",
    "breach_rate": if n > 0.0 { m.cell("bad").parse_float() / n } else { 1.0 }
  }
$$ RETURNS ar_ties_to_ledger;
DECLARE FUNCTION journal_balanced_check FOR fin AS $$
  let m = db.query(`SELECT count(*) AS n, count(*) FILTER (WHERE abs(d - c) > 0.005) AS bad
                    FROM (SELECT entry_id, sum(debit) AS d, sum(credit) AS c
                          FROM journal_lines GROUP BY entry_id)`);
  let n = m.cell("n").parse_float();
  #{
    "outcome": "measured: per-entry debits against credits, tolerance 0.005 for float noise",
    "breach_rate": if n > 0.0 { m.cell("bad").parse_float() / n } else { 0.0 }
  }
$$ RETURNS journal_balanced;
DECLARE WITNESS ap_ties_w ON ap_ties_to_ledger BY (AGENT, HUMAN) DETECTOR rate_tolerance THRESHOLD 0;
DECLARE WITNESS ar_ties_w ON ar_ties_to_ledger BY (AGENT, HUMAN) DETECTOR rate_tolerance THRESHOLD 0;
DECLARE WITNESS journal_balanced_w ON journal_balanced BY (AGENT, HUMAN) DETECTOR rate_tolerance THRESHOLD 0;
