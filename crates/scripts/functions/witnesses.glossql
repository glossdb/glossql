-- The shipped witness plane, declared last at boot: a witness names
-- an aspect and a detector that must already stand, so this file runs
-- after the KPI kit (the vocabulary) and the measurement library (the
-- detectors) and binds the two. Who may speak, and which claims the
-- door owes a question for while they stand unwritten. slot_entropy
-- adjudicates the low-entropy enums; bands adjudicate through
-- band_breach.

DECLARE WITNESS meaning_w ON meaning BY (AGENT, HUMAN);
DECLARE WITNESS entity_w ON entity BY (AGENT, HUMAN);
DECLARE WITNESS role_w ON role BY (AGENT, HUMAN)
  DETECTOR slot_entropy THRESHOLD 0.7;
DECLARE WITNESS behavior_w ON behavior BY (AGENT, HUMAN)
  DETECTOR slot_entropy THRESHOLD 0.7;
DECLARE WITNESS unit_w ON unit BY (AGENT, HUMAN)
  DETECTOR slot_entropy THRESHOLD 0.7;
DECLARE WITNESS dimension_w ON dimension BY (AGENT, HUMAN);
DECLARE WITNESS bands_w ON metric_bands DETECTOR band_breach THRESHOLD 0.98;
