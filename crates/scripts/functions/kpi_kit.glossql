-- The KPI kit: the semantic vocabulary a workspace starts with,
-- declared at boot beside the measurement library. The line it draws:
-- this file ships the questions — what a column means, how a number
-- behaves, its unit, which axes slice, what a table is, where
-- definitions and formulas live, how a recipe correction travels.
-- The answers — the company's own metrics, validations, scenarios —
-- stay authored in the flows. Adapting glossdb for a customer starts
-- here: the kit is statements, so a fork is an edit.
--
-- Names machinery reads, recorded here because this is the one file
-- that ships them: `recipe_change` (the agent brief counts pending
-- approvals by that aspect name), `x-kind` / `title` in QUERY-aspect
-- blobs and `unit` / `meaning` in a `definitions` entry (the docket's
-- metric faces and `metric_surfaces`), and `none` as the
-- judged negative in enum aspects ("examined, does not apply" — a
-- different fact from an unassessed row, and the one that lets the
-- backlog read walk to zero).

-- Column vocabulary. role classes every column; behavior and unit are
-- the witnessed enum/valued claims on measures. Unwritten, each one
-- is the AGENT's measurement backlog (behavior_evidence settles
-- behavior; profiles and currency columns settle unit) — never a
-- human question. The door's round asks judgment
-- only. Relevance is conditional: WHEN
-- narrows what a column owes to what its role makes meaningful — a
-- role-less column owes only role, and the backlog counts what is
-- real instead of columns × vocabulary.

DECLARE ASPECT meaning WITH $${
  "type": "object", "required": ["value"],
  "properties": {"value": {"type": "string"}, "term": {"type": "string"}}
}$$ AS FACT ON TABLE, COLUMN, RELATIONSHIP;

DECLARE ASPECT role WITH $${
  "type": "object", "required": ["value"],
  "properties": {"value": {"enum": ["key", "measure", "dimension",
                                    "timestamp", "attribute"]}}
}$$ AS FACT ON COLUMN;

DECLARE ASPECT behavior WITH $${
  "type": "object", "required": ["value"],
  "properties": {"value": {"enum": ["stock", "flow", "none"]},
                 "grounds": {"type": "string"}}
}$$ AS FACT ON COLUMN WHEN role = 'measure';

DECLARE ASPECT unit WITH $${
  "type": "object", "required": ["value"],
  "properties": {"value": {"type": "string"},
                 "source_column": {"type": "string"}}
}$$ AS FACT ON COLUMN WHEN role = 'measure';

DECLARE ASPECT dimension WITH $${
  "type": "object", "required": ["value"],
  "properties": {
    "value": {"type": "string", "enum": ["primary", "supporting", "none"]},
    "grounds": {"type": "string"}
  }
}$$ AS FACT ON COLUMN WHEN role = 'dimension';

-- Table identity — the entity verdict every aggregate stands on.

DECLARE ASPECT entity WITH $${
  "type": "object", "required": ["value"],
  "properties": {"value": {"type": "string"},
                 "role": {"enum": ["fact", "dimension"]},
                 "grain": {"type": "array", "items": {"type": "string"}},
                 "time_axis": {"type": "string"},
                 "identity_columns": {"type": "array", "items": {"type": "string"}}}
}$$ AS FACT ON TABLE;

-- Source conventions — fiscal calendar, sign conventions, what an
-- export's nulls mean; read and superseded workspace-wide.

DECLARE ASPECT conventions WITH $${"type": "object"}$$ AS FACT ON SOURCE;

-- Dataset registries, both keyed by the concept's own name.
--
-- `formulas` holds a derived metric's definition (fixture 16 §4):
-- a window-generic expression over sibling concepts, the
-- window `w` its one free variable — `revenue[w] - expenses[w]`,
-- `accounts_receivable[end of w] / revenue[w] * days[w]`. It covers
-- every window because it names none, and it is what a drill
-- re-scopes from: a ratio is never regrouped from its output rows.
-- KNOWN GAP: nothing checks that the operands
-- name declared concepts, so a typo is silent.
--
-- `definitions` holds the handbook content: the
-- aspect blob of a metric stays thin — the `title` display label and
-- the `x-kind` tooling flag — because declarations have no
-- supersession, and everything the company might revise (meaning,
-- unit, owner, source) lives here, where a correction supersedes with
-- actor and timestamp. The ruling was forced by a stale `x-unit`: a
-- field lives in exactly one place, never both.

DECLARE ASPECT formulas WITH $${
  "type": "object", "properties": {"formulas": {"type": "object"}}
}$$ AS FACT ON DATASET;

DECLARE ASPECT definitions WITH $${
  "type": "object", "properties": {"definitions": {"type": "object"}}
}$$ AS FACT ON DATASET;

-- The recipe-correction channel: the human gloss is the approval, the
-- re-declare is the agent's next act, and the brief counts approvals
-- still waiting on an import of the named table.

DECLARE ASPECT recipe_change WITH $${
  "type": "object", "required": ["table", "sql", "reason"],
  "properties": {"table": {"type": "string"}, "sql": {"type": "string"},
                 "reason": {"type": "string"}}
}$$ AS FACT ON TABLE;

-- The ruling channel: the question round lands each
-- human judgment here — the claim it rules, confirmed or corrected —
-- and the ruled aspect's slots stay agent-authored. The agent owes
-- the fold-in (re-record the grounding citing the ruling); the brief
-- counts the debt until the agent's current body carries the ruled
-- claim at full confidence. Witness-free on purpose: actor kind
-- stamps the writer, and a witness would put an unassessed `ruling`
-- row on every subject.
--
-- The claim is named by `key` — the slug the agent declared on the
-- assumption it disclosed. The key is the ONLY thing joined on:
-- closure, the fold-in debt, and the contradiction check all match
-- (aspect, key). `assumption` rides along as the prose the human
-- actually read, a snapshot for the record — never a match column
-- (string equality on non-keys is forbidden).

DECLARE ASPECT ruling WITH $${
  "type": "object", "required": ["rulings"],
  "properties": {"rulings": {"type": "array", "items": {
    "type": "object", "required": ["aspect", "key", "stance"],
    "properties": {"aspect": {"type": "string"},
                   "dimension": {"type": "string"},
                   "key": {"type": "string"},
                   "assumption": {"type": "string"},
                   "stance": {"enum": ["confirmed", "corrected", "unclear"]},
                   "note": {"type": "string"}}}}}
}$$ AS FACT;

-- Apps as glosses. An app was a directory read from
-- disk, which is why an agent connected over MCP could not author one:
-- it has statements, not a filesystem. Each part is its own gloss —
-- the aspect says what kind of file it is, the subject says where it
-- goes (`app_frame` ON `docket.open` is `frames/open.sql`). One gloss
-- per part, so an author edits one frame without rewriting the app,
-- and supersession versions each part on its own.
--
-- Grainless and witness-free on purpose: an app part is not a claim
-- about the data, so it owes no verdict and belongs on no backlog.

DECLARE ASPECT app WITH $${
  "type": "object", "required": ["title"],
  "properties": {"title": {"type": "string"}, "dataset": {"type": "string"}}
}$$ AS FACT;

DECLARE ASPECT app_page WITH $${
  "type": "object", "required": ["html"],
  "properties": {"html": {"type": "string"}}
}$$ AS FACT;

DECLARE ASPECT app_frame WITH $${
  "type": "object", "required": ["sql"],
  "properties": {"sql": {"type": "string"}}
}$$ AS FACT;

DECLARE ASPECT app_spec WITH $${
  "type": "object", "required": ["spec"],
  "properties": {"spec": {"type": "string"}}
}$$ AS FACT;

-- Witnesses: who may speak, and which claims the door owes a question
-- for while they stand unwritten. slot_entropy adjudicates the
-- low-entropy enums; bands adjudicate through band_breach.

DECLARE WITNESS meaning_w ON meaning BY (AGENT, HUMAN);
DECLARE WITNESS entity_w ON entity BY (AGENT, HUMAN);
DECLARE WITNESS role_w ON role BY (AGENT, HUMAN)
  DETECTOR slot_entropy THRESHOLD 0.7;
DECLARE WITNESS behavior_w ON behavior BY (AGENT, HUMAN)
  DETECTOR slot_entropy THRESHOLD 0.7;
DECLARE WITNESS unit_w ON unit BY (AGENT, HUMAN)
  DETECTOR slot_entropy THRESHOLD 0.7;
DECLARE WITNESS dimension_w ON dimension BY (AGENT, HUMAN);
DECLARE WITNESS bands_w ON metric_bands DETECTOR band_breach THRESHOLD 0.98;
