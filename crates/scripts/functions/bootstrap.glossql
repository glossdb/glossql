-- The shipped system: the global measurement library, declared into a
-- fresh workspace by serverd at boot (the reference scripts land beside
-- it under functions/). The semantic vocabulary — aspects, witnesses —
-- ships too, as the KPI kit (kpi_kit.glossql), run right after this
-- file; what stays the agent's work is the company's own vocabulary:
-- metrics, validations, scenarios.

DECLARE ASPECT column_profile WITH $${
  "type": "object",
  "required": ["total", "null_ratio", "distinct"],
  "properties": {
    "total": {"type": "integer"}, "null_ratio": {"type": "number"},
    "distinct": {"type": "integer"}, "cardinality_ratio": {"type": "number"},
    "min": {}, "max": {}, "top_values": {"type": "array"},
    "lengths": {"type": "object"},
    "numeric": {
      "type": "object",
      "required": ["mean", "mad", "percentiles"],
      "properties": {"mean": {}, "stddev": {}, "mad": {},
                     "percentiles": {"type": "object"}}
    }
  }
}$$ AS MEASUREMENT ON COLUMN;

DECLARE ASPECT outlier_profile WITH $${
  "type": "object", "required": ["applicable"],
  "properties": {"applicable": {"type": "boolean"},
                 "iqr": {"type": "object"}, "zscore": {"type": "object"}}
}$$ AS MEASUREMENT ON COLUMN;

DECLARE ASPECT relationship_candidates WITH $${
  "type": "object",
  "properties": {"candidates": {"type": "array",
    "items": {"type": "object",
      "properties": {"from": {"type": "string"}, "to": {"type": "string"},
                     "cardinality": {"type": "string"},
                     "overlap": {"type": "number"}}}}}
}$$ AS MEASUREMENT ON DATASET;

DECLARE ASPECT temporal_profile WITH $${
  "type": "object", "required": ["applicable"],
  "properties": {"applicable": {"type": "boolean"},
                 "granularity": {"type": "string"},
                 "confidence": {"type": "number"},
                 "completeness": {"type": "object"}, "gaps": {"type": "object"}}
}$$ AS MEASUREMENT ON COLUMN;

DECLARE ASPECT behavior_evidence WITH $${
  "type": "object", "required": ["applicable"],
  "properties": {
    "applicable": {"type": "boolean"},
    "anchors": {"type": "array", "items": {"type": "object",
      "properties": {
        "event": {"type": "string"}, "align": {"type": "string"},
        "verdict": {"type": "string", "enum": ["flow", "stock", "abstain"]},
        "convention": {"type": "string"}, "support": {"type": "number"}}}},
    "summary": {"type": "object", "properties": {
      "verdict": {"type": "string", "enum": ["flow", "stock", "abstain"]},
      "support": {"type": "number"}, "voted": {"type": "integer"},
      "convention": {"type": "string"}, "align": {"type": "string"},
      "anchors": {"type": "integer"}, "decided": {"type": "integer"},
      "reason": {"type": "string"}}}
  }
}$$ AS MEASUREMENT ON COLUMN;

DECLARE ASPECT dimension_relevance WITH $${
  "type": "object", "required": ["applicable"],
  "properties": {
    "applicable": {"type": "boolean"},
    "relevance": {"type": "number"}, "coverage": {"type": "number"},
    "evenness": {"type": "number"}, "groups": {"type": "integer"},
    "truncated": {"type": "boolean"}
  }
}$$ AS MEASUREMENT ON COLUMN;

DECLARE ASPECT hierarchy_candidates WITH $${
  "type": "object", "required": ["applicable"],
  "properties": {
    "applicable": {"type": "boolean"},
    "rows": {"type": "integer"},
    "candidates": {"type": "array", "items": {"type": "object",
      "properties": {
        "from": {"type": "string"}, "to": {"type": "string"},
        "g3": {"type": "number"}, "lambda": {"type": "number"},
        "kind": {"type": "string", "enum": ["edge", "alias"]}}}}
  }
}$$ AS MEASUREMENT ON TABLE;

DECLARE ASPECT derivation_candidates WITH $${
  "type": "object", "required": ["applicable"],
  "properties": {
    "applicable": {"type": "boolean"},
    "rows": {"type": "integer"},
    "truncated": {"type": "boolean"},
    "candidates": {"type": "array", "items": {"type": "object",
      "properties": {
        "target": {"type": "string"},
        "form": {"type": "string", "enum": ["product", "sum"]},
        "operands": {"type": "array", "items": {"type": "string"}},
        "support": {"type": "integer"}, "violations": {"type": "integer"},
        "match_rate": {"type": "number"}}}}
  }
}$$ AS MEASUREMENT ON TABLE;

DECLARE ASPECT relationship_coherence WITH $${
  "type": "object", "required": ["applicable"],
  "properties": {
    "applicable": {"type": "boolean"},
    "relationships": {"type": "array", "items": {"type": "object",
      "properties": {
        "relationship": {"type": "string"},
        "filled": {"type": "integer"}, "orphans": {"type": "integer"},
        "orphan_rate": {"type": "number"},
        "temporal": {"type": "array", "items": {"type": "object",
          "properties": {
            "child_column": {"type": "string"},
            "parent_column": {"type": "string"},
            "joined": {"type": "integer"}, "precedes": {"type": "integer"},
            "precedes_rate": {"type": "number"}}}}}}}
  }
}$$ AS MEASUREMENT ON DATASET;

DECLARE ASPECT grounding_collisions WITH $${
  "type": "object", "required": ["applicable"],
  "properties": {
    "applicable": {"type": "boolean"},
    "groundings": {"type": "integer"},
    "collisions": {"type": "array", "items": {"type": "object",
      "properties": {
        "sql": {"type": "string"},
        "aspects": {"type": "array", "items": {"type": "string"}},
        "subjects": {"type": "array", "items": {"type": "string"}}}}}
  }
}$$ AS MEASUREMENT ON DATASET;

DECLARE ASPECT metric_bands WITH $${
  "type": "object", "required": ["applicable"],
  "properties": {
    "applicable": {"type": "boolean"},
    "metrics": {"type": "array", "items": {"type": "object",
      "properties": {
        "metric": {"type": "string"}, "applicable": {"type": "boolean"},
        "reason": {"type": "string"},
        "grain": {"type": "string"}, "aggregation": {"type": "string"},
        "trained_on": {"type": "integer"},
        "points": {"type": "array", "items": {"type": "object",
          "properties": {
            "period": {"type": "string"}, "actual": {"type": "number"},
            "p05": {"type": "number"}, "p10": {"type": "number"},
            "p50": {"type": "number"}, "p90": {"type": "number"},
            "p95": {"type": "number"},
            "pit": {"type": "number"}}}}}}}
  }
}$$ AS MEASUREMENT ON DATASET;

DECLARE ASPECT metric_cube WITH $${
  "type": "object", "required": ["applicable"],
  "properties": {
    "applicable": {"type": "boolean"},
    "caps": {"type": "object"},
    "metrics": {"type": "array", "items": {"type": "object",
      "properties": {
        "metric": {"type": "string"}, "applicable": {"type": "boolean"},
        "reason": {"type": "string"}, "behavior": {"type": "string"},
        "dims": {"type": "array", "items": {"type": "string"}},
        "alternative": {"type": "string"},
        "alternative_error": {"type": "string"},
        "rows": {"type": "array", "items": {"type": "array"}}}}}
  }
}$$ AS MEASUREMENT ON DATASET;

DECLARE FUNCTION profile FOR GLOBAL AS $$profile.sql$$
  RETURNS column_profile;

DECLARE FUNCTION outliers FOR GLOBAL AS $$outliers.sql$$
  RETURNS outlier_profile;

DECLARE FUNCTION temporal FOR GLOBAL AS $$temporal.sql$$
  RETURNS temporal_profile;

DECLARE FUNCTION detect_relationships FOR GLOBAL AS $$relationships.sql$$
  RETURNS relationship_candidates;

DECLARE FUNCTION behavior_evidence FOR GLOBAL AS $$behavior_evidence.rhai$$
  RETURNS behavior_evidence;

DECLARE FUNCTION dimension_relevance FOR GLOBAL AS $$dimension_relevance.sql$$
  RETURNS dimension_relevance;

DECLARE FUNCTION detect_hierarchies FOR GLOBAL AS $$hierarchies.sql$$
  RETURNS hierarchy_candidates;

DECLARE FUNCTION detect_derivations FOR GLOBAL AS $$derivations.sql$$
  RETURNS derivation_candidates;

DECLARE FUNCTION relationship_coherence FOR GLOBAL AS $$coherence.rhai$$
  RETURNS relationship_coherence;

DECLARE FUNCTION detect_grounding_collisions FOR GLOBAL AS $$grounding_collisions.sql$$
  RETURNS grounding_collisions;

DECLARE FUNCTION slot_entropy FOR GLOBAL AS $$slot_entropy.rhai$$;

DECLARE FUNCTION metric_bands FOR GLOBAL AS $$metric_bands.rhai$$
  RETURNS metric_bands;

DECLARE FUNCTION metric_cube FOR GLOBAL AS $$metric_cube.rhai$$
  RETURNS metric_cube;

DECLARE FUNCTION band_breach FOR GLOBAL AS $$band_breach.rhai$$;

DECLARE FUNCTION rate_tolerance FOR GLOBAL AS $$rate_tolerance.rhai$$;
