{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {"name": "frame"},
  "height": 220,
  "layer": [
    {
      "mark": {"type": "area", "color": "#57b9cf", "opacity": 0.12},
      "encoding": {
        "x": {"field": "period", "type": "ordinal", "axis": {"title": null, "labelAngle": 0}},
        "y": {"field": "p05", "type": "quantitative", "axis": {"title": null}, "scale": {"zero": false}},
        "y2": {"field": "p95"}
      }
    },
    {
      "mark": {"type": "area", "color": "#57b9cf", "opacity": 0.2},
      "encoding": {
        "x": {"field": "period", "type": "ordinal"},
        "y": {"field": "p10", "type": "quantitative", "scale": {"zero": false}},
        "y2": {"field": "p90"}
      }
    },
    {
      "mark": {"type": "line", "color": "#8b95a2", "strokeDash": [4, 3], "strokeWidth": 1.2},
      "encoding": {
        "x": {"field": "period", "type": "ordinal"},
        "y": {"field": "p50", "type": "quantitative", "scale": {"zero": false}}
      }
    },
    {
      "mark": {"type": "line", "color": "#dde3ea", "strokeWidth": 1.6},
      "encoding": {
        "x": {"field": "period", "type": "ordinal"},
        "y": {"field": "actual", "type": "quantitative", "scale": {"zero": false}}
      }
    },
    {
      "mark": {"type": "point", "filled": true, "size": 55},
      "encoding": {
        "x": {"field": "period", "type": "ordinal"},
        "y": {"field": "actual", "type": "quantitative", "scale": {"zero": false}},
        "color": {
          "condition": {
            "test": "datum.pit > 0.9 || datum.pit < 0.1",
            "value": "#d97561"
          },
          "value": "#dde3ea"
        },
        "tooltip": [
          {"field": "period", "type": "ordinal"},
          {"field": "actual", "type": "quantitative", "format": ".4~s"},
          {"field": "p10", "type": "quantitative", "format": ".4~s"},
          {"field": "p90", "type": "quantitative", "format": ".4~s"},
          {"field": "pit", "type": "quantitative", "format": ".3f"}
        ]
      }
    }
  ]
}
