{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {"name": "frame"},
  "height": 220,
  "mark": {"type": "line", "strokeWidth": 1.6, "point": {"size": 20}},
  "encoding": {
    "x": {"field": "period", "type": "ordinal", "axis": {"title": null, "labelAngle": 0}},
    "y": {"field": "value", "type": "quantitative", "axis": {"title": null}, "scale": {"zero": false}},
    "color": {"field": "series", "type": "nominal", "legend": {"title": null, "orient": "top"}},
    "tooltip": [
      {"field": "period", "type": "ordinal"},
      {"field": "series", "type": "nominal"},
      {"field": "value", "type": "quantitative", "format": ".4~s"}
    ]
  }
}
