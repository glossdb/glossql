{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "data": {
    "name": "frame"
  },
  "height": 220,
  "encoding": {
    "x": {
      "field": "period",
      "type": "temporal",
      "axis": {
        "title": null,
        "labelAngle": 0
      }
    },
    "color": {
      "field": "series",
      "type": "nominal",
      "legend": {
        "title": null,
        "orient": "top"
      }
    }
  },
  "layer": [
    {
      "transform": [
        {
          "filter": "isValid(datum.low)"
        }
      ],
      "mark": {
        "type": "area",
        "opacity": 0.18
      },
      "encoding": {
        "y": {
          "field": "low",
          "type": "quantitative"
        },
        "y2": {
          "field": "high"
        },
        "tooltip": null
      }
    },
    {
      "mark": {
        "type": "line",
        "strokeWidth": 1.6,
        "point": {
          "size": 20
        }
      },
      "encoding": {
        "y": {
          "field": "value",
          "type": "quantitative",
          "axis": {
            "title": null
          },
          "scale": {
            "zero": false
          }
        },
        "strokeDash": {
          "field": "world",
          "type": "nominal",
          "legend": null
        },
        "tooltip": [
          {
            "field": "period",
            "type": "temporal"
          },
          {
            "field": "series",
            "type": "nominal"
          },
          {
            "field": "value",
            "type": "quantitative",
            "format": ".4~s"
          },
          {
            "field": "low",
            "type": "quantitative",
            "format": ".4~s",
            "title": "p10"
          },
          {
            "field": "high",
            "type": "quantitative",
            "format": ".4~s",
            "title": "p90"
          },
          {
            "field": "held",
            "type": "nominal",
            "title": "the 80% band"
          }
        ]
      }
    }
  ]
}
